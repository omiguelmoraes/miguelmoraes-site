---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import '../styles/sections.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'pt-BR';
  type?: 'website' | 'article';
}

const { title, description, image, lang, type } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} lang={lang} type={type}>
  <slot name="head" slot="head" />

  <div class="shell">
    <Sidebar />
    <main class="main">
      <slot />
      <Footer />
    </main>
  </div>
</BaseLayout>

<style>
  .shell {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--layout-padding-y) var(--layout-padding-x);
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    gap: var(--shell-gap);
    align-items: start;
  }

  .shell > :global(.sidebar) {
    position: sticky;
    top: var(--layout-padding-y);
  }

  .main {
    min-width: 0;
  }

  @media (max-width: 900px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 0 var(--layout-padding-x) var(--layout-padding-y);
    }

    /* Sangra até a borda da tela pro fundo cobrir o conteúdo que passa por baixo.
       Exclui o estado aberto: lá o Sidebar assume com position: fixed, e sem o
       :not as duas regras empatariam em especificidade */
    .shell > :global(.sidebar:not(.nav-open)) {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      margin: 0 calc(var(--layout-padding-x) * -1);
      padding: 16px var(--layout-padding-x);
    }

    /* O painel do menu é position: fixed, e no iOS o fixed não alcança as faixas
       sob as barras translúcidas do Safari — o conteúdo atrás vaza por ali.
       Escondendo o main, essas faixas mostram só o fundo do html, mesma cor do
       painel. visibility em vez de display pra não perder a posição do scroll */
    :global(body.nav-open) .main {
      visibility: hidden;
    }
  }
</style>
