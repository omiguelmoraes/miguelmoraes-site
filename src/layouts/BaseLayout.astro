---
import '../styles/global.css';
// No frontmatter viram <link> de verdade; dentro de <script> o Vite injeta em
// runtime e o ClientRouter descarta o estilo ao trocar o <head>
import '@phosphor-icons/web/regular';
import '@phosphor-icons/web/bold';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'pt-BR';
  type?: 'website' | 'article';
}

const {
  title = 'Miguel Moraes — Designer',
  description = 'Designer focused on visual design, UX/UI and front-end. Based in Brazil, open to remote projects.',
  image = '/og.png',
  lang = 'en',
  type = 'website',
} = Astro.props;

const ogLocale = lang === 'pt-BR' ? 'pt_BR' : 'en_US';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Miguel Moraes" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
    <slot name="head" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rethink+Sans:wght@400;500;600;700&family=Geist+Mono:wght@400&display=swap" rel="stylesheet" />
  <script defer src="https://umami-blond-ten.vercel.app/script.js" data-website-id="b1833d27-7a87-4710-83aa-b7b587f9d7b5"></script>
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>

