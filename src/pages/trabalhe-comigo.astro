---
// LP de tráfego pago. Sem navegação: a única saída é o formulário, que cai no
// WhatsApp igual ao fluxo da /mentoria. Usa BaseLayout direto (sem sidebar) e
// trava o tema em claro, porque a página é peça de anúncio e não segue o
// dark mode do sistema como o resto do site.
import BaseLayout from '../layouts/BaseLayout.astro';

const logos = [
  { src: '/logos/unimed.svg', nome: 'Unimed', h: 30 },
  { src: '/logos/sicoob.svg', nome: 'Sicoob', h: 24 },
  { src: '/logos/farroupilha.svg', nome: 'Colégio Farroupilha', h: 28 },
  { src: '/logos/yoursbank.svg', nome: 'Yours Bank', h: 24 },
  { src: '/logos/startup-academy.svg', nome: 'Startup Academy', h: 32 },
  { src: '/logos/msk.svg', nome: 'MSK Perfuradora', h: 22 },
  { src: '/logos/cjur.png', nome: 'Círculo Jurídico', h: 22 },
  { src: '/logos/bpop.png', nome: 'Biblioteca.pop', h: 20 },
  { src: '/logos/realpolitik.svg', nome: 'Real Politik', h: 18 },
  { src: '/work/logos/barca.png', nome: 'Barca', h: 44 },
  { src: '/logos/flouds.svg', nome: 'Flouds', h: 24 },
  { src: '/logos/rmaq.svg', nome: 'RMAQ Assessoria', h: 30 },
];

const projetos = [
  { img: '/projects/yoursbank/yoursbank-01.webp', nome: 'Yours Bank', logo: '/logos/yoursbank.svg' },
  { img: '/projects/flouds/flouds-01.webp', nome: 'Flouds', logo: '/logos/flouds.svg' },
  { img: '/projects/msk/msk-01.webp', nome: 'MSK Perfuradora', logo: '/logos/msk.svg' },
  { img: '/projects/rmaq/rmaq-cover.webp', nome: 'RMAQ Assessoria', logo: '/logos/rmaq.svg' },
  { img: '/projects/sant/sant-01.webp', nome: 'Sant Saúde', logo: null },
];
const esteira = [...projetos, ...projetos];
---

<BaseLayout
  title="Miguel Moraes — Sites de Alta Conversão & Produtos Digitais | Orçamento em 24h"
  description="Seu site atrai visitantes mas não converte? Transformo acessos em clientes pagantes com SEO, respostas de IA, copywriting e design de alta conversão. Orçamento em 24h."
>
<div class="lp">

  <!-- HERO -->
  <header class="hero">
    <div class="wrap">
      <div class="me-pill">
        <img src="/webp/avatar.webp" alt="Miguel Moraes" width="28" height="28" />
        <span>Miguel Moraes</span>
        <span class="status-tag"><span class="dot"></span> Agenda aberta</span>
      </div>
      <h1>Seu site atrai visitantes e deixa dinheiro na mesa.</h1>
      <p class="sub">
        Transformo acessos em clientes pagantes. Estrutura otimizada para ser achado no Google, citado em pesquisas de IA e converter no celular e desktop.
      </p>
      <div class="cta">
        <a class="btn" href="#orcamento">Solicitar orçamento</a>
        <a class="btn btn-ghost" href="#trabalho">Ver projetos</a>
      </div>
      <p class="micro">Formulário de 1 minuto · Proposta sob medida em até 24h no WhatsApp</p>
    </div>
  </header>

  <!-- LOGOS -->
  <section class="sec sec-tight">
    <div class="wrap">
      <p class="kicker">Empresas com quem já trabalhei</p>
      <div class="logos">
        {logos.map((l) => (
          <div class="logo"><img src={l.src} alt={l.nome} style={`height:${l.h}px`} loading="lazy" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ONDE VAZA -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">O problema</span>
        <h2>O vazamento raramente está onde você acha que está.</h2>
        <p>Quase todo negócio já tem visita chegando no site. O que falta é ela virar contato.</p>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="ill">
            <svg viewBox="0 0 220 130" fill="none" aria-hidden="true">
              <rect x="18" y="22" width="120" height="13" rx="6.5" class="s-fill"/>
              <rect x="18" y="47" width="150" height="13" rx="6.5" class="s-fill"/>
              <rect x="18" y="72" width="104" height="13" rx="6.5" class="s-fill"/>
              <rect x="18" y="97" width="86" height="13" rx="6.5" class="s-accent-dash"/>
              <circle cx="168" cy="52" r="26" class="s-line"/>
              <path d="M187 71l15 14" class="s-line"/>
            </svg>
          </div>
          <h3>Ninguém acha você</h3>
          <p>Você aparece só pra quem já sabe o seu nome. Quem está procurando agora encontra o concorrente.</p>
        </div>

        <div class="card">
          <div class="ill">
            <svg viewBox="0 0 220 130" fill="none" aria-hidden="true">
              <path d="M50 24h120L128 74v34l-36 16V74L50 24Z" class="s-line"/>
              <path d="M50 24h120L128 74h-36L50 24Z" class="s-accent-fill"/>
              <circle cx="44" cy="60" r="5" class="s-accent-fill2"/>
              <circle cx="30" cy="86" r="4" class="s-accent-fill2"/>
              <circle cx="20" cy="110" r="3" class="s-accent-fill2"/>
              <circle cx="176" cy="60" r="5" class="s-accent-fill2"/>
              <circle cx="190" cy="86" r="4" class="s-accent-fill2"/>
              <circle cx="200" cy="110" r="3" class="s-accent-fill2"/>
            </svg>
          </div>
          <h3>Quem chega não fecha</h3>
          <p>A pessoa entra, não entende a oferta, não acha o preço e volta pro Google. Você nem sabe que ela passou.</p>
        </div>

        <div class="card">
          <div class="ill">
            <svg viewBox="0 0 220 130" fill="none" aria-hidden="true">
              <rect x="34" y="16" width="76" height="98" rx="8" class="s-fill"/>
              <rect x="46" y="24" width="76" height="98" rx="8" class="s-line" fill="#fff"/>
              <path d="M60 48h48M60 64h48M60 80h30" class="s-line"/>
              <circle cx="162" cy="72" r="28" class="s-line" fill="#fff"/>
              <path d="M162 56v16l11 7" class="s-accent"/>
            </svg>
          </div>
          <h3>Cada ajuste vira semana de espera</h3>
          <p>Toda mudança depende de terceiro e demora. Aí o site envelhece parado enquanto o negócio muda.</p>
        </div>

        <div class="card">
          <div class="ill">
            <svg viewBox="0 0 220 130" fill="none" aria-hidden="true">
              <path d="M28 114V22M28 114h164" class="s-line"/>
              <path d="M44 92l30-22 26 16 24-30" class="s-line"/>
              <path d="M124 56l26 14 30-34" class="s-dash"/>
              <circle cx="124" cy="56" r="5" class="s-accent-fill"/>
              <path d="M168 30c0-6 5-10 11-10s11 4 11 10c0 5-4 7-7 9-2 2-4 3-4 6" class="s-accent"/>
              <circle cx="179" cy="56" r="2.6" class="s-accent-fill"/>
            </svg>
          </div>
          <h3>Você decide no achismo</h3>
          <p>Sem número na mão, toda decisão vira aposta e todo investimento vira torcida.</p>
        </div>
      </div>

      <p class="verdict">Nada disso se resolve trocando o site por um mais bonito. Se resolve descobrindo onde a pessoa desiste e consertando aquilo primeiro.</p>
    </div>
  </section>

  <!-- PROCESSO -->
  <section class="sec sec-wash">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Achar, construir, medir.</h2>
        <p>A primeira etapa é a que quase ninguém faz, e é ela que decide se o resto vale o investimento.</p>
      </div>

      <ol class="steps">
        <li>
          <span class="k">01</span>
          <h3>Achar</h3>
          <p>Uma conversa sobre quem é o seu cliente e como ele decide comprar. Saio dela sabendo o que a sua página precisa provar, e em que ordem.</p>
        </li>
        <li>
          <span class="k">02</span>
          <h3>Construir</h3>
          <p>Eu escrevo, desenho e construo a página. Você aprova a estrutura e o texto antes de virar design, e acompanha o link ao vivo durante o processo.</p>
        </li>
        <li>
          <span class="k">03</span>
          <h3>Medir</h3>
          <p>Vai pro ar com medição instalada e 30 dias de ajuste inclusos. Dá pra ver onde a pessoa trava e corrigir com número na mão, não no achismo.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- CALCULADORA -->
  <section class="sec" id="conta">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">A conta</span>
        <h2>Quanto o seu site deixa na mesa por mês</h2>
        <p>A visita já está entrando. A conta abaixo é só do que ela deixaria se virasse contato.</p>
      </div>

      <div class="calc">
        <div class="inputs">
          <div class="field">
            <label for="vis">Visitantes por mês</label>
            <input id="vis" type="number" value="1500" min="0" inputmode="numeric" />
          </div>
          <div class="field">
            <label for="tic">Ticket médio (R$)</label>
            <input id="tic" type="number" value="900" min="0" inputmode="numeric" />
          </div>
          <div class="field">
            <label for="cnv">Conversão atual (%)</label>
            <input id="cnv" type="number" value="1" min="0" max="100" step="0.1" inputmode="decimal" />
          </div>
          <div class="field">
            <label for="gan">Ganho de conversão (pontos)</label>
            <input id="gan" type="number" value="1" min="0" max="20" step="0.1" inputmode="decimal" />
          </div>
        </div>

        <div class="out">
          <div class="out-badge"><span class="dot-live"></span> Simulação em tempo real</div>
          <span class="lbl">Receita adicional por ano</span>
          <strong class="big" id="oAno">R$ 162.000</strong>
          <div class="row"><span>Clientes a mais por mês</span><b id="oCli">15</b></div>
          <div class="row"><span>Receita adicional por mês</span><b id="oMes">R$ 13.500</b></div>
          <div class="row"><span>O que você já faz hoje</span><b id="oHoje">R$ 13.500</b></div>
          <p class="note">Estimativa simples, visitantes × ganho de conversão × ticket. Serve pra dimensionar a ordem de grandeza, não pra prometer número.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRABALHO -->
  <section class="sec sec-trabalho" id="trabalho">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Trabalho recente</span>
        <h2>Alguns projetos.</h2>
      </div>
    </div>

    <div class="esteira">
      <div class="trilho">
        {esteira.map((p) => (
          <figure class="shot">
            <img src={p.img} alt={p.nome} loading="lazy" decoding="async" />
            <figcaption>{p.nome}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- QUEM FAZ -->
  <section class="sec sec-wash">
    <div class="wrap">
      <div class="about">
        <img class="avatar" src="/webp/avatar.webp" alt="Miguel Moraes" loading="lazy" />
        <span class="eyebrow">Quem executa</span>
        <h2>Você fala e negocia direto com quem faz.</h2>
        <p>
          Sou o Miguel Moraes, designer em Porto Alegre. Desenvolvo a experiência visual e a estrutura de sites, produtos digitais e dashboards de alta conversão. Você fala e executa direto comigo, sem intermediários ou gerentes de conta no meio.
        </p>
      </div>
    </div>
  </section>

  <!-- OFERTA -->
  <section class="sec sec-wash">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">O investimento</span>
        <h2>Entrega pontual ou crescimento contínuo.</h2>
        <p>Preço fechado e escopo claro. Você escolhe se quer apenas a construção ou o acompanhamento mensal.</p>
      </div>

      <div class="oferta-grid">
        <!-- CARD 1: CONSTRUÇÃO -->
        <div class="oferta-card">
          <div>
            <div class="oferta-badge">
              <i class="ph-bold ph-lightning"></i>
              <span>Projeto Inicial · Entrega Pontual</span>
            </div>

            <div class="oferta-top">
              <div>
                <h3>Construção de Site ou LP</h3>
              </div>
              <div class="valor">
                <span class="de">a partir de</span>
                <strong>R$ 2.000</strong>
              </div>
            </div>

            <ul class="inclui">
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Estratégia comercial, copywriting e design de alta conversão</li>
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Estrutura otimizada para busca no Google e citações em IAs (SEO/GEO)</li>
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Site rápido, seguro e 100% resolvido para telas de celular</li>
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Medição instalada e 30 dias de acompanhamento inclusos</li>
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Código moderno, seguro e sem dependência de plugins pesados</li>
            </ul>
          </div>

          <div class="oferta-cta">
            <a class="btn" href="#orcamento">Solicitar orçamento</a>
            <span class="micro">Entrega em 2 a 4 semanas</span>
          </div>
        </div>

        <!-- CARD 2: MOTOR DE CRESCIMENTO -->
        <div class="oferta-card oferta-motor">
          <div>
            <div class="oferta-badge badge-accent">
              <i class="ph-bold ph-trend-up"></i>
              <span>Motor de Crescimento · Opcional</span>
            </div>

            <div class="oferta-top">
              <div>
                <h3>Evolução & Otimização Mensal</h3>
              </div>
              <div class="valor">
                <span class="de">a partir de</span>
                <strong>R$ 1.000 <small>/mês</small></strong>
              </div>
            </div>

            <ul class="inclui">
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Análise mensal de métricas de conversão e comportamento</li>
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Otimização contínua de copy e layout com base em dados reais</li>
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Criação e gestão de conteúdo estratégico focado em busca (SEO e IA)</li>
              <li><span class="chk"><i class="ph-bold ph-check"></i></span> Sem fidelidade: cancele ou pause a qualquer momento</li>
            </ul>
          </div>

          <div class="oferta-cta">
            <a class="btn btn-ghost" href="#orcamento">Incluir Motor</a>
            <span class="micro">Para quem busca crescimento recorrente</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Dúvidas</span>
        <h2>Perguntas frequentes</h2>
      </div>

      <div class="faq">
        <details open>
          <summary>Que tipo de site você faz?</summary>
          <p>Site institucional e landing page, que é o foco aqui. Também faço identidade visual, interface de produto digital e dashboard, e automação de processo, quando o projeto pede. Se o seu caso for um desses, manda mesmo assim que eu digo se faz sentido.</p>
        </details>
        <details>
          <summary>Qual é o investimento?</summary>
          <p>A construção do site começa em R$ 2.000 e sobe conforme o tamanho do escopo. Se quiser manter o site em evolução contínua com otimizações e novos conteúdos mensais, o Motor de Crescimento opcional começa em R$ 1.000/mês (sem fidelidade). Envio uma proposta fechada e transparente em até 24h.</p>
        </details>
        <details>
          <summary>Qual é o prazo de entrega?</summary>
          <p>De 2 a 4 semanas na maioria dos casos, contando da aprovação da estrutura. Se o projeto for maior que isso, eu digo o prazo antes de começar, não no meio.</p>
        </details>
        <details>
          <summary>Como a inteligência artificial é utilizada?</summary>
          <p>Uso IA todo dia pra construir mais rápido e automatizar o que é repetitivo, e é isso que faz o prazo caber. O que ela não faz é decidir o que entra na página, defender uma escolha e responder pelo resultado. Isso continua sendo trabalho de gente.</p>
        </details>
        <details>
          <summary>Eu já tenho site. Vale a pena refazer?</summary>
          <p>Costuma ser o caso mais barato, porque a visita já existe e o que falta é convertê-la. Na primeira conversa eu te digo se vale corrigir o que está lá ou refazer, e não é sempre que a resposta é refazer.</p>
        </details>
        <details>
          <summary>Como funciona a estrutura de execução do projeto?</summary>
          <p>Eu lidero pessoalmente a estratégia, a arquitetura e o design de cada projeto. Para frentes específicas ou demandas de maior escala (como campanhas ou produção de conteúdo), mobilizo parceiros seniores de extrema confiança. Você fala direto com quem responde pela entrega, garantindo agilidade e nível máximo de execução.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- FORMULÁRIO -->
  <section class="sec final" id="orcamento">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Orçamento</span>
        <h2>Me conta do seu negócio.</h2>
        <p>Seis campos. Ao enviar, abre o WhatsApp com tudo preenchido. Eu respondo em até 24h.</p>
      </div>

      <form class="form" id="orcamento-form">
        <div class="f2">
          <div class="field">
            <label for="nome">Seu nome</label>
            <input id="nome" name="nome" type="text" placeholder="Como você se chama" required />
          </div>
          <div class="field">
            <label for="empresa">Empresa e segmento</label>
            <input id="empresa" name="empresa" type="text" placeholder="Nome e área de atuação" required />
          </div>
        </div>

        <div class="f2">
          <div class="field">
            <label for="tipo">O que te trouxe aqui</label>
            <select id="tipo" name="tipo" required>
              <option value="" disabled selected>Selecione uma opção</option>
              <option>Tenho site, mas não traz resultado</option>
              <option>Quero refazer o site que já tenho</option>
              <option>Preciso de um novo site ou landing page</option>
              <option>Quero melhorar um produto digital ou dashboard</option>
              <option>Ainda não sei, quero conversar</option>
            </select>
          </div>
          <div class="field">
            <label for="prazo">Quando quer começar</label>
            <select id="prazo" name="prazo" required>
              <option value="" disabled selected>Selecione uma opção</option>
              <option>O quanto antes</option>
              <option>Nas próximas semanas</option>
              <option>Só pesquisando por enquanto</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="orcamento-valor">Investimento previsto</label>
          <select id="orcamento-valor" name="orcamento-valor" required>
            <option value="" disabled selected>Selecione uma faixa</option>
            <option>Até R$ 3.000</option>
            <option>Entre R$ 3.000 e R$ 7.000</option>
            <option>Entre R$ 7.000 e R$ 15.000</option>
            <option>Acima de R$ 15.000</option>
            <option>Ainda não defini</option>
          </select>
        </div>

        <div class="field">
          <label for="contexto">Me conta um pouco do negócio</label>
          <textarea id="contexto" name="contexto" rows="3" placeholder="Ex: clínica em POA, chega gente pelo Google mas quase ninguém liga pra marcar" required></textarea>
        </div>

        <button type="submit" class="btn btn-lg">
          <i class="ph-bold ph-whatsapp-logo"></i>
          Enviar e continuar no WhatsApp
        </button>
        <p class="micro">Seus dados vão direto pra mim. Sem cadastro, sem lista de e-mail.</p>
      </form>
    </div>
  </section>

  <footer class="foot">
    <div class="wrap">
      <div class="foot-top">
        <div class="foot-brand">
          <div class="foot-me">
            <img src="/webp/avatar.webp" alt="Miguel Moraes" width="32" height="32" />
            <div>
              <strong>Miguel Moraes</strong>
              <span>Designer & Especialista Digital</span>
            </div>
          </div>
          <p class="foot-bio">
            Desenvolvo a experiência visual e a estrutura comercial de sites, landing pages e produtos digitais de alta conversão.
          </p>
          <div class="foot-status">
            <span class="dot-live"></span>
            <span>Atendendo novos projetos · Porto Alegre, RS</span>
          </div>
        </div>

        <div class="foot-col">
          <span class="foot-label">Contato direto</span>
          <ul class="foot-list">
            <li>
              <a href="https://wa.me/5551998734305" target="_blank" rel="noopener">
                <i class="ph-bold ph-whatsapp-logo"></i> (51) 99873-4305
              </a>
            </li>
            <li>
              <a href="mailto:omiguelmoraes@outlook.com">
                <i class="ph-bold ph-envelope-simple"></i> omiguelmoraes@outlook.com
              </a>
            </li>
          </ul>
        </div>

        <div class="foot-col">
          <span class="foot-label">Redes</span>
          <ul class="foot-list">
            <li><a href="https://instagram.com/omiguelmoraes" target="_blank" rel="noopener"><i class="ph-bold ph-instagram-logo"></i> Instagram</a></li>
            <li><a href="https://linkedin.com/in/miguelmoraes/" target="_blank" rel="noopener"><i class="ph-bold ph-linkedin-logo"></i> LinkedIn</a></li>
          </ul>
        </div>
      </div>

      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} Miguel Moraes. Todos os direitos reservados.</span>
        <span>Menos slop. Mais design.</span>
      </div>
    </div>
  </footer>

  <div class="dock" id="dock">
    <div class="dock-in">
      <div class="dock-info">
        <strong>Precisa de um projeto sob medida?</strong>
        <span>Resposta no WhatsApp em até 24h</span>
      </div>
      <a class="btn" href="#orcamento">Solicitar orçamento</a>
    </div>
  </div>

</div>
</BaseLayout>

<script>
  // Form -> WhatsApp, mesmo fluxo da /mentoria
  const form = document.getElementById('orcamento-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement).value;

    const text = `Olá Miguel! Vim pela landing page e quero um orçamento.

*Nome:* ${v('nome')}
*Empresa:* ${v('empresa')}
*Situação:* ${v('tipo')}
*Quando:* ${v('prazo')}
*Investimento previsto:* ${v('orcamento-valor')}
*Negócio:* ${v('contexto')}`;

    // Evento de lead. O Umami já está no BaseLayout; o fbq é no-op enquanto o
    // pixel do Meta não estiver na página, e é ele que a campanha precisa pra
    // otimizar por lead em vez de por clique
    (window as any).umami?.track?.('lead-orcamento');
    (window as any).fbq?.('track', 'Lead');

    window.open(
      `https://api.whatsapp.com/send?phone=5551998734305&text=${encodeURIComponent(text)}`,
      '_blank'
    );
  });

  // Calculadora
  const brl = (n: number) =>
    'R$ ' + Math.round(n).toLocaleString('pt-BR');
  const num = (id: string) =>
    parseFloat((document.getElementById(id) as HTMLInputElement)?.value || '0') || 0;

  const calcular = () => {
    const alvo = document.getElementById('oAno');
    if (!alvo) return;
    const clientes = (num('vis') * num('gan')) / 100;
    const mes = clientes * num('tic');
    alvo.textContent = brl(mes * 12);
    document.getElementById('oCli')!.textContent = Math.round(clientes).toLocaleString('pt-BR');
    document.getElementById('oMes')!.textContent = brl(mes);
    document.getElementById('oHoje')!.textContent = brl(((num('vis') * num('cnv')) / 100) * num('tic'));
  };
  ['vis', 'tic', 'cnv', 'gan'].forEach((id) =>
    document.getElementById(id)?.addEventListener('input', calcular)
  );
  calcular();

  // Dock entra depois da primeira dobra e some na seção do formulário
  const dock = document.getElementById('dock');
  const alvo = document.getElementById('orcamento');
  const onScroll = () => {
    if (!dock) return;
    const passouDobra = window.scrollY > window.innerHeight * 0.7;
    const chegouNoForm = alvo ? alvo.getBoundingClientRect().top < window.innerHeight : false;
    dock.classList.toggle('on', passouDobra && !chegouNoForm);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style is:global>
