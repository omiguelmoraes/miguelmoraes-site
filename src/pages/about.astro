---
import SiteLayout from '../layouts/SiteLayout.astro';
import Lightbox from '../components/Lightbox.astro';
---

<SiteLayout
  title="About — Miguel Moraes"
  description="Work experience, talks and education. Designer based in Porto Alegre, Brazil."
>
  <div class="content">

    <!-- Intro -->
    <section class="section">
      <h2 class="section-title">About</h2>
      <p class="section-body">
        I'm a designer from Porto Alegre, Brazil. I work at the intersection of visual design, UI/UX and front-end — I like understanding how things are built, not just how they look. Currently Web Designer at Barca, studying Systems Analysis and Development, and running <a href="https://www.korbi.studio" target="_blank" rel="noopener">Korbi Studio</a> on the&nbsp;side.
      </p>
    </section>

    <!-- Work -->
    <section class="section">
      <h2 class="section-title">Work Experience</h2>
      <div class="rows rows--divided">

        <div class="row">
          <span class="date">2026 — Now</span>
          <div class="row-content">
            <a href="https://barca.cc/" target="_blank" rel="noopener" class="row-link">
              Web Designer at Barca
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="row-sub">Porto Alegre, Brazil</span>
            <p class="row-desc">I design and build websites in Framer, focused on conversion and performance for subscription-based digital&nbsp;brands.</p>
          </div>
        </div>

        <div class="row">
          <span class="date">2025 — 2026</span>
          <div class="row-content">
            <a href="https://opservices.com.br" target="_blank" rel="noopener" class="row-link">
              UX/UI & Marketing Designer at OpServices
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="row-sub">Porto Alegre, Brazil</span>
            <p class="row-desc">Designed marketing materials, from campaigns to dashboards, and led an institutional visual refresh for a B2B tech&nbsp;company.</p>
            <div class="row-images">
              <div class="row-image"><img src="/work/opservices-1.webp" alt="Design work at OpServices" class="lightbox-trigger" width="200" height="130" loading="lazy" /></div>
              <div class="row-image"><img src="/work/opservices-2.webp" alt="Design work at OpServices" class="lightbox-trigger" width="200" height="130" loading="lazy" /></div>
              <div class="row-image"><img src="/work/opservices-3.webp" alt="Design work at OpServices" class="lightbox-trigger" width="200" height="130" loading="lazy" /></div>
            </div>
          </div>
        </div>

        <div class="row">
          <span class="date">2022 — Now</span>
          <div class="row-content">
            <span class="row-link">Independent Designer</span>
            <span class="row-sub">Remote</span>
            <p class="row-desc">Visual identity, branding and UX/UI for digital products, aligning strategic design with business goals.</p>
          </div>
        </div>

        <div class="row">
          <span class="date">2024 — 2025</span>
          <div class="row-content">
            <span class="row-link">UX/UI Designer at Synapsy Design</span>
            <span class="row-sub">São Paulo, Brazil · Remote</span>
            <p class="row-desc">Built wireframes and prototypes in Figma and Framer, defined design guidelines, and optimized interfaces through market research.</p>
          </div>
        </div>

        <div class="row">
          <span class="date">2023 — 2024</span>
          <div class="row-content">
            <a href="https://gama.etc.br/" target="_blank" rel="noopener" class="row-link">
              Visual & Web Designer at Gama Marketing
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="row-sub">São Leopoldo, Brazil</span>
            <p class="row-desc">Visual materials, logos, and websites with strong interfaces to boost online presence through Visual Design and Branding.</p>
            <div class="row-images">
              <div class="row-image"><img src="/work/gama-1.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="200" height="130" loading="lazy" /></div>
              <div class="row-image"><img src="/work/gama-2.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="200" height="130" loading="lazy" /></div>
              <div class="row-image"><img src="/work/gama-3.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="200" height="130" loading="lazy" /></div>
            </div>
          </div>
        </div>

        <div class="row">
          <span class="date">2023</span>
          <div class="row-content">
            <span class="row-link">Graphic Designer at Agência Blanc</span>
            <span class="row-sub">Campo Bom, Brazil</span>
            <p class="row-desc">Visual identities and graphic materials, organized workflows, and worked with Illustrator and Photoshop.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- Speaking -->
    <section class="section">
      <h2 class="section-title">Speaking</h2>
      <div class="rows rows--divided">
        <div class="row">
          <span class="date">2025</span>
          <div class="row-content">
            <a href="https://www.youtube.com/watch?v=aQbXjIAik4I" target="_blank" rel="noopener" class="row-link">
              OpCast — Dashboard Design with AI
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="row-sub">OpServices Podcast</span>
            <p class="row-desc">Discussed best practices for building dashboards in Grafana, how to use AI in the design process, and what makes a data visualization effective and actionable.</p>
          </div>
        </div>
        <div class="row">
          <span class="date">2024</span>
          <div class="row-content">
            <span class="row-link">Branding for Small Businesses</span>
            <span class="row-sub">Instituto Caldeira · Porto Alegre, Brazil · with Gama Marketing</span>
            <p class="row-desc">Talk covering what branding really means, how to apply it practically, and why investing in brand identity creates tangible business value for small companies.</p>
            <div class="row-images">
              <div class="row-image"><img src="/speaking/IMG_4196.webp" alt="Miguel Moraes speaking at Instituto Caldeira — Branding for Small Businesses" class="lightbox-trigger rotate-90" width="200" height="130" loading="lazy" /></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Side Projects -->
    <section class="section">
      <h2 class="section-title">Side Projects</h2>
      <div class="rows">
        <div class="row">
          <span class="date">2026</span>
          <div class="row-content">
            <a href="https://www.korbi.studio" target="_blank" rel="noopener" class="row-link">
              Korbi Studio
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="row-desc">Strategic design studio</span>
          </div>
        </div>
        <div class="row">
          <span class="date">2026</span>
          <div class="row-content">
            <span class="row-link">Mentorship & Consulting</span>
            <span class="row-desc">One-on-one for visual designers & freelancers · Coming soon</span>
          </div>
        </div>
        <div class="row">
          <span class="date">2024</span>
          <div class="row-content">
            <a href="/packpro" class="row-link">
              PackPro
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="row-desc">Templates for freelancers</span>
          </div>
        </div>
        <div class="row">
          <span class="date"></span>
          <a href="/toolkit" class="see-all">See my toolkit →</a>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="section">
      <h2 class="section-title">Education</h2>
      <div class="rows rows--divided">
        <div class="row">
          <span class="date">2024 — Now</span>
          <div class="row-content">
            <span class="row-link">Tecnólogo em Análise e Desenvolvimento de Sistemas</span>
            <span class="row-sub">Unisinos, Porto Alegre</span>
            <p class="row-desc">Currently studying Systems Analysis and Development, focused on software engineering.</p>
          </div>
        </div>
        <div class="row">
          <span class="date">2019</span>
          <div class="row-content">
            <span class="row-link">Cambridge English Level 2 Certificate (Advanced)</span>
            <span class="row-sub">Greenwich College, Sydney, Australia</span>
            <p class="row-desc">Earned the certificate at Greenwich College while on a student exchange in Australia.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section">
      <h2 class="section-title">Contact</h2>
      <div class="rows">
        <div class="row">
          <span class="date">Email</span>
          <div class="row-content">
            <a href="mailto:omiguelmoraes@outlook.com" class="row-link">omiguelmoraes@outlook.com</a>
          </div>
        </div>
        <div class="row">
          <span class="date">LinkedIn</span>
          <div class="row-content">
            <a href="https://linkedin.com/in/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              /omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
          </div>
        </div>
        <div class="row">
          <span class="date">Instagram</span>
          <div class="row-content">
            <a href="https://instagram.com/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              @omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
          </div>
        </div>
        <div class="row">
          <span class="date">Behance</span>
          <div class="row-content">
            <a href="https://www.behance.net/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              /omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
          </div>
        </div>
        <div class="row">
          <span class="date">X</span>
          <div class="row-content">
            <a href="https://x.com/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              @omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <Lightbox />
</SiteLayout>

<style>
  .content :global(.section-body) {
    max-width: var(--prose-max-width);
  }

  .content :global(.section-body a) {
    color: var(--color-title);
    text-decoration: underline;
  }
</style>
