---
import SiteLayout from '../layouts/SiteLayout.astro';

const toolkit = [
  { name: 'Mac Mini M4', note: "Apple's most capable compact desktop — fast, silent, small.", href: 'https://www.apple.com/mac-mini/', group: 'Hardware' },
  { name: 'MX Master 3', note: "Best productivity mouse I've used. Comfortable for long sessions.", href: 'https://www.logitech.com/products/mice/mx-master-3s.html', group: 'Hardware' },
  { name: 'AOC 27" QHD', note: 'Sharp, spacious monitor for everyday design and dev work.', href: '', group: 'Hardware' },
  { name: 'Aula F75', note: 'Compact 75% mechanical keyboard. Great value.', href: '', group: 'Hardware' },
  { name: 'Edifier W820NB', note: 'Wireless headphones with decent noise cancellation.', href: '', group: 'Hardware' },
  { name: 'Figma', note: 'Design, prototyping, and brand work.', href: 'https://figma.com', group: 'Software' },
  { name: 'Cursor', note: 'AI-powered code editor. Changed how I write code.', href: 'https://cursor.sh', group: 'Software' },
  { name: 'Claude', note: 'AI for coding, content creation, and thinking through problems.', href: 'https://claude.ai', group: 'Software' },
  { name: 'Obsidian', note: 'Second brain and note-taking. All my notes live here.', href: 'https://obsidian.md', group: 'Software' },
  { name: 'TickTick', note: 'Task and project management with time blocking built in.', href: 'https://ticktick.com', group: 'Software' },
  { name: 'Ghostty', note: 'Fast and minimal terminal.', href: 'https://ghostty.org', group: 'Software' },
  { name: 'Arc', note: 'Browser I switched to, mainly for Spaces and the sidebar.', href: 'https://arc.net/', group: 'Software' },
  { name: 'Apple Calendar', note: 'Simple. Does the job.', href: '', group: 'Software' },
  { name: "Don't Make Me Think", note: 'Steve Krug — The classic on web usability. Essential for anyone in design.', href: '', group: 'Books' },
  { name: 'Win Without Pitching Manifesto', note: 'Blair Enns — How to position yourself and stop competing on price.', href: '', group: 'Books' },
  { name: 'Rework', note: 'Jason Fried & DHH — A different way to think about work and building things.', href: '', group: 'Books' },
  { name: 'The Art of Thinking in Graphs', note: 'Visual thinking and structured problem-solving.', href: '', group: 'Books' },
  { name: 'Princípio de UX', note: 'Daniel Furtado — UX in Portuguese, well-grounded and practical.', href: '', group: 'Books' },
  { name: 'Fall in Love with the Problem, Not the Solution', note: 'Uri Levine — On building products that solve real problems.', href: '', group: 'Books' },
];
---

<SiteLayout
  title="About — Miguel Moraes"
  description="Designer from Porto Alegre, Brazil. Side projects, and how to reach me."
>
  <div class="content">

    <header class="page-header">
      <h1 class="page-title">About</h1>
      <p class="page-intro">
        I'm a designer from Porto Alegre, Brazil. I work at the intersection of visual design, UI/UX and front-end — I like understanding how things are built, not just how they look. Currently Web Designer at <a href="https://barca.cc/" target="_blank" rel="noopener">Barca</a>, studying Systems Analysis and Development at Unisinos, and running <a href="https://www.korbi.studio" target="_blank" rel="noopener">Korbi Studio</a> on the&nbsp;side.
      </p>
      <p class="page-intro">
        Most of what I do comes back to the same question: why some things get noticed and others don't. I write about it in <a href="/blog">Portuguese</a>, and I build things to find&nbsp;out.
      </p>
    </header>

    <!-- Side Projects -->
    <section class="section">
      <h2 class="section-title">Side Projects</h2>
      <p class="section-body">Things I build outside of work — a studio, a product, and whatever comes next.</p>
      <div class="rows rows--tight">

        <div class="row">
          <div class="row-head">
            <a href="https://www.korbi.studio" target="_blank" rel="noopener" class="row-link">
              Korbi Studio
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2026</span>
          </div>
          <span class="row-sub">Strategic design studio</span>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Mentorship & Consulting</span>
            <span class="date">2026</span>
          </div>
          <span class="row-sub">One-on-one for visual designers & freelancers · Coming soon</span>
        </div>

        <div class="row">
          <div class="row-head">
            <a href="/packpro" class="row-link">
              PackPro
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2024</span>
          </div>
          <span class="row-sub">Templates for freelancers</span>
        </div>

      </div>
    </section>

    <!-- Toolkit -->
    <section class="section" id="toolkit">
      <h2 class="section-title">Toolkit</h2>
      <p class="section-body">Gear, software and books I use and recommend.</p>
      <div class="rows rows--tight">
        {toolkit.map(item => (
          <div class="row">
            <div class="row-head">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener" class="row-link">
                  {item.name}
                  <i class="ph ph-arrow-square-out"></i>
                </a>
              ) : (
                <span class="row-link">{item.name}</span>
              )}
              <span class="date">{item.group}</span>
            </div>
            <span class="row-sub">{item.note}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section class="section">
      <h2 class="section-title">Contact</h2>
      <p class="section-body">Best by email or WhatsApp. I answer both.</p>
      <div class="rows rows--tight">
        <div class="row">
          <div class="row-head">
            <a href="mailto:omiguelmoraes@outlook.com" class="row-link">omiguelmoraes@outlook.com</a>
            <span class="date">Email</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://api.whatsapp.com/send?phone=5551998734305" target="_blank" rel="noopener" class="row-link">
              +55 51 99873-4305
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">WhatsApp</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://linkedin.com/in/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              /omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">LinkedIn</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://instagram.com/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              @omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">Instagram</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://www.behance.net/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              /omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">Behance</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://x.com/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              @omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">X</span>
          </div>
        </div>
      </div>
    </section>

  </div>
</SiteLayout>
