---
import SiteLayout from '../layouts/SiteLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';

// Qualquer imagem solta em src/assets/about/ aparece aqui, sem tocar no código
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/about/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const photos = Object.entries(photoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<SiteLayout
  title="About — Miguel Moraes"
  description="Designer from Porto Alegre, Brazil. Side projects, and how to reach me."
>
  <div class="content">

    <header class="page-header">
      <h1 class="page-title">About</h1>
      <p class="page-intro">
        I'm a designer from Porto Alegre, Brazil. I work at the intersection of visual design, UI/UX and front-end — I like understanding how things are built, not just how they look. Currently Web Designer at <a href="https://barca.cc/" target="_blank" rel="noopener">Barca</a>, studying Systems Analysis and Development at Unisinos, and running <a href="https://www.korbi.studio" target="_blank" rel="noopener">Korbi Studio</a> on the&nbsp;side.
      </p>
      <p class="page-intro">
        Most of what I do comes back to the same question: why some things get noticed and others don't. I write about it in <a href="/blog">Portuguese</a>, and I build things to find&nbsp;out.
      </p>
    </header>

    {photos.length > 0 && (
      <section class="section">
        <h2 class="section-title">Photos</h2>
        <p class="section-body">Bits of the day to day — desk, city, work in progress.</p>
        <div class="photo-grid">
          {photos.map(photo => (
            <div class="row-image">
              <Image src={photo} alt="" widths={[300, 600]} sizes="(max-width: 600px) 50vw, 220px" class="lightbox-trigger" loading="lazy" />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Side Projects -->
    <section class="section">
      <h2 class="section-title">Side Projects</h2>
      <p class="section-body">Things I build outside of work — a studio, a product, and whatever comes next.</p>
      <div class="rows rows--tight">

        <div class="row">
          <div class="row-head">
            <a href="https://www.korbi.studio" target="_blank" rel="noopener" class="row-link">
              Korbi Studio
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2026</span>
          </div>
          <span class="row-sub">Strategic design studio</span>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Mentorship & Consulting</span>
            <span class="date">2026</span>
          </div>
          <span class="row-sub">One-on-one for visual designers & freelancers · Coming soon</span>
        </div>

        <div class="row">
          <div class="row-head">
            <a href="/packpro" class="row-link">
              PackPro
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2024</span>
          </div>
          <span class="row-sub">Templates for freelancers</span>
        </div>

      </div>
    </section>


    <!-- Contact -->
    <section class="section">
      <h2 class="section-title">Contact</h2>
      <p class="section-body">Best by email or WhatsApp. I answer both.</p>
      <div class="rows rows--tight">
        <div class="row">
          <div class="row-head">
            <a href="mailto:omiguelmoraes@outlook.com" class="row-link">omiguelmoraes@outlook.com</a>
            <span class="date">Email</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://api.whatsapp.com/send?phone=5551998734305" target="_blank" rel="noopener" class="row-link">
              +55 51 99873-4305
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">WhatsApp</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://linkedin.com/in/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              /omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">LinkedIn</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://instagram.com/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              @omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">Instagram</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://www.behance.net/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              /omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">Behance</span>
          </div>
        </div>
        <div class="row">
          <div class="row-head">
            <a href="https://x.com/omiguelmoraes" target="_blank" rel="noopener" class="row-link">
              @omiguelmoraes
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">X</span>
          </div>
        </div>
      </div>
    </section>

  </div>

  <Lightbox />
</SiteLayout>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .photo-grid :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    height: auto;
    object-fit: cover;
    cursor: zoom-in;
  }

  @media (max-width: 600px) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
