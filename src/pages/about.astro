---
import SiteLayout from '../layouts/SiteLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image, getImage } from 'astro:assets';
import ContactLinks from '../components/ContactLinks.astro';

// Qualquer imagem solta em src/assets/about/ aparece aqui, sem tocar no código
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/about/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const photos = await Promise.all(
  Object.entries(photoModules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([, mod]) => ({
      src: mod.default,
      // O lightbox usava o currentSrc, que é a versão pequena do srcset. Sem uma
      // fonte maior, a imagem abria no tamanho da miniatura
      full: (await getImage({ src: mod.default, width: 1400, format: 'webp' })).src,
    }))
);
---

<SiteLayout
  title="Sobre — Miguel Moraes"
  description="Designer de Porto Alegre, Brasil. Projetos paralelos e formas de contato."
>
  <div class="content">

    <header class="page-header">
      <h1 class="page-title">Olá, sou o Miguel 👋🏽</h1>
      <p class="page-intro">
        Tenho 26 anos e moro em Porto Alegre. Desenvolvo e construo sites: na <a href="https://barca.cc/" target="_blank" rel="noopener">Barca</a> durante a semana, e na <a href="https://www.korbi.studio" target="_blank" rel="noopener">Korbi</a>, meu próprio estúdio, no tempo livre.
      </p>
      <p class="page-intro">
        Vim do lado visual e fui aprofundando até conseguir colocar os projetos no ar sozinho. Entregar um arquivo no Figma e ver os detalhes se perderem no desenvolvimento cansou rápido. É por isso também que estudo Análise e Desenvolvimento de Sistemas: queria entender exatamente o que acontece depois do design.
      </p>
      <p class="page-intro">
        A pergunta que sempre me faço é por que algumas coisas chamam atenção e outras não. Mesmo produto, mesmo preço, resultado totalmente diferente. Escrevo sobre isso no meu <a href="/blog">blog</a>, e treinar todo dia é a única rotina que realmente consegui manter.
      </p>
    </header>

    {photos.length > 0 && (
      <section class="section">
        <h2 class="section-title">Vida Recente</h2>
        <p class="section-body">Mesa de trabalho, cidade, treino e projetos em andamento. Um recorte das últimas semanas.</p>
        <div class="photo-grid">
          {photos.map(photo => (
            <div class="row-image">
              <Image
                src={photo.src}
                alt=""
                widths={[400, 800]}
                sizes="(max-width: 600px) 45vw, 170px"
                class="lightbox-trigger"
                data-full={photo.full}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Side Projects -->
    <section class="section">
      <h2 class="section-title">Projetos Paralelos</h2>
      <p class="section-body">Coisas que construo fora do trabalho: um estúdio, produtos e o que vier a seguir.</p>
      <div class="rows rows--tight">

        <div class="row">
          <div class="row-head">
            <a href="https://www.korbi.studio" target="_blank" rel="noopener" class="row-link">
              Korbi Studio
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2026</span>
          </div>
          <span class="row-sub">Estúdio de design estratégico</span>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Mentoria &amp; Consultoria</span>
            <span class="date">2026</span>
          </div>
          <span class="row-sub">Individual para designers visuais &amp; freelancers · Em breve</span>
        </div>

        <div class="row">
          <div class="row-head">
            <a href="/packpro" class="row-link">
              PackPro
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2024</span>
          </div>
          <span class="row-sub">Templates e recursos para freelancers</span>
        </div>

      </div>
    </section>


    <!-- Contact -->
    <section class="section">
      <h2 class="section-title">Contato</h2>
      <p class="section-body">O WhatsApp é o caminho mais rápido para falar comigo.</p>
      <ContactLinks />

    </section>

  </div>

  <Lightbox />
</SiteLayout>

<style>
  /* Faixa de quatro quadrados: registro do dia a dia, não galeria. Em duas
     colunas verticais o bloco ocupava mais altura que qualquer seção da página */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .photo-grid :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    object-fit: cover;
    cursor: zoom-in;
  }

  /* Mesmo comportamento das tiras do Career: em fila que rola, a foto cortada
     na margem sinaliza que tem mais, em vez de empilhar duas linhas */
  @media (max-width: 600px) {
    .photo-grid {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--layout-padding-x) * -1);
      padding-inline: var(--layout-padding-x);
    }

    .photo-grid::-webkit-scrollbar {
      display: none;
    }

    .photo-grid > * {
      flex: 0 0 52%;
    }
  }
</style>
