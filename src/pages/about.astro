---
import SiteLayout from '../layouts/SiteLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';
import ContactLinks from '../components/ContactLinks.astro';

// Qualquer imagem solta em src/assets/about/ aparece aqui, sem tocar no código
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/about/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const photos = Object.entries(photoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<SiteLayout
  title="About — Miguel Moraes"
  description="Designer from Porto Alegre, Brazil. Side projects, and how to reach me."
>
  <div class="content">

    <header class="page-header">
      <h1 class="page-title">Hi, I'm Miguel</h1>
      <p class="page-intro">
        I'm 22, from Porto Alegre, and I've been designing since before I knew it was a job. Today I'm Web Designer at <a href="https://barca.cc/" target="_blank" rel="noopener">Barca</a>, studying Systems Analysis and Development at Unisinos, and running <a href="https://www.korbi.studio" target="_blank" rel="noopener">Korbi Studio</a> on the&nbsp;side.
      </p>
      <p class="page-intro">
        I'm the kind of designer who opens the inspector. I got tired of handing files over and watching the details get lost, so I learned to build. Most of what I ship now, I ship&nbsp;myself.
      </p>
      <p class="page-intro">
        Outside of screens: the gym every day, way too much coffee, and books I keep buying faster than I read them. I write in <a href="/blog">Portuguese</a> about all of&nbsp;it.
      </p>
    </header>

    <!-- Side Projects -->
    <section class="section">
      <h2 class="section-title">Side Projects</h2>
      <p class="section-body">Things I build outside of work: a studio, a product, and whatever comes next.</p>
      <div class="rows rows--tight">

        <div class="row">
          <div class="row-head">
            <a href="https://www.korbi.studio" target="_blank" rel="noopener" class="row-link">
              Korbi Studio
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2026</span>
          </div>
          <span class="row-sub">Strategic design studio</span>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Mentorship & Consulting</span>
            <span class="date">2026</span>
          </div>
          <span class="row-sub">One-on-one for visual designers & freelancers · Coming soon</span>
        </div>

        <div class="row">
          <div class="row-head">
            <a href="/packpro" class="row-link">
              PackPro
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2024</span>
          </div>
          <span class="row-sub">Templates for freelancers</span>
        </div>

      </div>
    </section>


    {photos.length > 0 && (
      <section class="section">
        <h2 class="section-title">Life Recently</h2>
        <p class="section-body">Desk, city, gym, work in progress. Whatever the last few weeks looked&nbsp;like.</p>
        <div class="photo-grid">
          {photos.map(photo => (
            <div class="row-image">
              <Image src={photo} alt="" widths={[400, 800]} sizes="(max-width: 600px) 50vw, 340px" class="lightbox-trigger" loading="lazy" />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Contact -->
    <section class="section">
      <h2 class="section-title">Contact</h2>
      <p class="section-body">WhatsApp is the fastest way to reach me.</p>
      <ContactLinks />

    </section>

  </div>

  <Lightbox />
</SiteLayout>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .photo-grid :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    height: auto;
    object-fit: cover;
    cursor: zoom-in;
  }

  @media (max-width: 600px) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
