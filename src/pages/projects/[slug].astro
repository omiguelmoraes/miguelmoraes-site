---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import TechStack from '../../components/TechStack.astro';
import { allProjects, toImage } from '../../data/projects';

export function getStaticPaths() {
  return Object.keys(allProjects).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = allProjects[slug as keyof typeof allProjects];
const projectEntries = Object.entries(allProjects);
const currentIndex = projectEntries.findIndex(([s]) => s === slug);
const prevProject = projectEntries[(currentIndex - 1 + projectEntries.length) % projectEntries.length];
const nextProject = projectEntries[(currentIndex + 1) % projectEntries.length];
const otherProjects = [prevProject, nextProject];
---

<SiteLayout image={project.cover} title={project.title + " — Miguel Moraes"} description={project.description}>
  <div class="page">

    <nav class="nav">
      <a href="/projects" class="back">← Todos os projetos</a>
    </nav>

    <header class="header">
      <div class="header-main">
        <h1 class="title">{project.title}</h1>
        {(project.headline || project.description) && <p class="headline">{project.headline || project.description}</p>}
      </div>

      <div class="meta-grid">
        <div class="meta-col">
          <span class="meta-label">Função</span>
          <span class="meta-value">{project.role || project.category}</span>
        </div>
        <div class="meta-col">
          <span class="meta-label">Ano</span>
          <span class="meta-value">{project.year}</span>
        </div>
        <div class="meta-col">
          <span class="meta-label">Localização</span>
          <span class="meta-value">{project.location}</span>
        </div>
        {project.industry && (
          <div class="meta-col">
            <span class="meta-label">Setor</span>
            <span class="meta-value">{project.industry}</span>
          </div>
        )}
      </div>

      {project.stack && project.stack.length > 0 && (
        <div class="header-stack">
          <span class="meta-label">Ferramentas</span>
          <TechStack stack={project.stack} />
        </div>
      )}
    </header>

    <div class={"cover" + (project.coverVideo ? " cover-video" : "")} style={project.coverVideo ? "--cover-poster: url(" + project.cover + ")" : "cursor: zoom-in"}>
      {project.coverVideo ? (
        <video
          src={project.coverVideo}
          poster={project.cover}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={project.title}
          style={"view-transition-name: project-image-" + slug}
        />
      ) : (
        <img src={project.cover} alt={project.title} class="lightbox-trigger" width="1200" height="675" style={"view-transition-name: project-image-" + slug} />
      )}
    </div>

    {project.results && (
      <section class="section resultados">
        <span class="section-label">Em números</span>
        <div class={"results n" + project.results.length}>
          {project.results.map((r) => (
            <div class="result">
              <span class="result-value">{r.value}</span>
              <span class="result-label">{r.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <main class="body">

      {project.sections.map((section, si) => (
        <section class="section">
          <span class="section-label">{section.label}</span>
          {section.heading && <h2 class="section-heading">{section.heading}</h2>}
          {section.body.map((bloco) => (
            bloco.type === 'list'
              ? <ul class="section-list">{bloco.items.map((item) => <li set:html={item} />)}</ul>
              : <p class="section-body" set:html={bloco.html} />
          ))}
          {si === project.sections.length - 1 && project.url && (
            <div class="visit-wrap">
              <a href={project.url} target="_blank" rel="noopener" class="visit-link">
                Ver projeto
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </a>
            </div>
          )}
          <div class="image-grid">
            {section.images.map((img, i) => {
              const { src, caption } = toImage(img);
              const isDetail = src.includes("atlas-juridico-04-documentos");
              return (
                <figure class:list={["image-item", { "image-detail": isDetail }]}>
                  <div class="image-frame">
                    <img src={src} alt={caption || project.title + ": " + (section.heading || section.label) + ", imagem " + (i + 1)} data-caption={caption} class="lightbox-trigger" loading="lazy" width="800" height="600" />
                  </div>
                  {caption && <figcaption class="image-caption">{caption}</figcaption>}
                </figure>
              );
            })}
          </div>
        </section>
      ))}

    </main>

    <footer class="project-footer">
      <div class="footer-top">
        <span class="section-label">Outros projetos</span>
        <div class="footer-projects">
          {otherProjects.map(([s, p]) => (
            <a href={"/projects/" + s} class="footer-project">
              <div class="footer-project-cover">
                <img src={p.cover} alt={p.title} loading="lazy" width="400" height="225" />
              </div>
              <span class="footer-project-title">{p.title}</span>
            </a>
          ))}
        </div>
      </div>
      <div class="footer-links">
        <a href="/projects" class="home-link">Ver todos os projetos →</a>
      </div>
    </footer>

  </div>
</SiteLayout>

<Lightbox />

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .nav { margin-bottom: 0; }

  .back {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  @media (hover: hover) {
    .back:hover {
      color: var(--color-title);
    }
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .header-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 20px;
    padding-block: 16px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .meta-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-label {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .meta-value {
    font-size: var(--font-size-small);
    color: var(--color-title);
    font-weight: 400;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .title {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.04;
    color: var(--color-title);
    text-wrap: balance;
  }

  .cover {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
  }

  .cover-video {
    aspect-ratio: 16/9;
  }

  .cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .cover video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Vídeo no topo é ambiente, não conteúdo: quem pediu menos movimento no
     sistema fica com o pôster, que é a própria capa */
  @media (prefers-reduced-motion: reduce) {
    .cover video {
      display: none;
    }
    .cover-video {
      background-image: var(--cover-poster);
      background-size: cover;
      background-position: center;
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .body > .section {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    column-gap: 48px;
    row-gap: 16px;
  }

  .section-label {
    font-size: var(--font-size-small);
    font-weight: 400;
    color: var(--color-muted);
  }

  .body > .section .section-label {
    grid-column: 1;
    grid-row: 1;
    padding-top: 6px;
  }

  .body > .section .section-heading,
  .body > .section .section-body,
  .body > .section .section-list,
  .body > .section .visit-wrap {
    grid-column: 2;
    width: 100%;
    max-width: 560px;
    margin: 0;
  }

  .section-heading {
    font-size: 26px;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--color-title);
    text-wrap: balance;
  }

  .headline {
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-body);
    max-width: 52ch;
  }

  .section-list {
    display: block;
    padding-left: 0;
    list-style: none;
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
  }

  .section-list {
    margin-block: 4px;
  }

  .section-list li {
    position: relative;
    margin-bottom: 10px;
  }

  .section-list li:last-child {
    margin-bottom: 0;
  }

  .section-list li::before {
    content: '';
    position: absolute;
    left: -16px;
    top: 0.78em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-muted);
  }

  .results {
    display: grid;
    gap: 20px;
    margin-top: 8px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .results.n1 { grid-template-columns: minmax(0, 1fr); }
  .results.n2, .results.n4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .results.n5, .results.n6 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  @media (max-width: 640px) {
    .results,
    .results.n2, .results.n4,
    .results.n5, .results.n6 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .resultados {
    margin-top: 40px;
  }

  .header-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 0;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-wash);
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), border-color 0.2s ease, background 0.2s ease;
  }

  @media (hover: hover) {
    .result:hover {
      transform: translateY(-2px);
      border-color: var(--color-title);
      background: var(--color-bg);
    }
  }

  .result-value {
    font-size: 38px;
    line-height: 1.1;
    letter-spacing: -0.045em;
    color: var(--color-title);
  }

  .result-label {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: 1.45;
  }

  .section-body {
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-pill-bg);
    color: var(--color-muted);
    font-size: var(--font-size-small);
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.6;
  }

  .image-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: var(--block-gap);
    grid-column: 1 / -1;
  }

  @media (max-width: 700px) {
    .image-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .image-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .image-detail {
    max-width: 420px;
    margin-inline: auto;
  }

  .image-caption {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: var(--line-height-body);
    max-width: 60ch;
    margin: 0 auto;
    text-align: center;
  }

  .image-frame {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    cursor: zoom-in;
  }

  .image-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .visit-wrap {
    margin-top: 4px;
  }

  .visit-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--font-size-body);
    color: var(--color-title);
  }
  @media (hover: hover) {
    .visit-link:hover {
      text-decoration: underline;
    }
  }
  .visit-link svg { opacity: 0.4; }

  /* Project footer */
  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: var(--section-gap);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .footer-project {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }

  .footer-project-cover {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    aspect-ratio: 16/9;
  }

  .footer-project-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.15s;
  }

  @media (hover: hover) {
    .footer-project:hover .footer-project-cover img {
      opacity: 0.8;
    }
  }

  .footer-project-title {
    font-size: var(--font-size-body);
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  /* Sozinho num rodapé largo, alinhado à direita a seta aponta pro lado que a
     pessoa vai. Na home ele fica à esquerda porque segue o ritmo da lista */
  .footer-links {
    display: flex;
    justify-content: flex-end;
  }

  .home-link {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  @media (hover: hover) {
    .home-link:hover {
      color: var(--color-title);
    }
  }

  @media (max-width: 900px) {
    .body {
      gap: var(--section-gap);
    }

    .body > .section {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .body > .section .section-label,
    .body > .section .section-heading,
    .body > .section .section-body,
    .body > .section .section-list,
    .body > .section .visit-wrap {
      width: 100%;
      max-width: var(--prose-max-width);
      margin-inline: 0;
    }

  }

  @media (max-width: 640px) {
    .page {
      gap: 40px;
    }

    .header {
      gap: 24px;
    }

    .headline {
      font-size: 18px;
    }

    .body {
      gap: 48px;
    }

    .section-heading {
      font-size: 23px;
    }

    .results {
      margin-top: 8px;
    }

    .result {
      padding: 16px 12px;
    }

    .result-value {
      font-size: 31px;
    }
  }
</style>
