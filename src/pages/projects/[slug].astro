---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import TechStack from '../../components/TechStack.astro';
import { allProjects, toImage } from '../../data/projects';

export function getStaticPaths() {
  return Object.keys(allProjects).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = allProjects[slug as keyof typeof allProjects];
const projectEntries = Object.entries(allProjects);
const currentIndex = projectEntries.findIndex(([s]) => s === slug);
const prevProject = projectEntries[(currentIndex - 1 + projectEntries.length) % projectEntries.length];
const nextProject = projectEntries[(currentIndex + 1) % projectEntries.length];
const otherProjects = [prevProject, nextProject];
---

<SiteLayout image={project.cover} title={project.title + " — Miguel Moraes"} description={project.description}>
  <div class="page">

    <nav class="nav">
      <a href="/projects" class="back">← Todos os projetos</a>
    </nav>

    <header class="header">
      <div class="header-main">
        <h1 class="title">{project.title}</h1>
        {(project.headline || project.description) && <p class="headline">{project.headline || project.description}</p>}
      </div>

      <div class="meta-grid">
        <div class="meta-col">
          <span class="meta-label">Função</span>
          <span class="meta-value">{project.role || project.category}</span>
        </div>
        <div class="meta-col">
          <span class="meta-label">Ano</span>
          <span class="meta-value">{project.year}</span>
        </div>
        <div class="meta-col">
          <span class="meta-label">Localização</span>
          <span class="meta-value">{project.location}</span>
        </div>
        {project.industry && (
          <div class="meta-col">
            <span class="meta-label">Setor</span>
            <span class="meta-value">{project.industry}</span>
          </div>
        )}
      </div>

      {project.stack && project.stack.length > 0 && (
        <div class="header-stack">
          <span class="meta-label">Ferramentas</span>
          <TechStack stack={project.stack} />
        </div>
      )}
    </header>

    <div class={"cover" + (project.coverVideo ? " cover-video" : "")} style={project.coverVideo ? "--cover-poster: url(" + project.cover + ")" : undefined}>
      {project.coverVideo ? (
        <video
          src={project.coverVideo}
          poster={project.cover}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={project.title}
          style={"view-transition-name: project-image-" + slug}
        />
      ) : (
        <button type="button" class="cover-image lightbox-trigger" aria-label={"Ampliar imagem: " + project.title}>
          <img src={project.cover} alt={project.title} width="1200" height="675" loading="eager" fetchpriority="high" style={"view-transition-name: project-image-" + slug} />
        </button>
      )}
    </div>

    <div class="body">

      {project.sections.map((section) => (
        <section class="section">
          <span class="section-label">{section.label}</span>
          {section.heading && <h2 class="section-heading">{section.heading}</h2>}
          {section.body.map((bloco) => (
            bloco.type === 'list'
              ? <ul class="section-list">{bloco.items.map((item) => <li set:html={item} />)}</ul>
              : <p class="section-body" set:html={bloco.html} />
          ))}
          <div class="image-grid">
            {section.images.map((img, i) => {
              const { src, caption } = toImage(img);
              const isDetail = src.includes("atlas-juridico-04-documentos");
              return (
                <figure class:list={["image-item", { "image-detail": isDetail }]}>
                  <button type="button" class="image-frame lightbox-trigger" aria-label={"Ampliar imagem: " + (caption || project.title + ", imagem " + (i + 1))} data-caption={caption}>
                    <img src={src} alt={caption || project.title + ": " + (section.heading || section.label) + ", imagem " + (i + 1)} loading="lazy" width={slug === 'atlas-juridico' ? 2160 : 800} height={slug === 'atlas-juridico' ? 2700 : 600} />
                  </button>
                  {caption && <figcaption class="image-caption">{caption}</figcaption>}
                </figure>
              );
            })}
          </div>
        </section>
      ))}

      {project.results && (
        <section class="section resultados">
          <span class="section-label">Em números</span>
          <div class={"results n" + project.results.length}>
            {project.results.map((r) => (
              <div class="result">
                <span class="result-value">{r.value}</span>
                <span class="result-label">{r.label}</span>
              </div>
            ))}
          </div>
        </section>
      )}

    </div>

    <footer class="project-footer">
      <span class="section-label">Outros projetos</span>
      <div class="footer-projects">
        {otherProjects.map(([s, p]) => (
          <a href={"/projects/" + s} class="footer-project">
            <div class="footer-project-cover">
              <img src={p.cover} alt={p.title} loading="lazy" width="400" height="225" />
            </div>
            <span class="footer-project-title">{p.title}</span>
          </a>
        ))}
      </div>
    </footer>

  </div>
</SiteLayout>

<Lightbox />

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .nav { margin-bottom: 0; }

  .back {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  @media (hover: hover) {
    .back:hover {
      color: var(--color-title);
    }
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .header-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 20px;
  }

  .meta-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-label {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .meta-value {
    font-size: var(--font-size-small);
    color: var(--color-title);
    font-weight: 400;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .title {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.04;
    color: var(--color-title);
    text-wrap: balance;
  }

  .cover {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
  }

  .cover-video {
    aspect-ratio: 16/9;
  }

  .cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .cover-image {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .cover-image:focus-visible {
    outline-offset: -4px;
  }

  .cover video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Vídeo no topo é ambiente, não conteúdo: quem pediu menos movimento no
     sistema fica com o pôster, que é a própria capa */
  @media (prefers-reduced-motion: reduce) {
    .cover video {
      display: none;
    }
    .cover-video {
      background-image: var(--cover-poster);
      background-size: cover;
      background-position: center;
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .body > .section {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    column-gap: 48px;
    row-gap: 16px;
  }

  .section-label {
    font-size: var(--font-size-small);
    font-weight: 400;
    color: var(--color-muted);
  }

  .body > .section .section-label {
    grid-column: 1;
    grid-row: 1;
    padding-top: 6px;
  }

  .body > .section .section-heading,
  .body > .section .section-body,
  .body > .section .section-list,
  .body > .section .visit-wrap {
    grid-column: 2;
    width: 100%;
    max-width: 560px;
    margin: 0;
  }

  .section-heading {
    font-size: 26px;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--color-title);
    text-wrap: balance;
  }

  .headline {
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-body);
    max-width: 52ch;
  }

  .section-list {
    display: block;
    padding-left: 20px;
    list-style: none;
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
    margin-block: 4px;
  }

  .section-list li {
    position: relative;
    margin-bottom: 10px;
  }

  .section-list li:last-child {
    margin-bottom: 0;
  }

  .section-list li::before {
    content: '';
    position: absolute;
    left: -16px;
    top: 0.78em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-muted);
  }

  .body > .section.resultados {
    margin-top: 0;
  }

  .body > .section .results {
    grid-column: 2;
    width: 100%;
    max-width: 560px;
    margin: 0;
  }

  .results {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .results.n1 { grid-template-columns: minmax(0, 1fr); }
  .results.n2, .results.n4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .results.n3, .results.n5, .results.n6 { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .header-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 0;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
  }

  .result-value {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-title);
  }

  .result-label {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: 1.4;
  }

  .section-body {
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
  }

  .section-body a,
  .section-list a {
    color: var(--color-title);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (hover: hover) {
    .section-body a:hover,
    .section-list a:hover {
      opacity: 0.7;
    }
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-pill-bg);
    color: var(--color-muted);
    font-size: var(--font-size-small);
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.6;
  }

  .image-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: var(--block-gap);
    grid-column: 1 / -1;
  }

  @media (max-width: 700px) {
    .image-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .image-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .image-detail {
    max-width: 420px;
    margin-inline: auto;
  }

  .image-caption {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: var(--line-height-body);
    max-width: 60ch;
    margin: 0 auto;
    text-align: center;
  }

  .image-frame {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    cursor: zoom-in;
  }

  .image-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Project footer */
  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 32px;
    padding-bottom: 24px;
  }

  .footer-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .footer-project {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }

  .footer-project-cover {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    aspect-ratio: 16/9;
  }

  .footer-project-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.15s;
  }

  @media (hover: hover) {
    .footer-project:hover .footer-project-cover img {
      opacity: 0.8;
    }
  }

  .footer-project-title {
    font-size: var(--font-size-body);
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  @media (max-width: 900px) {
    .body {
      gap: var(--section-gap);
    }

    .body > .section {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .body > .section .section-label,
    .body > .section .section-heading,
    .body > .section .section-body,
    .body > .section .section-list,
    .body > .section .results {
      width: 100%;
      max-width: var(--prose-max-width);
      margin-inline: 0;
    }
  }

  @media (max-width: 640px) {
    .page {
      gap: 40px;
    }

    .header {
      gap: 24px;
    }

    .headline {
      font-size: 18px;
    }

    .body {
      gap: 48px;
    }

    .section-heading {
      font-size: 23px;
    }

    .results.n2, .results.n3, .results.n4, .results.n5, .results.n6 {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .footer-projects {
      grid-template-columns: 1fr;
    }
  }
</style>
