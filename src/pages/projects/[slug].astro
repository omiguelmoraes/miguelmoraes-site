---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { allProjects } from '../../data/projects';

export function getStaticPaths() {
  return Object.keys(allProjects).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = allProjects[slug as keyof typeof allProjects];
const projectEntries = Object.entries(allProjects);
const currentIndex = projectEntries.findIndex(([s]) => s === slug);
const prevProject = projectEntries[(currentIndex - 1 + projectEntries.length) % projectEntries.length];
const nextProject = projectEntries[(currentIndex + 1) % projectEntries.length];
const otherProjects = [prevProject, nextProject];
---

<SiteLayout image={project.cover} title={project.title + " — Miguel Moraes"} description={project.description}>
  <div class="page">

    <nav class="nav">
      <a href="/projects" class="back">← All projects</a>
    </nav>

    <header class="header">
      <div class="meta">
        <span class="meta-item">{project.year}</span>
        <span class="meta-sep">·</span>
        <span class="meta-item">{project.location}</span>
        {project.industry && (
          <>
            <span class="meta-sep">·</span>
            <span class="meta-item">{project.industry}</span>
          </>
        )}
      </div>
      <h1 class="title">{project.title}</h1>
      <div class="tags">
        {project.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="cover">
      <img src={project.cover} alt={project.title} class="lightbox-trigger" width="1200" height="675" style={"view-transition-name: project-image-" + slug} />
    </div>

    <main class="body">

      <section class="section">
        <span class="section-label">Challenge</span>
        <h2 class="section-heading">{project.challenge.heading}</h2>
        <p class="section-body">{project.challenge.body}</p>
        <div class="image-grid">
          {project.challenge.images.map((src, i) => (
            <div class="image-frame">
              <img src={src} alt={project.title + ": " + project.challenge.heading + ", image " + (i + 1)} class="lightbox-trigger" loading="lazy" width="800" height="600" />
            </div>
          ))}
        </div>
      </section>

      <section class="section">
        <span class="section-label">Result</span>
        <h2 class="section-heading">{project.result.heading}</h2>
        <p class="section-body">{project.result.body}</p>
        {(('url' in project && project.url) || ('figmaUrl' in project && project.figmaUrl)) && (
          <a href={('url' in project && project.url) ? project.url : (project as any).figmaUrl} target="_blank" rel="noopener" class="visit-link">
            View project
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
          </a>
        )}
        <div class="image-grid">
          {project.result.images.map((src, i) => (
            <div class="image-frame">
              <img src={src} alt={project.title + ": " + project.result.heading + ", image " + (i + 1)} class="lightbox-trigger" loading="lazy" width="800" height="600" />
            </div>
          ))}
        </div>
      </section>

    </main>

    <footer class="project-footer">
      <div class="footer-top">
        <span class="section-label">More projects</span>
        <div class="footer-projects">
          {otherProjects.map(([s, p]) => (
            <a href={"/projects/" + s} class="footer-project">
              <div class="footer-project-cover">
                <img src={p.cover} alt={p.title} loading="lazy" width="400" height="225" />
              </div>
              <span class="footer-project-title">{p.title}</span>
            </a>
          ))}
        </div>
      </div>
      <div class="footer-links">
        <a href="/projects" class="home-link">See all projects →</a>
      </div>
    </footer>

  </div>
</SiteLayout>

<Lightbox />

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .nav { margin-bottom: 0; }

  .back {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--color-title); }

  .header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .meta-item {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: var(--line-height-body);
  }

  .meta-sep {
    font-size: var(--font-size-small);
    color: var(--color-muted);
  }

  .title {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-title);
  }

  .cover {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    aspect-ratio: 16/9;
    cursor: zoom-in;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .section-label {
    font-size: var(--font-size-small);
    font-weight: 400;
    color: var(--color-muted);
  }

  .section-heading {
    font-size: 20px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-title);
  }

  .section-body {
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
    max-width: 60ch;
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-pill-bg);
    color: var(--color-muted);
    font-size: var(--font-size-small);
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.6;
  }

  /* Full-width é o padrão: imagem de projeto vale pelo detalhe, e meia largura
     desperdiça isso. No máximo a primeira linha vai em duas colunas */
  .image-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
    align-items: start;
  }

  .image-grid > .image-frame:nth-child(n + 3) {
    grid-column: 1 / -1;
  }

  .image-grid > .image-frame:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  @media (max-width: 700px) {
    .image-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .image-frame {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    cursor: zoom-in;
  }

  .image-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .visit-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--font-size-body);
    color: var(--color-title);
  }
  .visit-link:hover { text-decoration: underline; }
  .visit-link svg { opacity: 0.4; }

  /* Project footer */
  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: var(--section-gap);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .footer-project {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }

  .footer-project-cover {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    aspect-ratio: 16/9;
  }

  .footer-project-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.15s;
  }

  .footer-project:hover .footer-project-cover img { opacity: 0.8; }

  .footer-project-title {
    font-size: var(--font-size-body);
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  /* Sozinho num rodapé largo, alinhado à direita a seta aponta pro lado que a
     pessoa vai. Na home ele fica à esquerda porque segue o ritmo da lista */
  .footer-links {
    display: flex;
    justify-content: flex-end;
  }

  .home-link {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  .home-link:hover { color: var(--color-title); }
</style>
