---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import TechStack from '../../components/TechStack.astro';
import { allProjects, toImage } from '../../data/projects';

export function getStaticPaths() {
  return Object.keys(allProjects).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = allProjects[slug as keyof typeof allProjects];
const projectEntries = Object.entries(allProjects);
const currentIndex = projectEntries.findIndex(([s]) => s === slug);
const prevProject = projectEntries[(currentIndex - 1 + projectEntries.length) % projectEntries.length];
const nextProject = projectEntries[(currentIndex + 1) % projectEntries.length];
const otherProjects = [prevProject, nextProject];
---

<SiteLayout image={project.cover} title={project.title + " — Miguel Moraes"} description={project.description}>
  <div class="page">

    <nav class="nav">
      <a href="/projects" class="back">← All projects</a>
    </nav>

    <header class="header">
      <div class="header-main">
        <h1 class="title">{project.title}</h1>
        {project.description && <p class="description">{project.description}</p>}
      </div>

      <div class="meta-grid">
        <div class="meta-col">
          <span class="meta-label">Role</span>
          <span class="meta-value">{project.role || project.category}</span>
        </div>
        <div class="meta-col">
          <span class="meta-label">Year</span>
          <span class="meta-value">{project.year}</span>
        </div>
        <div class="meta-col">
          <span class="meta-label">Location</span>
          <span class="meta-value">{project.location}</span>
        </div>
        {project.industry && (
          <div class="meta-col">
            <span class="meta-label">Industry</span>
            <span class="meta-value">{project.industry}</span>
          </div>
        )}
      </div>
    </header>

    <div class="cover">
      <img src={project.cover} alt={project.title} class="lightbox-trigger" width="1200" height="675" style={"view-transition-name: project-image-" + slug} />
    </div>

    <main class="body">

      {project.sections.map((section, si) => (
        <section class="section">
          <span class="section-label">{section.label}</span>
          {section.heading && <h2 class="section-heading">{section.heading}</h2>}
          {section.body.map((bloco) => (
            bloco.type === 'list'
              ? <ul class="section-list">{bloco.items.map((item) => <li set:html={item} />)}</ul>
              : <p class="section-body" set:html={bloco.html} />
          ))}
          {si === project.sections.length - 1 && project.url && (
            <a href={project.url} target="_blank" rel="noopener" class="visit-link">
              View project
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
            </a>
          )}
          <div class="image-grid">
            {section.images.map((img, i) => {
              const { src, caption } = toImage(img);
              return (
                <figure class="image-item">
                  <div class="image-frame">
                    <img src={src} alt={caption || project.title + ": " + (section.heading || section.label) + ", image " + (i + 1)} data-caption={caption} class="lightbox-trigger" loading="lazy" width="800" height="600" />
                  </div>
                  {caption && <figcaption class="image-caption">{caption}</figcaption>}
                </figure>
              );
            })}
          </div>
        </section>
      ))}

      {(project.stack?.length > 0 || project.credits?.length > 0 || project.url || project.figmaUrl) && (
        <section class="section project-details-section">
          <span class="section-label">Overview & Credits</span>
          <div class="details-grid">
            {project.stack && project.stack.length > 0 && (
              <div class="details-col">
                <span class="details-label">Tools & Stack</span>
                <TechStack stack={project.stack} />
              </div>
            )}

            {project.credits && project.credits.length > 0 && (
              <div class="details-col">
                <span class="details-label">Credits</span>
                <ul class="credits-list">
                  {project.credits.map((c) => (
                    <li class="credit-item">
                      <span class="credit-role">{c.role}:</span>
                      {c.url ? (
                        <a href={c.url} target="_blank" rel="noopener" class="credit-name credit-link">{c.name} ↗</a>
                      ) : (
                        <span class="credit-name">{c.name}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {(project.url || project.figmaUrl) && (
              <div class="details-col">
                <span class="details-label">Links</span>
                <div class="details-links">
                  {project.url && (
                    <a href={project.url} target="_blank" rel="noopener" class="visit-link">
                      Live Project
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                    </a>
                  )}
                  {project.figmaUrl && (
                    <a href={project.figmaUrl} target="_blank" rel="noopener" class="visit-link">
                      Figma Prototype
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      {project.results && (
        <section class="section">
          <span class="section-label">In numbers</span>
          <div class="results">
            {project.results.map((r) => (
              <div class="result">
                <span class="result-value">{r.value}</span>
                <span class="result-label">{r.label}</span>
              </div>
            ))}
          </div>
        </section>
      )}

    </main>

    <footer class="project-footer">
      <div class="footer-top">
        <span class="section-label">More projects</span>
        <div class="footer-projects">
          {otherProjects.map(([s, p]) => (
            <a href={"/projects/" + s} class="footer-project">
              <div class="footer-project-cover">
                <img src={p.cover} alt={p.title} loading="lazy" width="400" height="225" />
              </div>
              <span class="footer-project-title">{p.title}</span>
            </a>
          ))}
        </div>
      </div>
      <div class="footer-links">
        <a href="/projects" class="home-link">See all projects →</a>
      </div>
    </footer>

  </div>
</SiteLayout>

<Lightbox />

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .nav { margin-bottom: 0; }

  .back {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  @media (hover: hover) {
    .back:hover {
      color: var(--color-title);
    }
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .header-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .description {
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
    max-width: 60ch;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 20px;
    margin-top: 4px;
  }

  .meta-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-label {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .meta-value {
    font-size: var(--font-size-small);
    color: var(--color-title);
    font-weight: 400;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .title {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-title);
  }

  .cover {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    aspect-ratio: 16/9;
    cursor: zoom-in;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .section-label {
    font-size: var(--font-size-small);
    font-weight: 400;
    color: var(--color-muted);
  }

  .section-heading {
    font-size: 20px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-title);
  }

  .headline {
    font-size: 20px;
    line-height: 1.45;
    color: var(--color-body);
    max-width: 46ch;
    margin-top: 4px;
  }

  .section-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 20px;
    max-width: 60ch;
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
  }

  .section-list li::marker { color: var(--color-muted); }

  .results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 8px;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-wash);
  }

  .result-value {
    font-size: 34px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-title);
  }

  .result-label {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: 1.45;
  }

  .section-body {
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
    max-width: 60ch;
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-pill-bg);
    color: var(--color-muted);
    font-size: var(--font-size-small);
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.6;
  }

  /* Largura total em tudo: imagem de projeto vale pelo detalhe, e meia largura
     desperdiça isso. Duas colunas volta como exceção marcada, se algum par de
     imagens pedir */
  .image-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: 20px;
  }

  @media (max-width: 700px) {
    .image-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .image-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  /* Centralizada: a foto ocupa a coluna inteira, então a legenda alinhada ao
     centro dela se lê como legenda, e não como mais uma linha de texto corrido */
  .image-caption {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: var(--line-height-body);
    max-width: 60ch;
    margin: 0 auto;
    text-align: center;
  }

  .image-frame {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    cursor: zoom-in;
  }

  .image-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .visit-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--font-size-body);
    color: var(--color-title);
  }
  @media (hover: hover) {
    .visit-link:hover {
      text-decoration: underline;
    }
  }
  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px 32px;
    margin-top: 8px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-wash);
  }

  .details-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .details-label {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .credits-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .credit-item {
    font-size: var(--font-size-small);
    line-height: 1.4;
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .credit-role {
    color: var(--color-muted);
  }

  .credit-name {
    color: var(--color-title);
  }

  .credit-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .details-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Project footer */
  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: var(--section-gap);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .footer-project {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }

  .footer-project-cover {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-wash);
    aspect-ratio: 16/9;
  }

  .footer-project-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.15s;
  }

  @media (hover: hover) {
    .footer-project:hover .footer-project-cover img {
      opacity: 0.8;
    }
  }

  .footer-project-title {
    font-size: var(--font-size-body);
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  /* Sozinho num rodapé largo, alinhado à direita a seta aponta pro lado que a
     pessoa vai. Na home ele fica à esquerda porque segue o ritmo da lista */
  .footer-links {
    display: flex;
    justify-content: flex-end;
  }

  .home-link {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  @media (hover: hover) {
    .home-link:hover {
      color: var(--color-title);
    }
  }
</style>
