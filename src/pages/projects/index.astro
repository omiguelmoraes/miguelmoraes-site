---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Filters from '../../components/Filters.astro';
import { allProjects } from '../../data/projects';

const filterTags = ['Branding', 'Web Design', 'UI/UX'];
const tagCounts: Record<string, number> = Object.fromEntries(
  filterTags.map(tag => [tag, Object.values(allProjects).filter(p => p.tags.includes(tag)).length])
);
const totalCount = Object.values(allProjects).length;
---

<SiteLayout title="Projects — Miguel Moraes" description="Selected work in web design, UI/UX and front-end.">
  <div class="page">

    <header class="page-header">
      <h1 class="page-title">Projects</h1>
      <p class="page-intro">Selected work in web design, UI/UX and front-end.</p>
    </header>

    <Filters
      allCount={totalCount}
      options={filterTags.map(tag => ({ label: tag, value: tag, count: tagCounts[tag] }))}
    />

    <div class="grid">
      {Object.entries(allProjects).map(([slug, project]) => (
        <a href={`/projects/${slug}`} class="card" data-tags={project.tags.join(',')}>
          <div class="card-image">
            <img src={project.cover} alt={project.title} width="480" height="360" loading="lazy" style={project.coverPosition ? `object-position: ${project.coverPosition}` : undefined} />
          </div>
          <div class="card-content">
            <span class="card-meta">{project.year} · {project.location.split(', ').at(-1)}</span>
            <span class="card-title">{project.title}</span>
            <p class="card-summary">{project.challenge.heading}</p>
            <div class="card-tags">
              {project.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="empty-state" id="empty-state" hidden>
      <p>Coming soon.</p>
    </div>

  </div>
</SiteLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--block-gap);
  }

  .back {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--color-title); }





  .empty-state {
    padding: 64px 0;
    text-align: center;
    color: var(--color-muted);
    font-size: var(--font-size-body);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .card:hover {
    opacity: 0.92;
  }

  .card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-wash);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .card:hover .card-image img {
    transform: scale(1.02);
  }

  .card-content {
    padding: 14px 2px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .card-meta {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: 1.4;
  }

  .card-title {
    font-size: var(--font-size-body);
    font-weight: 400;
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  .card-summary {
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .tag {
    background: var(--color-pill-bg);
    color: var(--color-muted);
    font-size: var(--font-size-small);
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }

</style>
