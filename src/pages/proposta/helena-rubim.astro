---
// Proposta individual. Página de link privado: sem navegação e fora do sitemap,
// a única saída é o WhatsApp. Tema travado em claro igual à /trabalhe-comigo,
// porque é peça pra ser aberta no celular do cliente e não segue o dark mode.
import BaseLayout from '../../layouts/BaseLayout.astro';

const cliente = 'Studio Pilates Helena Rubim';
const validade = '21 de setembro';

const entrega = [
  'Site completo do studio, rápido no celular',
  'Planos, com o que está incluso em cada um',
  'Grade de horários, que você mesma atualiza',
  'Aula experimental com pagamento na própria página',
  'Suas 46 avaliações aparecendo no site',
  'Botão de WhatsApp em todas as seções',
  'Seu perfil do Google conectado ao site',
  'Endereço, mapa e como chegar',
  'Preparado pra aparecer em quem busca pilates no bairro',
  'Domínio no seu nome, por um ano',
  'Hospedagem por um ano',
  'Certificado de segurança, sem custo extra',
];

const etapas = [
  { n: '01', t: 'Conversa de 30 minutos', d: 'Você me conta como funciona o studio. É a única reunião.' },
  { n: '02', t: 'Primeira versão em 7 dias', d: 'Você abre o link e me diz o que quer mudar.' },
  { n: '03', t: 'Ajustes e publicação', d: 'Faço os ajustes e coloco no ar. Cerca de 15 dias no total.' },
];
---

<BaseLayout
  title={`Proposta — ${cliente}`}
  description="Proposta de site para o Studio Pilates Helena Rubim."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
<div class="pp">

  <header class="topo">
    <div class="wrap">
      <div class="me">
        <img src="/webp/avatar.webp" alt="Miguel Moraes" width="34" height="34" />
        <div>
          <strong>Miguel Moraes</strong>
          <span>Design e desenvolvimento de sites</span>
        </div>
      </div>
      <p class="para">Proposta para</p>
      <h1>{cliente}</h1>
      <p class="sub">
        Você tem 5 estrelas com 46 avaliações e nenhum site. Hoje essa reputação
        só aparece pra quem já procura o studio pelo nome.
      </p>
    </div>
  </header>

  <section class="sec">
    <div class="wrap">
      <h2>O que muda</h2>
      <div class="muda">
        <div class="card">
          <p class="rot">Hoje</p>
          <p>A pessoa vê o studio no Instagram e te manda mensagem perguntando o preço. Você responde uma por uma, e boa parte não volta.</p>
        </div>
        <div class="card destaque">
          <p class="rot">Com o site</p>
          <p>A pessoa acha o studio no Google, vê plano e horário sozinha, paga a aula experimental e só então te chama. Já decidida.</p>
        </div>
      </div>
      <p class="nota">
        É o mesmo filtro que você já começou quando passou a cobrar a experimental,
        agora funcionando sem você.
      </p>
    </div>
  </section>

  <section class="sec wash">
    <div class="wrap">
      <h2>O que está incluso</h2>
      <ul class="lista">
        {entrega.map((item) => <li>{item}</li>)}
      </ul>
      <p class="nota">Tudo junto. Você não precisa contratar nada por fora.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2>Como funciona</h2>
      <div class="etapas">
        {etapas.map((e) => (
          <div class="etapa">
            <span class="n">{e.n}</span>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec wash precos">
    <div class="wrap">
      <h2>Investimento</h2>
      <p class="sub-sec">Duas formas de fazer. O site é o mesmo nos dois casos.</p>
      <div class="planos">
        <div class="plano">
          <p class="rot">Você assume depois</p>
          <p class="valor">R$ 1.800</p>
          <p class="cond">À vista ou em até 3x sem juros</p>
          <ul>
            <li>Tudo da lista acima</li>
            <li>Domínio e hospedagem no seu nome</li>
            <li>Senhas e acessos entregues a você</li>
            <li>30 dias de ajustes inclusos</li>
          </ul>
          <p class="obs">Depois do primeiro ano a renovação fica por sua conta, perto de R$ 60 por ano.</p>
        </div>
        <div class="plano recomendado">
          <span class="tag">Mais tranquilo</span>
          <p class="rot">Eu cuido de tudo</p>
          <p class="valor">R$ 1.400 <span class="mais">+ R$ 99/mês</span></p>
          <p class="cond">À vista ou em até 3x sem juros</p>
          <ul>
            <li>Tudo da lista acima</li>
            <li>Renovação de domínio e hospedagem por minha conta</li>
            <li>Mudança de horário, plano ou preço é só me mandar</li>
            <li>Acompanhamento de quanta gente chega pelo site</li>
          </ul>
          <p class="obs">Sem fidelidade. Você cancela quando quiser e leva o site.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sobre">
    <div class="wrap">
      <h2>Quem faz</h2>
      <div class="sobre-eu">
        <img src="/webp/avatar.webp" alt="Miguel Moraes" width="56" height="56" loading="lazy" />
        <div>
          <strong>Miguel Moraes</strong>
          <span>Designer · Porto Alegre</span>
        </div>
      </div>
      <p class="sobre-txt">
        Faço tudo pessoalmente, do desenho à publicação, e sigo por perto
        depois que o site entra no ar.
      </p>
      <a class="ig" href="https://www.instagram.com/omiguelmoraes" target="_blank" rel="noreferrer">
        Ver meu trabalho no Instagram
      </a>
    </div>
  </section>

  <section class="sec fecho">
    <div class="wrap">
      <h2>Pra começar</h2>
      <p>Me diz no WhatsApp qual das duas formas faz mais sentido pra você.</p>
      <a class="btn" href="https://wa.me/5551998734305?text=Oi%20Miguel%2C%20vi%20a%20proposta" target="_blank" rel="noreferrer">Falar no WhatsApp</a>
      <p class="micro">Proposta válida até {validade}</p>
    </div>
  </section>

</div>
</BaseLayout>

<style is:global>
  /* Peça pra abrir no celular do cliente, não acompanha o dark mode do sistema */
  html, body { background: #ffffff !important; color-scheme: light; }
</style>

<style>
  .pp {
    --ink: #111111;
    --body: #4a4a4a;
    --dim: #888888;
    --line: #e2e2e2;
    --bg: #ffffff;
    --wash: #f7f7f7;
    --maxw: 760px;

    background: var(--bg);
    color: var(--body);
    font-size: 16px;
    line-height: 1.6;
  }
  .pp h1, .pp h2, .pp h3 {
    color: var(--ink);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
    margin: 0;
  }
  .pp p { text-wrap: pretty; }
  .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }

  .topo { padding: 56px 0 44px; border-bottom: 1px solid var(--line); }
  .me { display: flex; align-items: center; gap: 11px; margin-bottom: 38px; }
  .me img { border-radius: 50%; }
  .me div { display: flex; flex-direction: column; line-height: 1.3; }
  .me strong { color: var(--ink); font-weight: 500; font-size: 15px; }
  .me span { color: var(--dim); font-size: 13px; }
  .para { color: var(--dim); font-size: 13px; text-transform: uppercase; letter-spacing: .08em; margin: 0 0 8px; }
  .topo h1 { font-size: clamp(28px, 6vw, 40px); }
  .topo .sub { margin: 20px 0 0; font-size: 17px; }

  .sec { padding: 56px 0; border-bottom: 1px solid var(--line); }
  .sec.wash { background: var(--wash); border-bottom-color: transparent; }
  .sec h2 { font-size: clamp(21px, 4vw, 26px); margin-bottom: 26px; }
  .sub-sec { margin: -14px 0 24px; color: var(--dim); }
  .nota { margin: 20px 0 0; color: var(--dim); font-size: 14.5px; }

  .muda { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
  .card { background: var(--wash); border-radius: 12px; padding: 20px; }
  .card.destaque { background: var(--ink); color: #e9e9e9; }
  .card p:last-child { margin: 0; }
  .rot { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--dim); margin: 0 0 10px; }
  .card.destaque .rot { color: #9a9a9a; }

  .lista { list-style: none; padding: 0; margin: 0; display: grid; gap: 11px; }
  .lista li { position: relative; padding-left: 26px; }
  .lista li::before {
    content: ""; position: absolute; left: 2px; top: 9px; width: 9px; height: 5px;
    border-left: 1.8px solid var(--ink); border-bottom: 1.8px solid var(--ink);
    transform: rotate(-45deg);
  }

  .etapas { display: grid; gap: 22px; grid-template-columns: repeat(3, 1fr); }
  .etapa .n { font-size: 12px; color: var(--dim); letter-spacing: .08em; }
  .etapa h3 { font-size: 16px; margin: 8px 0 6px; }
  .etapa p { margin: 0; font-size: 14.5px; }

  .planos { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
  .plano { background: var(--bg); border: 1px solid var(--line); border-radius: 14px; padding: 24px; position: relative; }
  .plano.recomendado { border-color: var(--ink); }
  .tag {
    position: absolute; top: -10px; left: 24px; background: var(--ink); color: #fff;
    font-size: 11px; padding: 3px 10px; border-radius: 20px; letter-spacing: .02em;
  }
  .valor { color: var(--ink); font-size: 30px; font-weight: 500; letter-spacing: -0.03em; margin: 6px 0 4px; }
  .valor .mais { font-size: 15px; color: var(--body); font-weight: 400; letter-spacing: 0; }
  .cond { font-size: 13.5px; color: var(--dim); margin: 0 0 18px; }
  .plano ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; font-size: 14.5px; }
  .plano ul li { position: relative; padding-left: 16px; }
  .plano ul li::before { content: "·"; position: absolute; left: 4px; color: var(--dim); }
  .obs { margin: 18px 0 0; font-size: 13px; color: var(--dim); }

  .sobre-eu { display: flex; align-items: center; gap: 13px; margin-bottom: 18px; }
  .sobre-eu img { border-radius: 50%; flex-shrink: 0; }
  .sobre-eu div { display: flex; flex-direction: column; line-height: 1.35; }
  .sobre-eu strong { color: var(--ink); font-weight: 500; font-size: 16px; }
  .sobre-eu span { color: var(--dim); font-size: 13.5px; }
  .sobre-txt { margin: 0 0 22px; max-width: 440px; }
  .ig {
    display: inline-block; border: 1px solid var(--line); border-radius: 8px;
    padding: 11px 20px; color: var(--ink); text-decoration: none; font-size: 14.5px;
  }
  .ig:hover { border-color: var(--ink); }

  .fecho {
    border-bottom: 0; text-align: center; padding: 64px 0 52px;
    background: var(--ink); color: #b8b8b8;
  }
  .fecho h2 { color: #ffffff; }
  .fecho p { max-width: 400px; margin: 0 auto 34px; font-size: 16.5px; }
  .btn {
    display: inline-block; background: #ffffff; color: var(--ink); text-decoration: none;
    padding: 15px 30px; border-radius: 10px; font-size: 15.5px;
  }
  .btn:hover { opacity: .88; }
  .micro { margin: 34px auto 0; font-size: 12.5px; color: #7d7d7d; letter-spacing: .01em; }

  @media (max-width: 720px) {
    .muda, .planos, .etapas { grid-template-columns: 1fr; }
    .sec { padding: 38px 0; }
    .topo { padding: 40px 0 34px; }
    .btn, .ig { display: block; width: 100%; text-align: center; }
    .fecho { padding: 52px 0 44px; }
    .micro { margin-top: 28px; }
  }
</style>
