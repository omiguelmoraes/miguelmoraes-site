---
import SiteLayout from '../layouts/SiteLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import Filters from '../components/Filters.astro';
---

<SiteLayout
  title="Career — Miguel Moraes"
  description="Work experience, education and talks. Designer based in Porto Alegre, Brazil."
>
  <div class="content">

    <header class="page-header">
      <h1 class="page-title">Career</h1>
      <p class="page-intro">
        Where I've worked, what I studied, and the times I've been on a stage or a&nbsp;mic.
      </p>
    </header>

    <Filters
      allCount={11}
      options={[
        { label: 'Work', value: 'work', count: 6 },
        { label: 'Education', value: 'education', count: 3 },
        { label: 'Speaking', value: 'speaking', count: 2 },
      ]}
    />

    <!-- Work -->
    <section class="section" data-tags="work">
      <div class="rows rows--career">

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Web Designer at Barca<span class="logo"><img src="/work/logos/barca.png" alt="Barca" width="24" height="24" loading="lazy" /></span></span>
              <span class="date">2026 — Now</span>
            </div>
            <p class="row-desc">I design and build the websites of three subscription book clubs in Framer, from prototype to live&nbsp;page.</p>
            <span class="acc-cta"><span class="more">View full experience</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">Responsibilities</div>
              <ul class="dd-list">
                <li>Own the launch landing page of each club, from prototype to live site, including the monthly box drop.</li>
                <li>Built a <b>design system per club</b> in Framer, so a new page starts from components instead of a blank canvas.</li>
                <li>Introduced a <b>prototype-first workflow</b> — the page is validated in HTML with the brand's tokens before anyone touches Framer. Adopted by the whole web team.</li>
                <li>Set up <b>Microsoft Clarity</b> across the clubs and turn dead clicks, rage clicks and scroll depth into copy and layout decisions.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Results</div>
              <div class="stats">
                <div class="stat"><b>3</b> brands under my care</div>
                <div class="stat"><b>15</b> pages shipped</div>
                <div class="stat"><b>Monthly</b> launch cadence</div>
              </div>
            </div>
            <div>
              <div class="dd-label">Skills &amp; tools</div>
              <div class="pills"><span class="pill">Framer</span><span class="pill">Design systems</span><span class="pill">Conversion copy</span><span class="pill">Behaviour analytics</span><span class="pill">HTML/CSS</span><span class="pill">Meta Ads</span></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">UX/UI &amp; Marketing Designer at OpServices<span class="logo"><img src="/work/logos/opservices.svg" alt="OpServices" width="24" height="24" loading="lazy" /></span></span>
              <span class="date">2025 — 2026</span>
            </div>
            <p class="row-desc">Marketing design and product UI at a B2B observability company — campaigns, dashboards and a brand&nbsp;refresh.</p>
            <span class="acc-cta"><span class="more">View full experience</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">Responsibilities</div>
              <ul class="dd-list">
                <li>Led the <b>institutional visual refresh</b> — identity, site and sales material — and wrote the guidelines that kept it consistent.</li>
                <li>Designed <b>observability dashboards</b> in Grafana, turning dense monitoring data into something a client could act on.</li>
                <li>Ran the campaign and social output: carousels, launches, trade-show booths and event material.</li>
                <li>Built internal <b>AI tooling for the design team</b>, so recurring pieces stopped being made from scratch.</li>
                <li>Talked about dashboard design with AI on the company podcast.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Results</div>
              <div class="stats">
                <div class="stat"><b>20+</b> interfaces designed</div>
                <div class="stat"><b>1</b> brand refresh led</div>
                <div class="stat"><b>1</b> design system shipped</div>
              </div>
            </div>
            <div>
              <div class="dd-label">Skills &amp; tools</div>
              <div class="pills"><span class="pill">Data viz</span><span class="pill">Grafana</span><span class="pill">Brand systems</span><span class="pill">B2B marketing</span><span class="pill">Figma</span><span class="pill">AI tooling</span></div>
            </div>
            <div class="row-images">
              <div class="row-image"><img src="/work/opservices-1.webp" alt="Design work at OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
              <div class="row-image"><img src="/work/opservices-2.webp" alt="Design work at OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
              <div class="row-image"><img src="/work/opservices-3.webp" alt="Design work at OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Independent Designer<span class="logo"><img src="/work/logos/korbi.svg" alt="Korbi" width="24" height="24" loading="lazy" /></span></span>
              <span class="date">2022 — Now</span>
            </div>
            <p class="row-desc">Visual identity, branding and UX/UI for digital products, now under my own studio,&nbsp;Korbi.</p>
            <span class="acc-cta"><span class="more">View full experience</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">Responsibilities</div>
              <ul class="dd-list">
                <li>Take projects from <b>proposal to launch</b> — scoping, pricing and delivery, solo.</li>
                <li>Build sites in <b>Astro and Framer</b>, including e-commerce flows connected to Shopify.</li>
                <li>Design brand identities and the systems that keep them alive after handoff.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Results</div>
              <div class="stats">
                <div class="stat"><b>50+</b> projects delivered</div>
                <div class="stat"><b>4</b> years running</div>
              </div>
            </div>
            <div>
              <div class="dd-label">Skills &amp; tools</div>
              <div class="pills"><span class="pill">Client management</span><span class="pill">Pricing</span><span class="pill">Astro</span><span class="pill">Branding</span><span class="pill">SEO</span></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">UX/UI Designer at Synapsy Design<span class="logo"><img src="/work/logos/synapsy.png" alt="Synapsy Design" width="24" height="24" loading="lazy" /></span></span>
              <span class="date">2024 — 2025</span>
            </div>
            <p class="row-desc">Wireframes, prototypes and design guidelines for digital products, inside a remote product&nbsp;team.</p>
            <span class="acc-cta"><span class="more">View full experience</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">Responsibilities</div>
              <ul class="dd-list">
                <li>Turned briefs into <b>wireframes and clickable prototypes</b> for client validation.</li>
                <li>Defined <b>design guidelines</b> so different hands produced the same interface.</li>
                <li>Ran <b>market and competitor research</b> to justify interface decisions.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Skills &amp; tools</div>
              <div class="pills"><span class="pill">Prototyping</span><span class="pill">UX research</span><span class="pill">Figma</span><span class="pill">Remote collaboration</span></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Visual &amp; Web Designer at Gama Marketing<span class="logo"><img src="/work/logos/gama.webp" alt="Gama Marketing" width="24" height="24" loading="lazy" /></span></span>
              <span class="date">2023 — 2024</span>
            </div>
            <p class="row-desc">Logos, visual materials and websites for small businesses in the&nbsp;region.</p>
            <span class="acc-cta"><span class="more">View full experience</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">Responsibilities</div>
              <ul class="dd-list">
                <li>Delivered <b>brand identities</b> end to end — logo, system, application.</li>
                <li>Designed and built <b>client websites</b>, from wireframe to live page.</li>
                <li>Spoke at <b>Instituto Caldeira</b> on branding for small businesses.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Results</div>
              <div class="stats">
                <div class="stat"><b>30+</b> identities delivered</div>
                <div class="stat"><b>1</b> talk at Instituto Caldeira</div>
              </div>
            </div>
            <div>
              <div class="dd-label">Skills &amp; tools</div>
              <div class="pills"><span class="pill">Branding</span><span class="pill">Client presentation</span><span class="pill">Illustrator</span><span class="pill">Web design</span></div>
            </div>
            <div class="row-images">
              <div class="row-image"><img src="/work/gama-1.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
              <div class="row-image"><img src="/work/gama-2.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
              <div class="row-image"><img src="/work/gama-3.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Graphic Designer at Agência Blanc<span class="logo"><img src="/work/logos/blanc.svg" alt="Agência Blanc" width="24" height="24" loading="lazy" /></span></span>
              <span class="date">2023</span>
            </div>
            <p class="row-desc">Visual identities and print material for local clients, at agency&nbsp;pace.</p>
            <span class="acc-cta"><span class="more">View full experience</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">Responsibilities</div>
              <ul class="dd-list">
                <li>Produced <b>visual identities and print material</b> under agency deadlines.</li>
                <li>Reorganised the <b>file and asset workflow</b> so work stopped getting lost between hands.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Skills &amp; tools</div>
              <div class="pills"><span class="pill">Illustrator</span><span class="pill">Photoshop</span><span class="pill">Print</span></div>
            </div>
          </div>
        </details>

      </div>
    </section>

    <!-- Education -->
    <section class="section" data-tags="education">
      <h2 class="section-title">Education</h2>
      <p class="section-body">Formal education and the certifications worth mentioning.</p>
      <div class="rows">

        <div class="row">
          <div class="row-head">
            <span class="row-link">Tecnólogo em Análise e Desenvolvimento de Sistemas<span class="logo"><img src="/work/logos/unisinos.png" alt="Unisinos" width="24" height="24" loading="lazy" /></span></span>
            <span class="date">2024 — Now</span>
          </div>
          <span class="row-sub">Unisinos</span>
          <p class="row-desc">Currently studying Systems Analysis and Development, focused on software engineering.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Cambridge English Level 2 Certificate (Advanced)<span class="logo"><img src="/work/logos/greenwich.png" alt="Greenwich College" width="24" height="24" loading="lazy" /></span></span>
            <span class="date">2019</span>
          </div>
          <span class="row-sub">Greenwich College, Sydney</span>
          <p class="row-desc">Earned the certificate at Greenwich College while on a student exchange in Australia.</p>
        </div>


        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Complementary courses</span>
              <span class="date">2022 — Now</span>
            </div>
            <p class="row-desc">Short courses I take to keep sharp on design, code and the business side of&nbsp;it.</p>
            <span class="acc-cta"><span class="more">View all courses</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">Courses</div>
              <ul class="dd-list">
                <li><b>Claude Code in Action</b> — Anthropic</li>
                <li><b>Psychology applied to sales and design</b> — Rian Dutra</li>
                <li><b>AI/UX Lab Workshop</b> — UX Unicórnio</li>
                <li><b>UX/UI techniques for interface design</b> — Intuitive Pixel</li>
                <li><b>UX Design &amp; front-end</b> — Origamid</li>
                <li><b>Intro to Branding</b> — Brandster Branding School</li>
                <li><b>Marketing &amp; funnels</b> — Método Russell Brunson</li>
              </ul>
            </div>
          </div>
        </details>

      </div>
    </section>

    <!-- Speaking -->
    <section class="section" data-tags="speaking">
      <h2 class="section-title">Speaking</h2>
      <p class="section-body">Talks and podcasts on branding, design systems and building with AI. I also post on <a href="https://www.youtube.com/@omiguelmoraesx" target="_blank" rel="noopener">YouTube</a>, and plan to do it more often.</p>
      <div class="rows">

        <div class="row">
          <div class="row-head">
            <a href="https://www.youtube.com/watch?v=aQbXjIAik4I" target="_blank" rel="noopener" class="row-link">
              OpCast — Dashboard Design with AI<span class="logo"><img src="/work/logos/opservices.svg" alt="OpServices" width="24" height="24" loading="lazy" /></span>
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2025</span>
          </div>
          <span class="row-sub">OpServices Podcast</span>
          <p class="row-desc">Discussed best practices for building dashboards in Grafana, how to use AI in the design process, and what makes a data visualization effective and actionable.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Branding for Small Businesses<span class="logo"><img src="/work/logos/caldeira.png" alt="Instituto Caldeira" width="24" height="24" loading="lazy" /></span></span>
            <span class="date">2024</span>
          </div>
          <span class="row-sub">Instituto Caldeira · with Gama Marketing</span>
          <p class="row-desc">Talk covering what branding really means, how to apply it practically, and why investing in brand identity creates tangible business value for small companies.</p>
          <div class="row-images">
            <div class="row-image"><img src="/speaking/IMG_4196.webp" alt="Miguel Moraes speaking at Instituto Caldeira, Branding for Small Businesses" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
          </div>
        </div>

      </div>
    </section>

  </div>

  <Lightbox />
</SiteLayout>

<style>
  /* Career: cada experiência é um <details>. O nativo já dá teclado, foco e
     Ctrl+F achando texto fechado — o CSS aqui só cuida da aparência. */

  /* Com um filtro ativo, a seção está sozinha na tela e o título dela repete
     o que a pill já diz */
  .content[data-filtered] .section-title,
  .content[data-filtered] .section-body {
    display: none;
  }

  /* Sem título visível, toda seção filtrada tem que colar no filtro do mesmo
     jeito que a Work — que já nasce sem título e recebe a margem negativa
     global do sections.css */
  .content[data-filtered] > * + .section {
    margin-top: calc(var(--section-gap) * -1 + var(--block-gap));
  }

  /* O .content usa gap de seção (56px), mas o filtro é do bloco do header:
     aproxima pro mesmo respiro que Projects e Stack usam (--block-gap) */
  .content > :global(.filters) {
    margin-top: calc(var(--block-gap) - var(--section-gap));
  }

  /* Entre experiências: mais que as rows normais (32px), menos que a quebra
     de seção (56px), pra hierarquia item < seção continuar de pé */
  .rows--career {
    gap: 44px;
  }

  /* Logo da empresa, fechando o título como continuação do texto. Enquanto
     não há arquivo, mostra a inicial; trocar por <img> quando tiver */
  .logo {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-left: 10px;
    border: 1px solid var(--color-border);
    /* Quadrado arredondado, não círculo: os logos são ícones de app e o
       círculo cortava os cantos onde a marca encosta */
    border-radius: 7px;
    background: var(--color-wash);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    line-height: 0;
    overflow: hidden;
  }

  /* Fundo branco só nos que têm imagem: são ícones de app com fundo escuro
     próprio, que sumiriam contra o fundo da página no tema escuro */
  .logo:has(img) {
    background: #ffffff;
  }

  .logo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .acc {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .acc summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .acc summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .acc summary:hover :global(.row-link) {
      text-decoration: underline;
    }
  }

  /* Números de escopo: blocos no desktop, um por linha no mobile */
  /* Cada resultado numa caixa, reaproveitando a borda das pills */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 8px;
  }

  .stat {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-pill-bg);
    padding: 14px 16px;
    font-size: var(--font-size-small);
    color: var(--color-body);
    line-height: 1.6;
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }

  @media (hover: hover) {
    .stat:hover {
      border-color: var(--color-muted);
      background: var(--color-wash);
    }
  }

  .stat b {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-title);
    font-feature-settings: 'tnum' 1;
  }

  .acc-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: var(--font-size-small);
    color: var(--color-muted);
    transition: color 0.18s ease;
  }

  @media (hover: hover) {
    .acc summary:hover .acc-cta {
      color: var(--color-title);
    }
  }

  .acc summary:focus-visible {
    outline: none;
  }

  .acc summary:focus-visible .acc-cta {
    outline: 2px solid var(--color-title);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .acc-cta .chev {
    font-size: 12px;
    opacity: 0.6;
    transition: transform 0.22s cubic-bezier(0.2, 0, 0, 1);
  }

  .acc[open] .acc-cta .chev {
    transform: rotate(90deg);
  }

  .acc .more { display: inline; }
  .acc[open] .more { display: none; }
  .acc .less { display: none; }
  .acc[open] .less { display: inline; }

  .dd {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 24px;
  }

  .dd-label {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 14px;
  }

  .dd-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .dd-list li {
    position: relative;
    padding-left: 22px;
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
    max-width: var(--row-text-max-width);
  }

  .dd-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-muted);
  }

  .dd-list li b {
    color: var(--color-title);
    font-weight: 500;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pill {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-pill-bg);
    padding: 4px 8px;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      color 0.18s ease;
  }

  /* Mesmo realce das caixas de resultado, pra os dois blocos do painel
     responderem igual ao mouse */
  @media (hover: hover) {
    .pill:hover {
      border-color: var(--color-muted);
      background: var(--color-wash);
      color: var(--color-title);
    }
  }

  /* Abertura animada onde o browser já suporta; o JS cobre o resto */
  @supports (interpolate-size: allow-keywords) {
    :root { interpolate-size: allow-keywords; }

    .acc::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 0.32s cubic-bezier(0.2, 0, 0, 1),
        opacity 0.22s ease,
        content-visibility 0.32s allow-discrete;
    }

    .acc[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acc::details-content { transition: none; }
    .acc-cta .chev { transition: none; }
  }

  @media (max-width: 600px) {
    .dd-list li { max-width: none; }

    .stats {
      flex-direction: column;
      gap: 14px;
    }
  }
</style>

<script>

  // Filtrar esconde o título da seção, mas não muda o estado dos cards
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;

    const filtered = btn.dataset.filter !== 'all';
    document.querySelector('.content')?.toggleAttribute('data-filtered', filtered);
  });

  // Safari ainda não anima ::details-content. Sem isso o card abre seco.
  const nativeAnim = CSS.supports('interpolate-size', 'allow-keywords');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!nativeAnim && !reduce) {
    document.querySelectorAll<HTMLDetailsElement>('.acc').forEach((details) => {
      const summary = details.querySelector('summary');
      const panel = details.querySelector<HTMLElement>('.dd');
      if (!summary || !panel) return;

      let anim: Animation | null = null;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        anim?.cancel();

        panel.style.overflow = 'hidden';
        const opening = !details.open;
        if (opening) details.open = true;

        const height = panel.getBoundingClientRect().height;
        const closed = { height: '0px', opacity: 0, marginTop: '0px' };
        const open = { height: `${height}px`, opacity: 1, marginTop: '24px' };

        anim = panel.animate(opening ? [closed, open] : [open, closed], {
          duration: opening ? 300 : 240,
          easing: 'cubic-bezier(0.2, 0, 0, 1)',
        });

        anim.onfinish = () => {
          anim = null;
          panel.style.overflow = '';
          if (!opening) details.open = false;
        };
      });
    });
  }
</script>
