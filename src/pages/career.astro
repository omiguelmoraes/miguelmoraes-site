---
import SiteLayout from '../layouts/SiteLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import Filters from '../components/Filters.astro';
---

<SiteLayout
  title="Carreira — Miguel Moraes"
  description="Experiência profissional, formação e palestras. Designer baseado em Porto Alegre, Brasil."
>
  <div class="content">

    <header class="page-header">
      <h1 class="page-title">Carreira</h1>
      <p class="page-intro">
        Onde trabalhei, o que estudei e os momentos em que estive em um palco ou microfone.
      </p>
    </header>

    <Filters
      allCount={11}
      options={[
        { label: 'Trabalho', value: 'work', count: 6 },
        { label: 'Formação', value: 'education', count: 3 },
        { label: 'Speaking', value: 'speaking', count: 2 },
      ]}
    />

    <!-- Work -->
    <section class="section" data-tags="work">
      <div class="rows">

        <div class="row">
          <div class="row-head">
            <a href="https://barca.cc/" target="_blank" rel="noopener" class="row-link">
              Web Designer na Barca<span class="logo"><img src="/work/logos/barca.png" alt="Barca" width="24" height="24" loading="lazy" /></span>
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2026 — Presente</span>
          </div>
          <p class="row-desc">Desenvolvo e coloco no ar as landing pages de lançamento de três clubes de assinatura de livros no Framer, acompanhando cada projeto do protótipo ao deploy. Criei sistemas de design modulares para cada marca, introduzi um fluxo de prototipagem em HTML e tokens adotado pelo time, e uso dados de comportamento real dos usuários para guiar decisões de copy e layout.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <a href="https://www.opservices.com.br" target="_blank" rel="noopener" class="row-link">
              UX/UI &amp; Marketing Designer na OpServices<span class="logo"><img src="/work/logos/opservices.svg" alt="OpServices" width="24" height="24" loading="lazy" /></span>
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2025 — 2026</span>
          </div>
          <p class="row-desc">Liderei o refresh visual institucional e os guias de marca para uma plataforma B2B de observabilidade. Desenhei dashboards no Grafana para dados complexos de monitoramento, criei campanhas de marketing e materiais de eventos, e desenvolvi ferramentas internas de IA que destravaram a produção de materiais recorrentes, antes um gargalo do time.</p>
          <div class="row-images">
            <div class="row-image"><img src="/work/opservices-1.webp" alt="Trabalho de design na OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
            <div class="row-image"><img src="/work/opservices-2.webp" alt="Trabalho de design na OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
            <div class="row-image"><img src="/work/opservices-3.webp" alt="Trabalho de design na OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
          </div>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Designer Independente</span>
            <span class="date">2022 — Presente</span>
          </div>
          <p class="row-desc">Projetos próprios de identidade visual, branding e web design para marcas e produtos digitais. Entrego ponta a ponta, da proposta ao código, desenvolvendo sites sob medida e criando sistemas de marca feitos para durar.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">UX/UI Designer na Synapsy Design<span class="logo"><img src="/work/logos/synapsy.png" alt="Synapsy Design" width="24" height="24" loading="lazy" /></span></span>
            <span class="date">2024 — 2025</span>
          </div>
          <p class="row-desc">Traduzi pesquisa de mercado e fluxos de usuário em interfaces para produtos digitais, trabalhando remoto com o time e defendendo cada decisão de UI com base no comportamento esperado do usuário.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <a href="https://www.gama.etc.br" target="_blank" rel="noopener" class="row-link">
              Visual &amp; Web Designer na Gama Marketing<span class="logo"><img src="/work/logos/gama.webp" alt="Gama Marketing" width="24" height="24" loading="lazy" /></span>
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2023 — 2024</span>
          </div>
          <p class="row-desc">Entreguei identidades visuais completas, materiais de marketing e sites sob medida para empresas locais, além de palestrar sobre branding para pequenas empresas no Instituto Caldeira.</p>
          <div class="row-images">
            <div class="row-image"><img src="/work/gama-1.webp" alt="Trabalho de design na Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
            <div class="row-image"><img src="/work/gama-2.webp" alt="Trabalho de design na Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
            <div class="row-image"><img src="/work/gama-3.webp" alt="Trabalho de design na Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
          </div>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Graphic Designer na Agência Blanc<span class="logo"><img src="/work/logos/blanc.svg" alt="Agência Blanc" width="24" height="24" loading="lazy" /></span></span>
            <span class="date">2023</span>
          </div>
          <p class="row-desc">Produzi identidades visuais e materiais impressos sob prazos rápidos de agência, enquanto reorganizava os fluxos de organização de arquivos e ativos da equipe. Também construí do zero o Notion que virou a central de projetos da agência, com prazo e status visíveis para todo o time.</p>
        </div>

      </div>
    </section>

    <!-- Education -->
    <section class="section" data-tags="education">
      <h2 class="section-title">Formação</h2>
      <p class="section-body">Educação formal e certificações que valem mencionar.</p>
      <div class="rows">

        <div class="row">
          <div class="row-head">
            <span class="row-link">Tecnólogo em Análise e Desenvolvimento de Sistemas<span class="logo"><img src="/work/logos/unisinos.png" alt="Unisinos" width="24" height="24" loading="lazy" /></span></span>
            <span class="date">2024 — Presente</span>
          </div>
          <span class="row-sub">Unisinos</span>
          <p class="row-desc">Atualmente cursando Análise e Desenvolvimento de Sistemas, com foco em engenharia de software.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Cambridge English Level 2 Certificate (Advanced)<span class="logo"><img src="/work/logos/greenwich.png" alt="Greenwich College" width="24" height="24" loading="lazy" /></span></span>
            <span class="date">2019</span>
          </div>
          <span class="row-sub">Greenwich College, Sydney</span>
          <p class="row-desc">Certificado avançado obtido no Greenwich College durante intercâmbio na Austrália.</p>
        </div>


        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Cursos complementares</span>
              <span class="date">2022 — Presente</span>
            </div>
            <p class="row-desc">Cursos rápidos que faço para me manter afiado em design, código e negócios.</p>
            <span class="acc-cta"><span class="more">Ver todos os cursos</span><span class="less">Fechar</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">Cursos</div>
              <ul class="dd-list">
                <li><b>Claude Code em Ação</b> — Anthropic</li>
                <li><b>Psicologia aplicada a vendas e design</b> — Rian Dutra</li>
                <li><b>Workshop AI/UX Lab</b> — UX Unicórnio</li>
                <li><b>Técnicas de UX/UI para design de interface</b> — Intuitive Pixel</li>
                <li><b>UX Design &amp; front-end</b> — Origamid</li>
                <li><b>Introdução ao Branding</b> — Escola Brandster</li>
                <li><b>Marketing &amp; funis</b> — Método Russell Brunson</li>
              </ul>
            </div>
          </div>
        </details>

      </div>
    </section>

    <!-- Speaking -->
    <section class="section" data-tags="speaking">
      <h2 class="section-title">Speaking</h2>
      <p class="section-body">Conversas sobre branding, design systems e construção com IA. Alguns registros ficam no meu <a href="https://www.youtube.com/@omiguelmoraesx" target="_blank" rel="noopener">YouTube</a>.</p>
      <div class="rows">

        <div class="row">
          <div class="row-head">
            <a href="https://www.youtube.com/watch?v=aQbXjIAik4I" target="_blank" rel="noopener" class="row-link">
              OpCast — Dashboard Design com IA<span class="logo"><img src="/work/logos/opservices.svg" alt="OpServices" width="24" height="24" loading="lazy" /></span>
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2025</span>
          </div>
          <span class="row-sub">OpServices Podcast</span>
          <p class="row-desc">Discussão sobre boas práticas para criação de dashboards no Grafana, uso de IA no processo de design e o que torna uma visualização de dados eficiente e acionável.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Branding para Pequenas Empresas<span class="logo"><img src="/work/logos/caldeira.png" alt="Instituto Caldeira" width="24" height="24" loading="lazy" /></span></span>
            <span class="date">2024</span>
          </div>
          <span class="row-sub">Instituto Caldeira · com Gama Marketing</span>
          <p class="row-desc">Palestra cobrindo o que branding realmente significa, como aplicar na prática e por que investir em identidade de marca gera valor real para pequenas empresas.</p>
          <div class="row-images">
            <div class="row-image"><img src="/speaking/IMG_4196.webp" alt="Miguel Moraes palestrando no Instituto Caldeira" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
          </div>
        </div>

      </div>
    </section>

  </div>

  <Lightbox />
</SiteLayout>

<style>
  /* Career: cada experiência é um <details>. O nativo já dá teclado, foco e
     Ctrl+F achando texto fechado — o CSS aqui só cuida da aparência. */

  /* Com um filtro ativo, a seção está sozinha na tela e o título dela repete
     o que a pill já diz */
  .content[data-filtered] .section-title,
  .content[data-filtered] .section-body {
    display: none;
  }

  /* Sem título visível, toda seção filtrada tem que colar no filtro do mesmo
     jeito que a Work — que já nasce sem título e recebe a margem negativa
     global do sections.css */
  .content[data-filtered] > * + .section {
    margin-top: calc(var(--section-gap) * -1 + var(--block-gap));
  }

  /* O .content usa gap de seção (56px), mas o filtro é do bloco do header:
     aproxima pro mesmo respiro que Projects e Stack usam (--block-gap) */
  .content > :global(.filters) {
    margin-top: calc(var(--block-gap) - var(--section-gap));
  }

  /* Entre experiências: mais que as rows normais (32px), menos que a quebra
     de seção (56px), pra hierarquia item < seção continuar de pé */
  .rows--career {
    gap: 44px;
  }

  /* Logo da empresa, fechando o título como continuação do texto. Enquanto
     não há arquivo, mostra a inicial; trocar por <img> quando tiver */
  .logo {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-left: 10px;
    border: 1px solid var(--color-border);
    /* Quadrado arredondado, não círculo: os logos são ícones de app e o
       círculo cortava os cantos onde a marca encosta */
    border-radius: 7px;
    background: var(--color-wash);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    line-height: 0;
    overflow: hidden;
  }

  /* Fundo branco só nos que têm imagem: são ícones de app com fundo escuro
     próprio, que sumiriam contra o fundo da página no tema escuro */
  .logo:has(img) {
    background: #ffffff;
  }

  .logo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .acc {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .acc summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .acc summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .acc summary:hover :global(.row-link) {
      text-decoration: underline;
    }
  }

  .acc-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: var(--font-size-small);
    color: var(--color-muted);
    transition: color 0.18s ease;
  }

  @media (hover: hover) {
    .acc summary:hover .acc-cta {
      color: var(--color-title);
    }
  }

  .acc summary:focus-visible {
    outline: none;
  }

  .acc summary:focus-visible .acc-cta {
    outline: 2px solid var(--color-title);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .acc-cta .chev {
    font-size: 12px;
    opacity: 0.6;
    transition: transform 0.22s cubic-bezier(0.2, 0, 0, 1);
  }

  .acc[open] .acc-cta .chev {
    transform: rotate(90deg);
  }

  .acc .more { display: inline; }
  .acc[open] .more { display: none; }
  .acc .less { display: none; }
  .acc[open] .less { display: inline; }

  .dd {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 24px;
  }

  .dd-label {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 14px;
  }

  .dd-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .dd-list li {
    position: relative;
    padding-left: 22px;
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
    max-width: var(--row-text-max-width);
  }

  .dd-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-muted);
  }

  .dd-list li b {
    color: var(--color-title);
    font-weight: 500;
  }

  /* Abertura animada onde o browser já suporta; o JS cobre o resto */
  @supports (interpolate-size: allow-keywords) {
    :root { interpolate-size: allow-keywords; }

    .acc::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 0.32s cubic-bezier(0.2, 0, 0, 1),
        opacity 0.22s ease,
        content-visibility 0.32s allow-discrete;
    }

    .acc[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acc::details-content { transition: none; }
    .acc-cta .chev { transition: none; }
  }

  @media (max-width: 600px) {
    .dd-list li { max-width: none; }

    .stats {
      flex-direction: column;
      gap: 14px;
    }
  }
</style>

<script>

  // Filtrar esconde o título da seção, mas não muda o estado dos cards
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;

    const filtered = btn.dataset.filter !== 'all';
    document.querySelector('.content')?.toggleAttribute('data-filtered', filtered);
  });

  // Safari ainda não anima ::details-content. Sem isso o card abre seco.
  const nativeAnim = CSS.supports('interpolate-size', 'allow-keywords');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!nativeAnim && !reduce) {
    document.querySelectorAll<HTMLDetailsElement>('.acc').forEach((details) => {
      const summary = details.querySelector('summary');
      const panel = details.querySelector<HTMLElement>('.dd');
      if (!summary || !panel) return;

      let anim: Animation | null = null;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        anim?.cancel();

        panel.style.overflow = 'hidden';
        const opening = !details.open;
        if (opening) details.open = true;

        const height = panel.getBoundingClientRect().height;
        const closed = { height: '0px', opacity: 0, marginTop: '0px' };
        const open = { height: `${height}px`, opacity: 1, marginTop: '24px' };

        anim = panel.animate(opening ? [closed, open] : [open, closed], {
          duration: opening ? 300 : 240,
          easing: 'cubic-bezier(0.2, 0, 0, 1)',
        });

        anim.onfinish = () => {
          anim = null;
          panel.style.overflow = '';
          if (!opening) details.open = false;
        };
      });
    });
  }
</script>
