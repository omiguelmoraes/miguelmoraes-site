---
import SiteLayout from '../layouts/SiteLayout.astro';
import Lightbox from '../components/Lightbox.astro';
---

<SiteLayout
  title="Career — Miguel Moraes"
  description="Work experience, education and talks. Designer based in Porto Alegre, Brazil."
>
  <div class="content">

    <header class="page-header">
      <h1 class="page-title">Career</h1>
      <p class="page-intro">
        Where I've worked, what I studied, and the times I've been on a stage or a&nbsp;mic.
      </p>
    </header>

    <!-- Work -->
    <section class="section">
      <div class="rows rows--career">

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Web Designer at Barca</span>
              <span class="date">2026 — Now</span>
            </div>
            <p class="row-desc">I design and build the websites of three subscription book clubs in Framer, from prototype to live&nbsp;page.</p>
            <div class="stats">
              <div class="stat"><i class="ph ph-buildings"></i><b>3</b><span>brands under my care</span></div>
              <div class="stat"><i class="ph ph-browsers"></i><b>15</b><span>pages shipped</span></div>
              <div class="stat"><i class="ph ph-repeat"></i><b>Monthly</b><span>launch cadence</span></div>
            </div>
            <span class="acc-cta"><span class="more">Read more</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">What I do</div>
              <ul class="dd-list">
                <li>Own the launch landing page of each club, from prototype to live site, including the monthly box drop.</li>
                <li>Built a <b>design system per club</b> in Framer, so a new page starts from components instead of a blank canvas.</li>
                <li>Introduced a <b>prototype-first workflow</b> — the page is validated in HTML with the brand's tokens before anyone touches Framer. Adopted by the whole web team.</li>
                <li>Set up <b>Microsoft Clarity</b> across the clubs and turn dead clicks, rage clicks and scroll depth into copy and layout decisions.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Skills I sharpened here</div>
              <div class="pills"><span class="pill">Framer</span><span class="pill">Design systems</span><span class="pill">Conversion copy</span><span class="pill">Behaviour analytics</span><span class="pill">HTML/CSS</span><span class="pill">Meta Ads</span></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">UX/UI &amp; Marketing Designer at OpServices</span>
              <span class="date">2025 — 2026</span>
            </div>
            <p class="row-desc">Marketing design and product UI at a B2B observability company — campaigns, dashboards and a brand&nbsp;refresh.</p>
            <div class="stats">
              <div class="stat"><i class="ph ph-squares-four"></i><b>20+</b><span>interfaces designed</span></div>
              <div class="stat"><i class="ph ph-paint-brush"></i><b>1</b><span>brand refresh led</span></div>
              <div class="stat"><i class="ph ph-stack"></i><b>1</b><span>design system shipped</span></div>
            </div>
            <span class="acc-cta"><span class="more">Read more</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">What I did</div>
              <ul class="dd-list">
                <li>Led the <b>institutional visual refresh</b> — identity, site and sales material — and wrote the guidelines that kept it consistent.</li>
                <li>Designed <b>observability dashboards</b> in Grafana, turning dense monitoring data into something a client could act on.</li>
                <li>Ran the campaign and social output: carousels, launches, trade-show booths and event material.</li>
                <li>Built internal <b>AI tooling for the design team</b>, so recurring pieces stopped being made from scratch.</li>
                <li>Talked about dashboard design with AI on the company podcast.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Skills I sharpened here</div>
              <div class="pills"><span class="pill">Data viz</span><span class="pill">Grafana</span><span class="pill">Brand systems</span><span class="pill">B2B marketing</span><span class="pill">Figma</span><span class="pill">AI tooling</span></div>
            </div>
            <div class="row-images">
              <div class="row-image"><img src="/work/opservices-1.webp" alt="Design work at OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
              <div class="row-image"><img src="/work/opservices-2.webp" alt="Design work at OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
              <div class="row-image"><img src="/work/opservices-3.webp" alt="Design work at OpServices" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Independent Designer</span>
              <span class="date">2022 — Now</span>
            </div>
            <p class="row-desc">Remote work for clients across Brazil, now under my own studio, Korbi — visual identity, branding and UX/UI for digital&nbsp;products.</p>
            <div class="stats">
              <div class="stat"><i class="ph ph-briefcase"></i><b>50+</b><span>projects delivered</span></div>
              <div class="stat"><i class="ph ph-hourglass"></i><b>4</b><span>years running</span></div>
            </div>
            <span class="acc-cta"><span class="more">Read more</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">What I do</div>
              <ul class="dd-list">
                <li>Take projects from <b>proposal to launch</b> — scoping, pricing and delivery, solo.</li>
                <li>Build sites in <b>Astro and Framer</b>, including e-commerce flows connected to Shopify.</li>
                <li>Design brand identities and the systems that keep them alive after handoff.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Skills I sharpened here</div>
              <div class="pills"><span class="pill">Client management</span><span class="pill">Pricing</span><span class="pill">Astro</span><span class="pill">Branding</span><span class="pill">SEO</span></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">UX/UI Designer at Synapsy Design</span>
              <span class="date">2024 — 2025</span>
            </div>
            <p class="row-desc">Wireframes, prototypes and design guidelines for digital products, inside a remote product team in São&nbsp;Paulo.</p>
            <span class="acc-cta"><span class="more">Read more</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">What I did</div>
              <ul class="dd-list">
                <li>Turned briefs into <b>wireframes and clickable prototypes</b> for client validation.</li>
                <li>Defined <b>design guidelines</b> so different hands produced the same interface.</li>
                <li>Ran <b>market and competitor research</b> to justify interface decisions.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Skills I sharpened here</div>
              <div class="pills"><span class="pill">Prototyping</span><span class="pill">UX research</span><span class="pill">Figma</span><span class="pill">Remote collaboration</span></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Visual &amp; Web Designer at Gama Marketing</span>
              <span class="date">2023 — 2024</span>
            </div>
            <p class="row-desc">Logos, visual materials and websites for small businesses in the&nbsp;region.</p>
            <div class="stats">
              <div class="stat"><i class="ph ph-fingerprint"></i><b>30+</b><span>identities delivered</span></div>
              <div class="stat"><i class="ph ph-microphone-stage"></i><b>1</b><span>talk at Instituto Caldeira</span></div>
            </div>
            <span class="acc-cta"><span class="more">Read more</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">What I did</div>
              <ul class="dd-list">
                <li>Delivered <b>brand identities</b> end to end — logo, system, application.</li>
                <li>Designed and built <b>client websites</b>, from wireframe to live page.</li>
                <li>Spoke at <b>Instituto Caldeira</b> on branding for small businesses.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Skills I sharpened here</div>
              <div class="pills"><span class="pill">Branding</span><span class="pill">Client presentation</span><span class="pill">Illustrator</span><span class="pill">Web design</span></div>
            </div>
            <div class="row-images">
              <div class="row-image"><img src="/work/gama-1.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
              <div class="row-image"><img src="/work/gama-2.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
              <div class="row-image"><img src="/work/gama-3.webp" alt="Design work at Gama Marketing" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
            </div>
          </div>
        </details>

        <details class="acc">
          <summary>
            <div class="row-head">
              <span class="row-link">Graphic Designer at Agência Blanc</span>
              <span class="date">2023</span>
            </div>
            <p class="row-desc">Visual identities and print material for local clients, at agency&nbsp;pace.</p>
            <span class="acc-cta"><span class="more">Read more</span><span class="less">Close</span><i class="ph ph-caret-right chev"></i></span>
          </summary>
          <div class="dd">
            <div>
              <div class="dd-label">What I did</div>
              <ul class="dd-list">
                <li>Produced <b>visual identities and print material</b> under agency deadlines.</li>
                <li>Reorganised the <b>file and asset workflow</b> so work stopped getting lost between hands.</li>
              </ul>
            </div>
            <div>
              <div class="dd-label">Skills I sharpened here</div>
              <div class="pills"><span class="pill">Illustrator</span><span class="pill">Photoshop</span><span class="pill">Print</span></div>
            </div>
          </div>
        </details>

      </div>
    </section>

    <!-- Education -->
    <section class="section">
      <h2 class="section-title">Education</h2>
      <p class="section-body">Formal education and the certifications worth mentioning.</p>
      <div class="rows">

        <div class="row">
          <div class="row-head">
            <span class="row-link">Tecnólogo em Análise e Desenvolvimento de Sistemas</span>
            <span class="date">2024 — Now</span>
          </div>
          <span class="row-sub">Unisinos, Porto Alegre</span>
          <p class="row-desc">Currently studying Systems Analysis and Development, focused on software engineering.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Cambridge English Level 2 Certificate (Advanced)</span>
            <span class="date">2019</span>
          </div>
          <span class="row-sub">Greenwich College, Sydney, Australia</span>
          <p class="row-desc">Earned the certificate at Greenwich College while on a student exchange in Australia.</p>
        </div>

      </div>
    </section>

    <!-- Speaking -->
    <section class="section">
      <h2 class="section-title">Speaking</h2>
      <p class="section-body">Talks and podcasts on branding, design systems and building with AI. I also post on <a href="https://www.youtube.com/@omiguelmoraesx" target="_blank" rel="noopener">YouTube</a>, and plan to do it more often.</p>
      <div class="rows">

        <div class="row">
          <div class="row-head">
            <a href="https://www.youtube.com/watch?v=aQbXjIAik4I" target="_blank" rel="noopener" class="row-link">
              OpCast — Dashboard Design with AI
              <i class="ph ph-arrow-square-out"></i>
            </a>
            <span class="date">2025</span>
          </div>
          <span class="row-sub">OpServices Podcast</span>
          <p class="row-desc">Discussed best practices for building dashboards in Grafana, how to use AI in the design process, and what makes a data visualization effective and actionable.</p>
        </div>

        <div class="row">
          <div class="row-head">
            <span class="row-link">Branding for Small Businesses</span>
            <span class="date">2024</span>
          </div>
          <span class="row-sub">Instituto Caldeira · Porto Alegre, Brazil · with Gama Marketing</span>
          <p class="row-desc">Talk covering what branding really means, how to apply it practically, and why investing in brand identity creates tangible business value for small companies.</p>
          <div class="row-images">
            <div class="row-image"><img src="/speaking/IMG_4196.webp" alt="Miguel Moraes speaking at Instituto Caldeira, Branding for Small Businesses" class="lightbox-trigger" width="300" height="200" loading="lazy" /></div>
          </div>
        </div>

      </div>
    </section>

  </div>

  <Lightbox />
</SiteLayout>

<style>
  /* Career: cada experiência é um <details>. O nativo já dá teclado, foco e
     Ctrl+F achando texto fechado — o CSS aqui só cuida da aparência. */
  .rows--career {
    gap: var(--section-gap);
  }

  .acc {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .acc summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .acc summary::-webkit-details-marker {
    display: none;
  }

  .acc summary:hover :global(.row-link) {
    text-decoration: underline;
  }

  /* Números de escopo: blocos no desktop, um por linha no mobile */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 32px;
    margin-top: 16px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .stat b {
    font-size: 18px;
    font-weight: 500;
    font-family: var(--font-mono);
    color: var(--color-title);
    line-height: 1.3;
    font-feature-settings: 'tnum' 1;
  }

  .stat span {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* O ícone só entra no mobile, onde ele é o ponto de entrada da linha.
     No desktop o número em mono já cumpre esse papel */
  .stat i {
    display: none;
  }

  .acc-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: var(--font-size-small);
    color: var(--color-muted);
    transition: color 0.18s ease;
  }

  .acc summary:hover .acc-cta {
    color: var(--color-title);
  }

  .acc summary:focus-visible {
    outline: none;
  }

  .acc summary:focus-visible .acc-cta {
    outline: 2px solid var(--color-title);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .acc-cta .chev {
    font-size: 12px;
    opacity: 0.6;
    transition: transform 0.22s cubic-bezier(0.2, 0, 0, 1);
  }

  .acc[open] .acc-cta .chev {
    transform: rotate(90deg);
  }

  .acc .more { display: inline; }
  .acc[open] .more { display: none; }
  .acc .less { display: none; }
  .acc[open] .less { display: inline; }

  .dd {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 24px;
    padding-left: 18px;
    border-left: 1px solid var(--color-border);
  }

  .dd-label {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 14px;
  }

  .dd-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .dd-list li {
    position: relative;
    padding-left: 22px;
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
    max-width: var(--row-text-max-width);
  }

  .dd-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-muted);
  }

  .dd-list li b {
    color: var(--color-title);
    font-weight: 500;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pill {
    font-size: 11px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 4px 8px;
  }

  /* Abertura animada onde o browser já suporta; o JS cobre o resto */
  @supports (interpolate-size: allow-keywords) {
    :root { interpolate-size: allow-keywords; }

    .acc::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 0.32s cubic-bezier(0.2, 0, 0, 1),
        opacity 0.22s ease,
        content-visibility 0.32s allow-discrete;
    }

    .acc[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acc::details-content { transition: none; }
    .acc-cta .chev { transition: none; }
  }

  @media (max-width: 600px) {
    .dd-list li { max-width: none; }

    .dd { padding-left: 14px; }

    .stats {
      flex-direction: column;
      gap: 0;
    }

    .stat {
      flex-direction: row;
      align-items: baseline;
      padding: 10px 0;
      border-bottom: 1px solid var(--color-border);
    }

    .stat:first-child {
      border-top: 1px solid var(--color-border);
    }

    .stat i {
      display: block;
      flex: 0 0 auto;
      width: 16px;
      margin-right: 14px;
      font-size: 16px;
      color: var(--color-muted);
      transform: translateY(3px);
    }

    .stat b {
      font-size: var(--font-size-body);
      margin-right: 7px;
    }

    .stat span {
      font-size: var(--font-size-body);
      color: var(--color-body);
    }
  }
</style>

<script>
  // Safari ainda não anima ::details-content. Sem isso o card abre seco.
  const nativeAnim = CSS.supports('interpolate-size', 'allow-keywords');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!nativeAnim && !reduce) {
    document.querySelectorAll<HTMLDetailsElement>('.acc').forEach((details) => {
      const summary = details.querySelector('summary');
      const panel = details.querySelector<HTMLElement>('.dd');
      if (!summary || !panel) return;

      let anim: Animation | null = null;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        anim?.cancel();

        panel.style.overflow = 'hidden';
        const opening = !details.open;
        if (opening) details.open = true;

        const height = panel.getBoundingClientRect().height;
        const closed = { height: '0px', opacity: 0, marginTop: '0px' };
        const open = { height: `${height}px`, opacity: 1, marginTop: '24px' };

        anim = panel.animate(opening ? [closed, open] : [open, closed], {
          duration: opening ? 300 : 240,
          easing: 'cubic-bezier(0.2, 0, 0, 1)',
        });

        anim.onfinish = () => {
          anim = null;
          panel.style.overflow = '';
          if (!opening) details.open = false;
        };
      });
    });
  }
</script>
