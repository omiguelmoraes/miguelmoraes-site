---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });

// Categorias saem das tags dos posts, ordenadas por frequência
const tagCounts = posts
  .flatMap(p => p.data.tags)
  .reduce<Record<string, number>>((acc, tag) => ({ ...acc, [tag]: (acc[tag] ?? 0) + 1 }), {});
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<SiteLayout
  lang="pt-BR"
  title="Blog — Miguel Moraes"
  description="Notas e reflexões sobre design, código e o dia a dia de quem constrói."
>
  <div class="page">

    <header class="page-header">
      <h1 class="page-title">Blog</h1>
      <p class="page-intro">Notas e reflexões sobre design, código e o dia a dia de quem constrói.</p>
    </header>

    {tags.length > 1 && (
      <div class="filters">
        <button class="filter-btn active" data-filter="all">Todos <span class="filter-count">{posts.length}</span></button>
        {tags.map(([tag, count]) => (
          <button class="filter-btn" data-filter={tag}>{tag} <span class="filter-count">{count}</span></button>
        ))}
      </div>
    )}

    {posts.length > 0 ? (
      <div class="list">
        {posts.map(post => (
          <a href={`/blog/${post.id}`} class="item" data-tags={post.data.tags.join(',')}>
            <span class="item-title">{post.data.title}</span>
            <span class="item-date">{formatDate(post.data.date)}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">Em breve.</p>
    )}

    <p class="empty" id="empty-state" hidden>Nada nessa categoria ainda.</p>

  </div>
</SiteLayout>

<script>
  // Delegação no document, registrada quando o módulo roda. Depender de
  // astro:page-load não funciona: o ClientRouter dispara esse evento antes
  // deste script (module = deferido) executar.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLButtonElement | null;
    if (!btn) return;

    const group = btn.parentElement;
    group?.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const filter = btn.dataset.filter!;
    const items = document.querySelectorAll<HTMLElement>('[data-tags]');
    let visible = 0;
    items.forEach(item => {
      const tags = (item.dataset.tags ?? '').split(',');
      const show = filter === 'all' || tags.includes(filter);
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    const emptyState = document.getElementById('empty-state');
    if (emptyState) emptyState.hidden = visible > 0;
  });
</script>

<style>
  .filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-small);
    font-family: inherit;
    padding: 4px 14px;
    border-radius: 12px;
    cursor: pointer;
    line-height: 1.6;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .filter-btn:hover {
    color: var(--color-title);
    border-color: var(--color-muted);
  }

  .filter-btn.active {
    background: var(--color-title);
    border-color: var(--color-title);
    color: var(--color-bg);
  }

  .filter-count {
    opacity: 0.45;
    font-size: 0.85em;
    margin-left: 1px;
  }

  .filter-btn.active .filter-count {
    opacity: 0.6;
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: var(--prose-max-width);
  }

  .back {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--color-title); }




  .list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    text-decoration: none;
  }

  .item-title {
    font-size: var(--font-size-body);
    font-weight: 500;
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  .item:hover .item-title {
    text-decoration: underline;
  }

  .item-date {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    flex-shrink: 0;
    line-height: var(--line-height-body);
    text-align: right;
  }

  .empty {
    color: var(--color-muted);
    font-size: var(--font-size-body);
  }

  @media (max-width: 600px) {
    .item {
      flex-direction: column;
      gap: 2px;
    }
    .item-date {
      text-align: left;
    }
  }

  @media (max-width: 700px) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--layout-padding-x) * -1);
      padding-inline: var(--layout-padding-x);
    }

    .filters::-webkit-scrollbar {
      display: none;
    }

    .filter-btn {
      flex-shrink: 0;
    }
  }
</style>
