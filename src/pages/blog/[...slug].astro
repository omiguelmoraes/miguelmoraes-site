---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });

// Posts relacionados: mesma tag, mais recentes primeiro
const all = (await getCollection('blog', ({ data }) => !data.draft)).filter(p => p.id !== post.id);
const related = all
  .filter(p => p.data.tags.some(tag => post.data.tags.includes(tag)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<SiteLayout
  lang="pt-BR"
  title={`${post.data.title} — Miguel Moraes`}
  description={post.data.description}
>
  <div class="page">

    <nav class="nav">
      <a href="/blog" class="back">← Todos os artigos</a>
    </nav>

    <header class="page-header">
      <h1 class="page-title">{post.data.title}</h1>
      <p class="page-intro">{post.data.description}</p>
      <span class="post-date">{formatDate(post.data.date)}</span>
    </header>

    {post.data.cover && (
      <Image src={post.data.cover} alt={post.data.title} class="cover" loading="eager" />
    )}

    <article class="prose">
      <Content />
    </article>

    {related.length > 0 && (
      <aside class="related">
        <h2 class="related-title">Continue lendo</h2>
        <div class="related-list">
          {related.map(p => (
            <a href={`/blog/${p.id}`} class="related-item">
              <span class="related-item-title">{p.data.title}</span>
              <span class="related-item-date">
                {p.data.date.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
      </aside>
    )}

  </div>
</SiteLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: var(--prose-max-width);
  }

  .back {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  .back:hover { color: var(--color-title); }

  .post-date {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    margin-top: 2px;
  }

  .cover {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  .related {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-title {
    font-size: var(--font-size-small);
    font-weight: 400;
    color: var(--color-muted);
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .related-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    text-decoration: none;
  }

  .related-item-title {
    font-size: var(--font-size-body);
    font-weight: 500;
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  .related-item:hover .related-item-title { text-decoration: underline; }

  .related-item-date {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    flex-shrink: 0;
    text-align: right;
  }

  @media (max-width: 600px) {
    .related-item {
      flex-direction: column;
      gap: 2px;
    }
    .related-item-date { text-align: left; }
  }
</style>

<style is:global>
  .prose {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: var(--font-size-body);
    color: var(--color-body);
    line-height: var(--line-height-body);
  }

  .prose h2 {
    font-size: var(--font-size-body);
    font-weight: 500;
    color: var(--color-title);
    margin-top: 16px;
  }

  .prose h3 {
    font-size: var(--font-size-body);
    font-weight: 400;
    color: var(--color-title);
  }

  .prose a {
    color: var(--color-title);
    text-decoration: underline;
  }

  .prose ul,
  .prose ol {
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose li::marker {
    color: var(--color-muted);
  }

  .prose img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  .prose figure {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose figcaption {
    font-size: var(--font-size-small);
    color: var(--color-muted);
  }

  .prose blockquote {
    border-left: 2px solid var(--color-border);
    padding-left: 16px;
    color: var(--color-muted);
  }

  .prose code {
    font-family: 'Geist Mono', monospace;
    font-size: 0.9em;
    background: var(--color-pill-bg);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-title);
  }

  .prose pre {
    background: var(--color-wash);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px;
    overflow-x: auto;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }

  /* Shiki: cor do token segue o tema do site, não o tema do highlighter */
  .prose .astro-code,
  .prose .astro-code span {
    color: var(--shiki-light);
    background-color: transparent !important;
  }

  @media (prefers-color-scheme: dark) {
    .prose .astro-code,
    .prose .astro-code span {
      color: var(--shiki-dark);
    }
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
  }
</style>
