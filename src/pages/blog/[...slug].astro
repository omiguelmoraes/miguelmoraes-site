---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PostCTA from '../../components/PostCTA.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

// timeZone UTC porque a data do frontmatter vira meia-noite UTC: formatando no
// fuso local (UTC-3) o dia voltava um, e aí o texto discordava do <time datetime>
const formatDate = (date: Date) =>
  date.toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

// Relacionados: mesma categoria primeiro, completando com os mais recentes
// pra seção nunca aparecer vazia quando a categoria tem um post só
const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const sameCategory = all.filter(p => p.data.category === post.data.category);
const related = [...sameCategory, ...all.filter(p => !sameCategory.includes(p))].slice(0, 3);

// Post sem capa cai na OG padrão do site
const ogImage = post.data.cover?.src ?? '/og.png';

// Só a data (sem hora) porque o frontmatter não tem horário — cravar meia-noite
// aqui seria inventar precisão que o dado não tem
const publishedDate = post.data.date.toISOString().slice(0, 10);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": publishedDate,
  "image": new URL(ogImage, Astro.site).href,
  "url": new URL(`/blog/${post.id}`, Astro.site).href,
  "mainEntityOfPage": new URL(`/blog/${post.id}`, Astro.site).href,
  "inLanguage": "pt-BR",
  "articleSection": post.data.category,
  "author": {
    "@type": "Person",
    "name": "Miguel Moraes",
    "url": "https://miguelmoraes.pro",
  },
  "publisher": {
    "@type": "Person",
    "name": "Miguel Moraes",
    "url": "https://miguelmoraes.pro",
  },
};
---

<SiteLayout
  lang="pt-BR"
  type="article"
  title={`${post.data.title} — Miguel Moraes`}
  description={post.data.description}
  image={ogImage}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="page">

    <nav class="nav">
      <a href="/blog" class="back">← Todos os artigos</a>
    </nav>

    <header class="post-header">
      <span class="post-category">{post.data.category}</span>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-lead">{post.data.description}</p>
      <div class="byline">
        <span class="byline-author" data-tooltip="Miguel Moraes">
          <img class="byline-avatar" src="/webp/avatar.webp" alt="Miguel Moraes" width="28" height="28" />
        </span>
        <time class="byline-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
      </div>
    </header>

    {post.data.cover && (
      <Image src={post.data.cover} alt={post.data.title} class="cover" loading="eager" />
    )}

    <article class="prose">
      <Content />
    </article>

    <PostCTA />

    {related.length > 0 && (
      <aside class="related">
        <h2 class="related-title">Continue lendo</h2>
        <div class="related-list">
          {related.map(p => (
            <a href={`/blog/${p.id}`} class="related-item">
              <span class="related-item-title">{p.data.title}</span>
              <span class="related-item-date">
                {p.data.date.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
      </aside>
    )}

  </div>
</SiteLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--block-gap);
    max-width: 660px;
  }

  .back {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }
  @media (hover: hover) {
    .back:hover {
      color: var(--color-title);
    }
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 16px;
  }

  .post-category {
    font-size: var(--font-size-small);
    color: var(--color-muted);
  }

  /* Assinatura fecha o header: autor à esquerda, data empurrada pra direita.
     A folga maior acima separa o bloco do lead sem precisar de divisória */
  .byline {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .byline-author {
    position: relative;
    display: flex;
  }

  /* Mesmo pill de tooltip da /links. Só no ponteiro: no toque o :hover fica
     grudado depois do tap, e aí o rótulo não sai mais da tela */
  @media (hover: hover) {
    .byline-author::after {
      content: attr(data-tooltip);
      position: absolute;
      bottom: calc(100% + 8px);
      left: 0;
      background: var(--color-title);
      color: var(--color-bg);
      font-size: var(--font-size-xs);
      font-weight: 500;
      padding: 4px 9px;
      border-radius: 4px;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.15s;
    }

    .byline-author:hover::after {
      opacity: 1;
    }
  }

  /* Mesmo squircle do avatar do Sidebar, na escala de metadado */
  .byline-avatar {
    width: 28px;
    height: 28px;
    border-radius: 24%;
    corner-shape: squircle;
    object-fit: cover;
    background: var(--color-wash);
    flex-shrink: 0;
  }

  .byline-date {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    margin-left: auto;
    flex-shrink: 0;
  }

  /* Mesma escala dos títulos de página do site; só o peso sobe, porque
     aqui ele é o h1 de um texto longo */
  .post-title {
    font-size: var(--font-size-title);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: var(--line-height-title);
    color: var(--color-title);
  }

  /* Mesmo tamanho e mesma cor do corpo apagava a fronteira entre resumo e
     texto. A cor mais clara resolve sem precisar aumentar o tamanho */
  .post-lead {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 54ch;
  }

  .cover {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  .related {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-title {
    font-size: var(--font-size-small);
    font-weight: 400;
    color: var(--color-muted);
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .related-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    text-decoration: none;
  }

  .related-item-title {
    font-size: var(--font-size-body);
    font-weight: 500;
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  @media (hover: hover) {
    .related-item:hover .related-item-title {
      text-decoration: underline;
    }
  }

  .related-item-date {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    flex-shrink: 0;
    text-align: right;
  }

  @media (max-width: 600px) {
    .related-item {
      flex-direction: column;
      gap: 2px;
    }
    .related-item-date { text-align: left; }
  }
</style>

<style is:global>
  /* Espaçamento por tipo em vez de um intervalo igual pra tudo: parágrafo
     próximo do vizinho, título com folga acima e colado no que ele abre */
  .prose {
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.7;
  }

  .prose > * + * {
    margin-top: 16px;
  }

  .prose h2 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-title);
    margin-top: 44px;
  }

  .prose h2 + * {
    margin-top: 10px;
  }

  .prose h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-title);
    margin-top: 32px;
  }

  .prose h3 + * {
    margin-top: 8px;
  }

  .prose a {
    color: var(--color-title);
    text-decoration: underline;
  }

  .prose ul,
  .prose ol {
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prose li::marker {
    color: var(--color-muted);
  }

  .prose img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  /* imagem e legenda vêm no mesmo parágrafo, vindas do markdown */
  .prose p:has(> img) {
    text-align: center;
  }

  .prose figure {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose figcaption {
    font-size: var(--font-size-small);
    color: var(--color-muted);
  }

  .prose blockquote {
    border-left: 2px solid var(--color-border);
    padding-left: 16px;
    color: var(--color-muted);
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-pill-bg);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-title);
  }

  .prose pre {
    background: var(--color-wash);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px;
    overflow-x: auto;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }

  /* Shiki: cor do token segue o tema do site, não o tema do highlighter */
  .prose .astro-code,
  .prose .astro-code span {
    color: var(--shiki-light);
    background-color: transparent !important;
  }

  @media (prefers-color-scheme: dark) {
    .prose .astro-code,
    .prose .astro-code span {
      color: var(--shiki-dark);
    }
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
  }
</style>
