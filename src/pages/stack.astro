---
import SiteLayout from '../layouts/SiteLayout.astro';
import Filters from '../components/Filters.astro';

const hardware = [
  { name: 'Mac Mini M4', logo: 'apple.png', note: 'O desktop compacto mais potente da Apple. Rápido, silencioso e pequeno.', href: 'https://www.apple.com/mac-mini/' },
  { name: 'Arzopa 16" Portable', logo: 'arzopa.png', note: 'Segunda tela em qualquer lugar. Mais espaço para organizar o fluxo de trabalho.', href: 'https://www.arzopa.com/' },
  { name: 'AOC 27" QHD', note: 'Monitor amplo e nítido para o trabalho diário de design e dev.', href: '' },
  { name: 'Aula F75', note: 'Teclado mecânico compacto 75%. Excelente custo-benefício.', href: '' },
  { name: 'MX Master 3', logo: 'logitech.png', note: 'O melhor mouse de produtividade que já usei. Confortável para sessões longas.', href: 'https://www.logitech.com/products/mice/mx-master-3s.html' },
  { name: 'Edifier W820NB', logo: 'edifier.png', note: 'Fone de ouvido sem fio com bom cancelamento de ruído.', href: '' },
];

const design = [
  { name: 'Figma', logo: 'figma.png', note: 'Design de interfaces, prototipagem e sistemas de marca.', href: 'https://figma.com' },
  { name: 'Framer', logo: 'framer.png', note: 'Onde os sites de clientes que construo entram no ar.', href: 'https://framer.com' },
  { name: 'Eagle', logo: 'eagle.png', note: 'Referências visuais organizadas em uma biblioteca local.', href: 'https://eagle.cool' },
  { name: 'Clarity', logo: 'clarity.png', note: 'Mapas de calor e gravações de sessão. Como entendo o comportamento real dos usuários nas páginas.', href: 'https://clarity.microsoft.com' },
  { name: 'Illustrator', logo: 'illustrator.svg', note: 'Onde comecei a fazer design. Continua sendo para onde vou quando o traço precisa ser vetor.', href: 'https://www.adobe.com/products/illustrator.html' },
  { name: 'Photoshop', logo: 'photoshop.svg', note: 'Uso pontual, para mockup e tratamento de imagem.', href: 'https://www.adobe.com/products/photoshop.html' },
];

const dev = [
  { name: 'Zed', logo: 'zed.png', note: 'Editor de código ultrarrápido e minimalista. O Claude Code roda dentro dele.', href: 'https://zed.dev' },
  { name: 'Claude', logo: 'claude.png', note: 'IA para código, criação de conteúdo e resolução de problemas.', href: 'https://claude.ai' },
  { name: 'Ghostty', logo: 'ghostty.png', note: 'Terminal rápido e minimalista.', href: 'https://ghostty.org' },
  { name: 'GitHub', logo: 'github.svg', note: 'Onde o código mora. Todo projeto que construo tem um repositório aqui.', href: 'https://github.com' },
  { name: 'Vercel', logo: 'vercel.png', note: 'Hospedagem e deploys. Push para a main e o site entra no ar.', href: 'https://vercel.com' },
  { name: 'Astro', logo: 'astro.svg', note: 'O framework por trás deste site e da maioria das coisas que construo.', href: 'https://astro.build' },
  { name: 'Linear', logo: 'linear.svg', note: 'Gestão de tarefas e roadmap para projetos de código.', href: 'https://linear.app' },
];

const productivity = [
  { name: 'Obsidian', logo: 'obsidian.png', note: 'Segundo cérebro e gestão de notas. Todas as minhas anotações vivem aqui.', href: 'https://obsidian.md' },
  { name: 'Things 3', logo: 'things.png', note: 'Tarefas e hábitos. Tudo que tem prazo mora aqui.', href: 'https://culturedcode.com/things/' },
  { name: 'Apple Calendar', logo: 'apple.png', note: 'Simples e eficiente. Cumpre o papel.', href: '' },
  { name: 'CleanShot X', logo: 'cleanshot.png', note: 'Capturas e gravações de tela com anotações em segundos.', href: 'https://cleanshot.com' },
  { name: 'Safari', logo: 'apple.png', note: 'Voltei a usar pela velocidade e baixo consumo de bateria. O simples vence.', href: '' },
  { name: 'Slack', logo: 'slack.png', note: 'Onde o time se comunica. Squads, alinhamentos e reuniões rápidas.', href: 'https://slack.com' },
  { name: 'WhatsApp', logo: 'whatsapp.svg', note: 'Conversas com clientes que nunca viraram e-mail.', href: '' },
];

const books = [
  { name: "Don't Make Me Think", note: 'Steve Krug. O clássico sobre usabilidade web. Essencial para qualquer designer.', href: '' },
  { name: 'Win Without Pitching Manifesto', note: 'Blair Enns. Como se posicionar e parar de competir por preço.', href: '' },
  { name: 'Rework', note: 'Jason Fried & DHH. Uma forma diferente de pensar sobre trabalho e construção de produtos.', href: '' },
  { name: 'The Art of Thinking in Graphs', note: 'Pensamento visual e resolução estruturada de problemas.', href: '' },
  { name: 'Princípio de UX', note: 'Daniel Furtado. UX em português, com pé no chão e aplicação prática.', href: '' },
  { name: 'Fall in Love with the Problem, Not the Solution', note: 'Uri Levine. Sobre construir produtos que resolvem problemas reais.', href: '' },
  { name: 'Articulando Decisões de Design', note: 'Tom Greever. Como defender uma decisão de design para quem não é designer.', href: '' },
  { name: '$100M Offers', note: 'Alex Hormozi. Como montar uma oferta que se explica sozinha.', href: '' },
  { name: 'The Personal MBA', note: 'Josh Kaufman. Os fundamentos de negócio que faltam em quem vem do design.', href: '' },
  { name: 'Primalbranding', note: 'Patrick Hanlon. Por que algumas marcas viram crença e outras viram commodity.', href: '' },
  { name: 'Qual é o seu problema?', note: 'Thomas Wedell-Wedellsborg. Reenquadrar o problema antes de sair resolvendo.', href: '' },
  { name: 'Maestria', note: 'Robert Greene. Sobre o tempo que leva para ficar bom em alguma coisa.', href: '' },
];
const total = hardware.length + design.length + dev.length + productivity.length + books.length;
---

<SiteLayout title="Stack — Miguel Moraes" description="Hardwares, softwares e livros que realmente uso no dia a dia.">
  <div class="page">


    <header class="page-header">
      <h1 class="page-title">Stack</h1>
      <p class="page-intro">Hardwares, softwares e livros que realmente uso no dia a dia — sem lista de desejos.</p>
    </header>

    <Filters
      allCount={total}
      options={[
        { label: 'Hardware', value: 'hardware', count: hardware.length },
        { label: 'Design', value: 'design', count: design.length },
        { label: 'Dev', value: 'dev', count: dev.length },
        { label: 'Produtividade', value: 'productivity', count: productivity.length },
        { label: 'Livros', value: 'books', count: books.length },
      ]}
    />

    <section class="section" data-tags="hardware">
      <h2 class="section-title">Hardware</h2>
      <ul class="list">
        {hardware.map(item => (
          <li class="item">
            <div class="item-text">
              <span class="item-name">
                {item.name}
                {item.logo && <span class="logo"><img src={`/stack/logos/${item.logo}`} alt="" width="20" height="20" loading="lazy" /></span>}
              </span>
              <span class="item-note">{item.note}</span>
            </div>
            {item.href && (
              <a href={item.href} target="_blank" rel="noopener" class="item-link" aria-label={`Ver ${item.name}`}>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="section" data-tags="design">
      <h2 class="section-title">Design</h2>
      <ul class="list">
        {design.map(item => (
          <li class="item">
            <div class="item-text">
              <span class="item-name">
                {item.name}
                {item.logo && <span class="logo"><img src={`/stack/logos/${item.logo}`} alt="" width="20" height="20" loading="lazy" /></span>}
              </span>
              <span class="item-note">{item.note}</span>
            </div>
            {item.href && (
              <a href={item.href} target="_blank" rel="noopener" class="item-link" aria-label={`Ver ${item.name}`}>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="section" data-tags="dev">
      <h2 class="section-title">Dev</h2>
      <ul class="list">
        {dev.map(item => (
          <li class="item">
            <div class="item-text">
              <span class="item-name">
                {item.name}
                {item.logo && <span class="logo"><img src={`/stack/logos/${item.logo}`} alt="" width="20" height="20" loading="lazy" /></span>}
              </span>
              <span class="item-note">{item.note}</span>
            </div>
            {item.href && (
              <a href={item.href} target="_blank" rel="noopener" class="item-link" aria-label={`Ver ${item.name}`}>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="section" data-tags="productivity">
      <h2 class="section-title">Produtividade</h2>
      <ul class="list">
        {productivity.map(item => (
          <li class="item">
            <div class="item-text">
              <span class="item-name">
                {item.name}
                {item.logo && <span class="logo"><img src={`/stack/logos/${item.logo}`} alt="" width="20" height="20" loading="lazy" /></span>}
              </span>
              <span class="item-note">{item.note}</span>
            </div>
            {item.href && (
              <a href={item.href} target="_blank" rel="noopener" class="item-link" aria-label={`Ver ${item.name}`}>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="section" data-tags="books">
      <h2 class="section-title">Livros</h2>
      <ul class="list">
        {books.map(item => (
          <li class="item">
            <div class="item-text">
              <span class="item-name">
                {item.name}
                {item.logo && <span class="logo"><img src={`/stack/logos/${item.logo}`} alt="" width="20" height="20" loading="lazy" /></span>}
              </span>
              <span class="item-note">{item.note}</span>
            </div>
            {item.href && (
              <a href={item.href} target="_blank" rel="noopener" class="item-link" aria-label={`Ver ${item.name}`}>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

  </div>
</SiteLayout>

<style>

  .item-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Mesmo chip da Career, um degrau menor: aqui ele acompanha um nome curto */
  .logo {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: #ffffff;
    overflow: hidden;
    line-height: 0;
  }

  .logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Menos que o --section-gap padrão: as listas daqui são caixas com borda,
     então já têm limite visual próprio e não dependem tanto do vazio */
  .page {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: var(--prose-max-width);
  }

  /* O gap de 40px é o respiro entre categorias; o filtro pertence ao bloco do
     header e usa o mesmo espaço que Projects e Career */

  .page > :global(.filters) {
    margin-top: calc(var(--block-gap) - 40px);
  }







  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Link esticado: o <a> continua sendo só a seta, então o leitor de tela
     anuncia um link nomeado, mas a área de clique cobre a linha inteira.
     Mesmo padrão do .row--link em sections.css */
  .item-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (hover: hover) {
    .item:has(.item-link):hover .item-name {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  @media (hover: hover) {
    .item:has(.item-link):hover .item-link {
      color: var(--color-title);
    }
  }

  .item:last-child {
    border-bottom: none;
  }

  .item-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .item-name {
    font-size: var(--font-size-body);
    color: var(--color-title);
    line-height: 1.4;
  }

  .item-note {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .item-link {
    color: var(--color-muted);
    flex-shrink: 0;
    padding: 4px;
    transition: color 0.15s;
  }

  @media (hover: hover) {
    .item-link:hover {
      color: var(--color-title);
    }
  }
</style>
