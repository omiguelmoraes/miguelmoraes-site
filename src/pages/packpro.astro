---
const kiwify = 'https://pay.kiwify.com.br/FNeJdk9';
const instagram = 'https://instagram.com/omiguelmoraes';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <title>PackPro — Templates para Freelancers</title>
  <meta name="description" content="Contrato, proposta e orçamento prontos para personalizar e usar em minutos. Para de perder tempo criando do zero." />
  <link rel="canonical" href="https://miguelmoraes.pro/packpro" />
  <meta property="og:title" content="PackPro — Templates para Freelancers" />
  <meta property="og:description" content="Contrato, proposta e orçamento prontos para personalizar e usar em minutos." />
  <meta property="og:url" content="https://miguelmoraes.pro/packpro" />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": "PackPro — Templates para Freelancers",
      "image": "https://miguelmoraes.pro/og-packpro.png",
      "description": "Templates profissionais de Contrato, Proposta e Orçamento no Figma para freelancers.",
      "brand": {
        "@type": "Brand",
        "name": "PackPro"
      },
      "offers": {
        "@type": "Offer",
        "url": "https://miguelmoraes.pro/packpro",
        "priceCurrency": "BRL",
        "price": "37.00",
        "availability": "https://schema.org/InStock"
      }
    }
  </script>
</head>
<body>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {Array(10).fill(null).map(() => (
      <><span translate="no">PackPro</span><span class="dot">·</span><span>R$37 uma vez</span><span class="dot">·</span><span>3 templates no Figma</span><span class="dot">·</span><span>Acesso imediato</span><span class="dot">·</span></>
    ))}
  </div>
</div>

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <span class="eyebrow">
        <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
        Templates para Freelancers
      </span>
      <h1 class="hero-title"><span>Documentos prontos.</span><span>Projetos fechados.</span></h1>
      <p class="hero-sub">Contrato, proposta e orçamento no Figma. Personalize e envie em minutos, não horas.</p>
      <a href={kiwify} target="_blank" rel="noopener" class="btn-primary">
        Garantir por R$37 →
      </a>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="doc-row">
        <div class="doc">
          <div class="doc-header"><span>NOME / MARCA</span><span>XX/XX</span></div>
          <div class="doc-title">CONTRATO DE SERVIÇOS</div>
          <div class="doc-divider"></div>
          <div class="doc-line" style="width:100%"></div>
          <div class="doc-line" style="width:80%"></div>
          <div class="doc-line" style="width:60%"></div>
        </div>
        <div class="doc doc--featured">
          <div class="doc-header"><span>NOME / MARCA</span><span>XX/XX</span></div>
          <div class="doc-title">PROPOSTA COMERCIAL</div>
          <div class="doc-divider"></div>
          <div class="doc-line" style="width:100%"></div>
          <div class="doc-line" style="width:90%"></div>
          <div class="doc-line" style="width:70%"></div>
        </div>
        <div class="doc">
          <div class="doc-header"><span>NOME / MARCA</span><span>XX/XX</span></div>
          <div class="doc-title">ORÇAMENTO</div>
          <div class="doc-divider"></div>
          <div class="doc-line" style="width:100%"></div>
          <div class="doc-line" style="width:80%"></div>
          <div class="doc-line" style="width:40%"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <span class="section-eyebrow">
      <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
      Benefícios
    </span>
    <h2 class="section-title">Por que usar o PackPro?</h2>
    <div class="bento bento--benefits">
      <div class="bento-card">
        <i class="ph ph-timer bento-icon"></i>
        <h3 class="bento-name">Economia de Tempo</h3>
        <p class="bento-desc">Menos burocracia, mais tempo para criar o que importa.</p>
      </div>
      <div class="bento-card">
        <i class="ph ph-stack bento-icon"></i>
        <h3 class="bento-name">Organização</h3>
        <p class="bento-desc">Processos claros e alinhados com o cliente.</p>
      </div>
      <div class="bento-card">
        <i class="ph ph-briefcase bento-icon"></i>
        <h3 class="bento-name">Profissionalismo</h3>
        <p class="bento-desc">Feche projetos com mais autoridade visual.</p>
      </div>
      <div class="bento-card">
        <i class="ph ph-lightning bento-icon"></i>
        <h3 class="bento-name">Pronto para Usar</h3>
        <p class="bento-desc">Personalize e envie em poucos minutos.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <span class="section-eyebrow"><svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>Entrega</span>
    <h2 class="section-title">O que vem no PackPro?</h2>
    <div class="comparison-list">
      <div class="comparison-item"><span>Template de Orçamento</span><span class="old-price">R$97</span></div>
      <div class="comparison-item"><span>Template de Proposta</span><span class="old-price">R$147</span></div>
      <div class="comparison-item"><span>Template de Contrato</span><span class="old-price">R$147</span></div>
      <div class="comparison-item comparison-item--total"><span>PackPro</span><span class="final-price">R$37</span></div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="pricing-card">
      <span class="pricing-badge">Oferta Exclusiva</span>
      <div class="pricing-price">R$37</div>
      <p class="pricing-sub">Pague uma vez. Use para sempre.</p>
      <ul class="checklist">
        <li><i class="ph ph-check"></i> Acesso imediato</li>
        <li><i class="ph ph-check"></i> Atualizações gratuitas</li>
        <li><i class="ph ph-check"></i> 7 dias de garantia</li>
        <li><i class="ph ph-check"></i> Figma file</li>
      </ul>
      <a href={kiwify} target="_blank" rel="noopener" class="btn-primary">Garantir por R$37 →</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <span class="section-eyebrow">FAQ</span>
    <h2 class="section-title">Dúvidas frequentes</h2>
    <div class="faq">
      <details class="faq-item">
        <summary class="faq-q">Por que eu preciso do PackPro se já faço tudo manualmente? <span>→</span></summary>
        <p class="faq-a">Fazer manualmente funciona, mas custa tempo — e tempo de freelancer é dinheiro. Com o PackPro, você personaliza e envia em minutos, não horas.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Os templates são fáceis de personalizar? <span>→</span></summary>
        <p class="faq-a">Sim. Tudo foi criado no Figma, com campos claros para substituir. Troque nome, logo, cores e dados do cliente em poucos cliques.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Como isso vai me ajudar a fechar mais projetos? <span>→</span></summary>
        <p class="faq-a">Uma proposta bem apresentada transmite confiança. O cliente percebe profissionalismo — e isso pesa na decisão de fechar com você.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Funciona para qualquer área de atuação? <span>→</span></summary>
        <p class="faq-a">Sim. Os templates funcionam para designers, desenvolvedores, redatores, social media e qualquer freelancer criativo.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Posso usar os templates quantas vezes quiser? <span>→</span></summary>
        <p class="faq-a">Sim. Após a compra, o acesso é permanente. Use em quantos projetos precisar, para sempre.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">E se eu não gostar ou achar que não atende minhas necessidades? <span>→</span></summary>
        <p class="faq-a">Você tem 7 dias de garantia. Se não ficar satisfeito, devolvemos seu dinheiro sem perguntas.</p>
      </details>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="about-grid">
      <h2 class="about-title">Feito por quem viveu o problema.</h2>
      <div class="about-content">
        <p>Desde que comecei na área de Design em 2021, percebi o quanto tarefas operacionais — contratos, propostas, orçamentos — ocupavam meu tempo. Eram essenciais, mas me afastavam do que realmente importava.</p>
        <p>O PackPro nasceu disso. Materiais prontos, práticos e adaptáveis, para você focar no que gera resultado.</p>
        <div class="about-btns">
          <a href={instagram} target="_blank" rel="noopener" class="btn-ghost">Me siga no Instagram →</a>
          <a href={kiwify} target="_blank" rel="noopener" class="btn-primary">Comprar agora →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <p><a href="/links" target="_blank" rel="noopener" class="footer-link">Miguel Moraes</a> © 2026 Todos os direitos reservados.</p>
</footer>

<div class="sticky-cta" id="sticky-cta">
  <span class="sticky-cta-text">Templates prontos por R$37</span>
  <a href={kiwify} target="_blank" rel="noopener" class="btn-primary" style="padding: 10px 20px; font-size: 14px;">
    Comprar agora →
  </a>
</div>

</body>
</html>

<script>
  const stickyCta = document.getElementById('sticky-cta')!;
  const hero = document.querySelector('.hero')!;
  const observer = new IntersectionObserver(([e]) => stickyCta.classList.toggle('visible', !e.isIntersecting), { threshold: 0 });
  observer.observe(hero);
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #050505;
    --bg-alt: #000000;
    --surface: #0a0a0a;
    --border: rgba(255,255,255,0.06);
    --border-strong: rgba(255,255,255,0.12);
    --text: #FFFFFF;
    --muted: #888888;
    --accent: #2563EB;
    --font-mono: 'JetBrains Mono', monospace;
    --radius: 2px;
  }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .container { max-width: 900px; margin: 0 auto; padding: 0 24px; }
  
  .ticker { background: #000; border-bottom: 1px solid var(--border); padding: 12px 0; overflow: hidden; font-size: 11px; }
  .ticker-track { display: flex; gap: 24px; width: max-content; animation: ticker 40s linear infinite; }
  @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .dot { color: var(--accent); }

  .hero {
    padding: 120px 0 80px;
    background: radial-gradient(circle at 50% -20%, rgba(37, 99, 235, 0.15) 0%, transparent 50%);
    position: relative;
    border-bottom: 1px solid var(--border);
  }
  .hero::before {
    content: ""; position: absolute; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.document.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.04; pointer-events: none;
  }
  .hero-content { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 24px; margin-bottom: 64px; }
  .hero-title { font-size: clamp(32px, 5vw, 64px); font-weight: 500; line-height: 1.1; letter-spacing: -0.04em; }
  .hero-title span { display: block; }
  .hero-sub { color: var(--muted); max-width: 460px; font-size: 15px; }
  .eyebrow { font-size: 11px; text-transform: uppercase; color: var(--accent); display: flex; align-items: center; gap: 8px; }

  .hero-visual { position: relative; }
  .doc-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; align-items: end; }
  .doc { background: var(--surface); border: 1px solid var(--border); border-radius: 4px 4px 0 0; padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .doc--featured { border-color: rgba(37,99,235,0.3); padding-top: 32px; margin-bottom: -16px; box-shadow: 0 -10px 40px rgba(0,0,0,0.5); }
  .doc-header { display: flex; justify-content: space-between; font-size: 8px; color: var(--muted); }
  .doc-title { font-size: 11px; font-weight: 500; }
  .doc-divider { height: 1px; background: var(--border); }
  .doc-line { height: 4px; background: rgba(255,255,255,0.05); }

  .section { padding: 120px 0; }
  .section-alt { background: #000; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .section-eyebrow { font-size: 11px; color: var(--accent); text-transform: uppercase; margin-bottom: 16px; display: flex; justify-content: center; align-items: center; gap: 8px; width: 100%; }
  .section-title { font-size: clamp(24px, 4vw, 36px); font-weight: 500; margin-bottom: 48px; text-align: center; line-height: 1.2; width: 100%; }

  .bento { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .bento-card { background: var(--surface); border: 1px solid var(--border); padding: 32px; border-radius: 2px; }
  .bento-icon { font-size: 24px; color: var(--accent); margin-bottom: 16px; display: block; }
  .bento-name { font-size: 18px; margin-bottom: 8px; font-weight: 500; }
  .bento-desc { color: var(--muted); font-size: 14px; }


  .comparison-list {
    max-width: 540px;
    margin: 0 auto;
    border: 1px solid var(--border);
    background: #080808;
    padding: 40px;
    position: relative;
    border-radius: 2px;
  }

  .comparison-list::before {
    content: "";
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 2px;
    background: var(--accent);
    opacity: 0.8;
  }

  .comparison-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px dashed var(--border);
    font-size: 13px;
    color: var(--muted);
    transition: color 0.2s;
  }

  .comparison-item:hover { color: var(--text); }

  .comparison-item .old-price {
    text-decoration: line-through;
    opacity: 0.4;
    font-size: 12px;
  }

  .comparison-item--total {
    padding-top: 32px;
    margin-top: 16px;
    border-bottom: none;
    color: var(--text);
  }

  .comparison-item--total span:first-child {
    font-weight: 600;
    font-size: 16px;
    color: #fff;
  }

  .final-price {
    font-size: 32px;
    font-weight: 700;
    color: var(--accent);
    text-shadow: 0 0 20px rgba(37, 99, 235, 0.3);
  }


  .pricing-card { max-width: 440px; margin: 0 auto; background: var(--surface); border: 1px solid rgba(37,99,235,0.2); padding: 56px; text-align: center; }
  .pricing-price { font-size: 64px; font-weight: 500; margin-bottom: 8px; }
  .pricing-badge { font-size: 10px; background: rgba(37,99,235,0.1); border: 1px solid rgba(37,99,235,0.2); padding: 4px 12px; margin-bottom: 24px; display: inline-block; }
  .pricing-sub { color: var(--muted); margin-bottom: 32px; }
  .checklist { text-align: left; margin-bottom: 32px; list-style: none; }
  .checklist li { display: flex; align-items: center; gap: 12px; padding: 4px 0; color: var(--muted); }
  .checklist li i { color: var(--accent); }

  .faq { max-width: 600px; margin: 0 auto; }
  .faq-item { border: 1px solid var(--border); border-radius: 2px; margin-bottom: 8px; background: var(--surface); overflow: hidden; }
  .faq-q { padding: 20px 24px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; }
  .faq-q span { transition: transform 0.3s; opacity: 0.4; }
  details[open] .faq-q span { transform: rotate(90deg); }
  .faq-a { padding: 0 24px 20px; color: var(--muted); font-size: 13px; animation: fadeIn 0.3s ease; }

  .about-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 64px; align-items: start; }
  .about-title { font-size: 28px; font-weight: 500; line-height: 1.2; }
  .about-content p { color: var(--muted); margin-bottom: 20px; }
  .about-btns { display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap; }

  .btn-primary { background: var(--accent); color: #fff; padding: 12px 24px; border-radius: 2px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; transition: opacity 0.2s; white-space: nowrap; }
  .btn-ghost { border: 1px solid var(--border-strong); color: #fff; padding: 12px 24px; border-radius: 2px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; transition: border-color 0.2s; white-space: nowrap; }
  .btn-primary:hover { opacity: 0.9; }
  .btn-ghost:hover { border-color: var(--text); }

  .sticky-cta { 
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(120%); 
    background: rgba(10,10,10,0.95); backdrop-filter: blur(12px); border: 1px solid var(--border-strong); 
    padding: 8px 8px 8px 24px; display: flex; align-items: center; gap: 24px; border-radius: 2px;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1); z-index: 100;
  }
  .sticky-cta.visible { transform: translateX(-50%) translateY(0); }
  .sticky-cta-text { font-size: 13px; color: var(--muted); white-space: nowrap; }

  .footer { padding: 80px 24px 120px; text-align: center; color: var(--muted); font-size: 12px; border-top: 1px solid var(--border); }
  .footer-link { color: var(--text); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .footer-link:hover { border-color: var(--accent); }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  @media (max-width: 720px) {
    .container { padding: 0 20px; }
    .hero { padding-top: 80px; padding-bottom: 40px; }
    .hero-visual { display: none; }
    .hero-title { font-size: clamp(24px, 8vw, 32px); }
    .bento, .bento--benefits { grid-template-columns: 1fr; }
    .about-grid { grid-template-columns: 1fr; gap: 32px; }
    .btn-primary, .btn-ghost { width: 100%; }
    .sticky-cta { bottom: 0; left: 0; right: 0; width: 100%; border-radius: 0; border: none; border-top: 1px solid var(--border-strong); padding: 12px 20px; }
    .sticky-cta-text { display: none; }
  }
</style>
</body>
</html>
