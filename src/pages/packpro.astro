<script>
  const stickyCta = document.getElementById('sticky-cta')!;
  const hero = document.querySelector('.hero')!;
  const finalCta = document.querySelector('.final-cta')!;

  let heroOut = false;
  let finalCtaIn = false;

  function updateSticky() {
    stickyCta.classList.toggle('visible', heroOut && !finalCtaIn);
  }

  const heroObserver = new IntersectionObserver(([e]) => {
    heroOut = !e.isIntersecting;
    updateSticky();
  }, { threshold: 0 });

  const finalCtaObserver = new IntersectionObserver(([e]) => {
    finalCtaIn = e.isIntersecting;
    updateSticky();
  }, { threshold: 0 });

  heroObserver.observe(hero);
  finalCtaObserver.observe(finalCta);
</script>

