---
import { Font } from 'astro:assets';

const kiwify = 'https://pay.kiwify.com.br/FNeJdk9';
const instagram = 'https://instagram.com/omiguelmoraes';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>PackPro — Templates para Freelancers | Contrato, Proposta e Orçamento no Figma</title>
  <meta name="description" content="3 templates profissionais no Figma para freelancers fecharem mais projetos. Contrato, proposta e orçamento prontos para personalizar e enviar em minutos." />
  <link rel="canonical" href="https://miguelmoraes.pro/packpro" />
  <meta property="og:title" content="PackPro — Pareça uma agência. Sendo só você." />
  <meta property="og:description" content="Contrato, proposta e orçamento prontos no Figma. Personalize e envie em minutos — não em horas." />
  <meta property="og:url" content="https://miguelmoraes.pro/packpro" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://miguelmoraes.pro/og-packpro.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <Font cssVariable="--font-inter-tight" preload />
  <Font cssVariable="--font-geist-mono" />
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": "PackPro — Templates para Freelancers",
      "image": "https://miguelmoraes.pro/og-packpro.png",
      "description": "Templates profissionais de Contrato, Proposta e Orçamento no Figma para freelancers fecharem mais projetos.",
      "brand": { "@type": "Brand", "name": "PackPro" },
      "offers": {
        "@type": "Offer",
        "url": "https://miguelmoraes.pro/packpro",
        "priceCurrency": "BRL",
        "price": "37.00",
        "availability": "https://schema.org/InStock"
      }
    }
  </script>

  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1577513524086938');
    fbq('track', 'PageView');
  </script>
  <!-- End Meta Pixel Code -->

  <script is:inline>
    document.addEventListener('click', function (e) {
      if (!(e.target instanceof Element)) return;
      if (!e.target.closest('a[href*="pay.kiwify.com.br"]')) return;
      if (window.fbq) fbq('track', 'InitiateCheckout', { value: 37.00, currency: 'BRL' });
    });
  </script>
</head>
<body>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {Array(10).fill(null).map(() => (
      <><span translate="no">PackPro</span><span class="dot">·</span><span>+200 freelancers usando</span><span class="dot">·</span><span>R$37 pagamento único</span><span class="dot">·</span><span>3 templates no Figma</span><span class="dot">·</span><span>3 bônus inclusos</span><span class="dot">·</span></>
    ))}
  </div>
</div>

<!-- 1. HERO (White) -->
<section class="hero">
  <div class="container hero-inner">
    <span class="eyebrow">
      <span class="pulse-dot"></span>
      KIT DE DOCUMENTOS NO FIGMA + BÔNUS
    </span>
    <h1 class="hero-title">
      Pareça uma agência.<br />Cobre como uma.
    </h1>
    <p class="hero-sub">Proposta comercial, contrato e orçamento prontos no Figma. Envie documentos impecáveis em 5 minutos e feche projetos de maior valor.</p>

    <a href={kiwify} target="_blank" rel="noopener" class="btn-primary btn-hero">
      Garantir os 3 templates por R$37 →
    </a>
    
    <div class="trust-group">
      <div class="trust-bar">
        <span>✓ De <s style="opacity: 0.45;">R$552</s> por <strong>R$37</strong></span>
        <span class="t-sep">·</span>
        <span>✓ 7 dias de garantia</span>
        <span class="t-sep">·</span>
        <span>✓ +200 freelancers</span>
        <span class="t-sep">·</span>
        <span>✓ Acesso imediato</span>
      </div>
    </div>
  </div>
</section>

<!-- 2. NUMBERS BAR (Clean & Minimalist) -->
<div class="numbers-bar">
  <div class="container">
    <div class="numbers-wrapper">
      <div class="numbers-grid">
        <div class="number-item">
          <span class="number-val">200+</span>
          <span class="number-label">freelancers ativos</span>
        </div>
        <div class="number-item">
          <span class="number-val">3 em 1</span>
          <span class="number-label">proposta, contrato e orçamento</span>
        </div>
        <div class="number-item">
          <span class="number-val">5 min</span>
          <span class="number-label">para personalizar e enviar</span>
        </div>
        <div class="number-item">
          <span class="number-val">R$37</span>
          <span class="number-label">pagamento único para sempre</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 3. SHOWCASE DOS 3 TEMPLATES (White) -->
<section class="section section-showcase">
  <div class="container">
    <span class="section-eyebrow">
      <i class="ph ph-figma-logo"></i> ARQUIVOS EDITÁVEIS
    </span>
    <h2 class="section-title section-title--has-sub">3 documentos essenciais. Prontos para duplicar.</h2>
    <p class="section-sub">Estrutura visual profissional criada no Figma com componentes limpos, tipografia ajustada e suporte a Modo Claro e Escuro.</p>

    <div class="scroll-hint-mobile" aria-hidden="true">
      <span>Deslize para ver todos</span> <i class="ph ph-arrow-right"></i>
    </div>

    <div class="templates-scroll-wrapper">
      <div class="templates-grid">
        <!-- CARD 1 -->
        <div class="template-card">
          <div class="card-header-bar">
            <span class="card-meta"><i class="ph ph-figma-logo"></i> FIGMA FILE</span>
            <span class="card-tag">TEMPLATE 01</span>
          </div>
          <h3 class="card-title">Proposta Comercial</h3>
          <p class="card-desc">O documento que justifica o seu preço e posiciona você no topo desde o primeiro contato.</p>
          <ul class="card-list">
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Versões em Modo Claro e Escuro</span>
            </li>
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Apresentação, escopo & cronograma</span>
            </li>
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Tabela de investimento transparente</span>
            </li>
          </ul>
        </div>

        <!-- CARD 2 -->
        <div class="template-card">
          <div class="card-header-bar">
            <span class="card-meta"><i class="ph ph-figma-logo"></i> FIGMA FILE</span>
            <span class="card-tag">TEMPLATE 02</span>
          </div>
          <h3 class="card-title">Contrato de Serviços</h3>
          <p class="card-desc">Sua blindagem contra refações infinitas, prazos estourados e calotes de pagamento.</p>
          <ul class="card-list">
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Cláusulas de pagamento & atrasos</span>
            </li>
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Limite de revisões estipulado</span>
            </li>
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Propriedade dos arquivos finais</span>
            </li>
          </ul>
        </div>

        <!-- CARD 3 -->
        <div class="template-card">
          <div class="card-header-bar">
            <span class="card-meta"><i class="ph ph-figma-logo"></i> FIGMA FILE</span>
            <span class="card-tag">TEMPLATE 03</span>
          </div>
          <h3 class="card-title">Orçamento Rápido</h3>
          <p class="card-desc">Respostas ágeis para demandas diretas sem perder o peso e o alinhamento profissional.</p>
          <ul class="card-list">
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Estrutura enxuta de 1 página</span>
            </li>
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Resposta em minutos para o lead</span>
            </li>
            <li>
              <span class="card-check">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3L4.5 8.5L2 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Visual alinhado ao seu estúdio</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 4. ANTES VS DEPOIS (Wash #F8F8FA) -->
<section class="section section-wash">
  <div class="container">
    <span class="section-eyebrow">
      <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
      A virada de chave
    </span>
    <h2 class="section-title section-title--has-sub">O que muda na sua rotina de vendas</h2>
    <p class="section-sub">A diferença entre mandar uma mensagem informal e apresentar uma proposta de nível corporativo.</p>

    <div class="before-after-grid">
      <!-- ANTES CARD -->
      <div class="ba-card ba-card--before">
        <div class="ba-badge ba-badge--before">
          <i class="ph ph-x-circle"></i> ANTES DO PACKPRO
        </div>
        <ul class="ba-list">
          <li>
            <span class="ba-icon ba-icon--before">✕</span>
            <span>Orçamento solto enviado no chat do WhatsApp</span>
          </li>
          <li>
            <span class="ba-icon ba-icon--before">✕</span>
            <span>PDFs genéricos ou desalinhados no Canva</span>
          </li>
          <li>
            <span class="ba-icon ba-icon--before">✕</span>
            <span>Sem contrato: cliente pede refações infinitas</span>
          </li>
          <li>
            <span class="ba-icon ba-icon--before">✕</span>
            <span>Sensação de amadorismo e cliente pechinchando</span>
          </li>
        </ul>
      </div>

      <!-- DEPOIS CARD -->
      <div class="ba-card ba-card--after">
        <div class="ba-badge ba-badge--after">
          <i class="ph ph-check-circle"></i> COM O PACKPRO
        </div>
        <ul class="ba-list">
          <li>
            <span class="ba-icon ba-icon--after">✓</span>
            <span>Proposta visual impecável no Figma pronta em 5 min</span>
          </li>
          <li>
            <span class="ba-icon ba-icon--after">✓</span>
            <span>Apresentação corporativa que justifica o seu preço</span>
          </li>
          <li>
            <span class="ba-icon ba-icon--after">✓</span>
            <span>Contrato blindado com prazos e limite de alterações</span>
          </li>
          <li>
            <span class="ba-icon ba-icon--after">✓</span>
            <span>Posicionamento de agência e autoridade total</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 5. BENTO GRID (White) -->
<section class="section">
  <div class="container">
    <span class="section-eyebrow">
      <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
      Por que sua proposta falha hoje
    </span>
    <h2 class="section-title">Chega de perder projetos por parecer amador.</h2>
    <div class="bento">
      <div class="bento-card">
        <div class="bento-icon-wrap"><i class="ph ph-sparkle bento-icon"></i></div>
        <h3 class="bento-name">Autoridade Instantânea</h3>
        <p class="bento-desc">Esqueça mensagem solta no WhatsApp ou PDF feio. Entregue propostas visuais que justificam o seu valor e encantam de cara.</p>
      </div>
      <div class="bento-card">
        <div class="bento-icon-wrap"><i class="ph ph-shield-check bento-icon"></i></div>
        <h3 class="bento-name">Blindagem de Escopo</h3>
        <p class="bento-desc">Contrato com cláusulas claras de pagamento, prazo e limites de revisão. Evite pedidos infinitos e dor de cabeça com clientes.</p>
      </div>
      <div class="bento-card">
        <div class="bento-icon-wrap"><i class="ph ph-lightning bento-icon"></i></div>
        <h3 class="bento-name">Zero Perda de Tempo</h3>
        <p class="bento-desc">Templates prontos e organizados em componentes no Figma. Altere nome, logo e valores em minutos, exporte em PDF e pronto.</p>
      </div>
      <div class="bento-card">
        <div class="bento-icon-wrap"><i class="ph ph-trend-up bento-icon"></i></div>
        <h3 class="bento-name">Retorno no 1º Cliente</h3>
        <p class="bento-desc">Se a sua nova proposta fechar um único projeto a mais, o investimento de R$37 se paga mais de 50 vezes no mesmo dia.</p>
      </div>
    </div>
  </div>
</section>

<!-- 6. TUDO INCLUSO / COMPARATIVO (Wash #F8F8FA) -->
<section class="section section-wash">
  <div class="container">
    <span class="section-eyebrow">
      <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
      Tudo incluso + Bônus
    </span>
    <h2 class="section-title">O que você recebe no PackPro</h2>
    <div class="comparison-card">
      <div class="comparison-header">
        <div class="notion-dot-group">
          <span class="n-dot"></span><span class="n-dot"></span><span class="n-dot"></span>
        </div>
        <span class="comparison-tag">Estrutura Completa Figma + Bônus</span>
      </div>
      <div class="comparison-list">
        <!-- FIGMA TEMPLATES -->
        <div class="comparison-item">
          <div class="item-info">
            <span class="item-icon"><i class="ph ph-presentation-chart"></i></span>
            <div>
              <span class="item-name">Template de Proposta Comercial</span>
              <span class="item-desc">Apresentação, escopo, cronograma, investimento e termos (Dark & Light Mode)</span>
            </div>
          </div>
          <span class="old-price">R$147</span>
        </div>
        <div class="comparison-item">
          <div class="item-info">
            <span class="item-icon"><i class="ph ph-article"></i></span>
            <div>
              <span class="item-name">Template de Contrato de Serviços</span>
              <span class="item-desc">Cláusulas essenciais de pagamento, prazos, refações e propriedade intelectual</span>
            </div>
          </div>
          <span class="old-price">R$147</span>
        </div>
        <div class="comparison-item">
          <div class="item-info">
            <span class="item-icon"><i class="ph ph-file-text"></i></span>
            <div>
              <span class="item-name">Template de Orçamento Rápido</span>
              <span class="item-desc">Documento enxuto para respostas ágeis sem perder o alinhamento profissional</span>
            </div>
          </div>
          <span class="old-price">R$97</span>
        </div>

        <!-- BONUS ITEMS -->
        <div class="comparison-item comparison-item--bonus">
          <div class="item-info">
            <span class="item-icon item-icon--bonus"><i class="ph ph-gift"></i></span>
            <div>
              <span class="item-name">BÔNUS 1: Checklist de Briefing Anti-Refação <span class="badge-bonus">PDF</span></span>
              <span class="item-desc">15 perguntas essenciais para alinhar antes do orçamento e nunca ter refação surpresa</span>
            </div>
          </div>
          <span class="old-price">R$47</span>
        </div>
        <div class="comparison-item comparison-item--bonus">
          <div class="item-info">
            <span class="item-icon item-icon--bonus"><i class="ph ph-calculator"></i></span>
            <div>
              <span class="item-name">BÔNUS 2: Calculadora Web de Precificação <span class="badge-bonus">Página Web</span></span>
              <span class="item-desc">Ferramenta onde você insere seus custos e meta financeira e recebe o valor exato da sua hora</span>
            </div>
          </div>
          <span class="old-price">R$67</span>
        </div>
        <div class="comparison-item comparison-item--bonus">
          <div class="item-info">
            <span class="item-icon item-icon--bonus"><i class="ph ph-chats-teardrop"></i></span>
            <div>
              <span class="item-name">BÔNUS 3: Script de Fechamento & Objeções <span class="badge-bonus">PDF</span></span>
              <span class="item-desc">Modelos de mensagem para WhatsApp/E-mail e como responder se o cliente pedir desconto</span>
            </div>
          </div>
          <span class="old-price">R$47</span>
        </div>

        <div class="comparison-item comparison-item--total">
          <div>
            <span class="total-label">PackPro Completo + 3 Bônus</span>
            <span class="total-sub">Todos os 3 templates no Figma + Calculadora Web + 2 Guia PDFs</span>
          </div>
          <div class="price-wrapper">
            <span class="price-strike">R$552</span>
            <span class="final-price">R$37</span>
          </div>
        </div>
      </div>
    </div>
    <p class="comparison-note">Valor individual dos arquivos + bônus: R$552. Hoje no PackPro: R$37 sem mensalidades.</p>
  </div>
</section>

<!-- 7. PRICING CARD (White) -->
<section class="section">
  <div class="container">
    <div class="pricing-card">
      <span class="pricing-badge">OFERTA VITALÍCIA · R$37</span>
