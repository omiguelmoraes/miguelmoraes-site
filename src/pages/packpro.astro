---
import { Font } from 'astro:assets';

const kiwify = 'https://pay.kiwify.com.br/FNeJdk9';
const instagram = 'https://instagram.com/omiguelmoraes';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <title>PackPro — Templates para Freelancers | Contrato, Proposta e Orçamento no Figma</title>
  <meta name="description" content="3 templates profissionais no Figma para freelancers fecharem mais projetos. Contrato, proposta e orçamento prontos para personalizar e enviar em minutos." />
  <link rel="canonical" href="https://miguelmoraes.pro/packpro" />
  <meta property="og:title" content="PackPro — Pareça uma agência. Sendo só você." />
  <meta property="og:description" content="Contrato, proposta e orçamento prontos no Figma. Personalize e envie em minutos — não em horas." />
  <meta property="og:url" content="https://miguelmoraes.pro/packpro" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://miguelmoraes.pro/og-packpro.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <Font cssVariable="--font-inter-tight" preload />
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": "PackPro — Templates para Freelancers",
      "image": "https://miguelmoraes.pro/og-packpro.png",
      "description": "Templates profissionais de Contrato, Proposta e Orçamento no Figma para freelancers fecharem mais projetos.",
      "brand": { "@type": "Brand", "name": "PackPro" },
      "offers": {
        "@type": "Offer",
        "url": "https://miguelmoraes.pro/packpro",
        "priceCurrency": "BRL",
        "price": "37.00",
        "availability": "https://schema.org/InStock"
      }
    }
  </script>

  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1577513524086938');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1577513524086938&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->

  <script is:inline>
    document.addEventListener('click', function (e) {
      if (!(e.target instanceof Element)) return;
      if (!e.target.closest('a[href*="pay.kiwify.com.br"]')) return;
      if (window.fbq) fbq('track', 'InitiateCheckout', { value: 37.00, currency: 'BRL' });
    });
  </script>
</head>
<body>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {Array(10).fill(null).map(() => (
      <><span translate="no">PackPro</span><span class="dot">·</span><span>200+ freelancers</span><span class="dot">·</span><span>R$37 uma vez</span><span class="dot">·</span><span>3 templates no Figma</span><span class="dot">·</span><span>Acesso imediato</span><span class="dot">·</span></>
    ))}
  </div>
</div>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <span class="eyebrow">
        <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
        Templates para Freelancers
      </span>
      <h1 class="hero-title">
        <span>Cobre mais sem o</span>
        <span>cliente questionar.</span>
      </h1>
      <p class="hero-sub">Os 3 documentos que fazem você parecer uma agência: contrato, proposta e orçamento prontos no Figma.</p>
      <a href={kiwify} target="_blank" rel="noopener" class="btn-primary btn-hero">
        Garantir os 3 templates por R$37 →
      </a>
      <div class="trust-line">
        <span>✓ R$391 separados · R$37 tudo junto</span>
        <span class="trust-sep">·</span>
        <span>✓ 7 dias de garantia incondicional</span>
      </div>
      <div class="trust-line">
        <span>✓ 200+ freelancers</span>
        <span class="trust-sep">·</span>
        <span>✓ Acesso imediato</span>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="doc-stack">
        <div class="doc-card doc-card--back-left">
          <div class="doc-card-header"><span>SEU NOME / MARCA</span><span>XX/XX/2025</span></div>
          <div class="doc-card-title">CONTRATO DE PRESTAÇÃO DE SERVIÇOS</div>
        </div>
        <div class="doc-card doc-card--front">
          <div class="doc-card-header"><span>SEU NOME / MARCA</span><span>XX/XX/2025</span></div>
          <div class="doc-card-title">TEMPLATE DE PROPOSTA COMERCIAL</div>
        </div>
        <div class="doc-card doc-card--back-right">
          <div class="doc-card-header"><span>SEU NOME / MARCA</span><span>XX/XX/2025</span></div>
          <div class="doc-card-title">TEMPLATE DE ORÇAMENTO BÁSICO</div>
        </div>
        <div class="pill pill-1"><i class="ph ph-figma-logo"></i> Arquivo Figma</div>
        <div class="pill pill-2"><i class="ph ph-circle-half-tilt"></i> Modo claro + escuro</div>
        <div class="pill pill-3"><i class="ph ph-users"></i> 200+ freelancers</div>
        <div class="pill pill-4"><i class="ph ph-clock"></i> 5 min de setup</div>
      </div>
    </div>
  </div>
</section>

<div class="numbers-bar">
  <div class="container numbers-grid">
    <div class="number-item">
      <span class="number-val">200+</span>
      <span class="number-label">freelancers</span>
    </div>
    <div class="number-item">
      <span class="number-val">3</span>
      <span class="number-label">templates essenciais</span>
    </div>
    <div class="number-item">
      <span class="number-val">5 min</span>
      <span class="number-label">para personalizar</span>
    </div>
    <div class="number-item">
      <span class="number-val">R$37</span>
      <span class="number-label">pague uma vez</span>
    </div>
  </div>
</div>

<section class="section section-light">
  <div class="container">
    <span class="section-eyebrow">
      <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
      Por que funciona
    </span>
    <h2 class="section-title">Do improviso ao profissionalismo.</h2>
    <div class="bento">
      <div class="bento-card">
        <i class="ph ph-lightning bento-icon"></i>
        <h3 class="bento-name">Sem burocracia</h3>
        <p class="bento-desc">Menos tempo em documentos, mais tempo no que você realmente faz.</p>
      </div>
      <div class="bento-card">
        <i class="ph ph-seal-check bento-icon"></i>
        <h3 class="bento-name">Feche com confiança</h3>
        <p class="bento-desc">Uma proposta bem feita vale mais do que qualquer argumento de venda.</p>
      </div>
      <div class="bento-card">
        <i class="ph ph-users bento-icon"></i>
        <h3 class="bento-name">Cliente alinhado</h3>
        <p class="bento-desc">Com tudo documentado, você evita retrabalho, escopo aberto e guerra de preço.</p>
      </div>
      <div class="bento-card">
        <i class="ph ph-rocket-launch bento-icon"></i>
        <h3 class="bento-name">Funciona hoje</h3>
        <p class="bento-desc">Baixou, personalizou, enviou. Do zero ao cliente em 5 minutos.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <span class="section-eyebrow">
      <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
      Entrega
    </span>
    <h2 class="section-title">O que vem no PackPro?</h2>
    <div class="comparison-list">
      <div class="comparison-item"><span>Template de Orçamento</span><span class="old-price">R$97</span></div>
      <div class="comparison-item"><span>Template de Proposta Comercial</span><span class="old-price">R$147</span></div>
      <div class="comparison-item"><span>Template de Contrato</span><span class="old-price">R$147</span></div>
      <div class="comparison-item comparison-item--total">
        <div>
          <span class="total-label">PackPro</span>
          <span class="total-sub">tudo junto</span>
        </div>
        <span class="final-price">R$37</span>
      </div>
    </div>
    <p class="comparison-note">Valor separado: R$391. Você paga R$37 — uma vez, para sempre.</p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="pricing-card">
      <span class="pricing-badge">Oferta Exclusiva</span>
      <div class="pricing-price">R$37</div>
      <p class="pricing-sub">Pague uma vez. Use para sempre.</p>
      <ul class="checklist">
        <li><span class="check">✓</span> 3 templates editáveis no Figma</li>
        <li><span class="check">✓</span> Modo claro e escuro inclusos</li>
        <li><span class="check">✓</span> Acesso imediato após a compra</li>
        <li><span class="check">✓</span> Atualizações gratuitas</li>
        <li><span class="check">✓</span> 7 dias de garantia incondicional</li>
      </ul>
      <a href={kiwify} target="_blank" rel="noopener" class="btn-primary btn-full">
        Garantir os 3 templates por R$37 →
      </a>
      <p class="pricing-note">Se um projeto a mais fechar, já se pagou muitas vezes.</p>
    </div>
  </div>
</section>

<section class="section section-how">
  <div class="container">
    <span class="section-eyebrow">
      <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true"><circle cx="3" cy="3" r="3" fill="currentColor"/></svg>
      Como funciona
    </span>
    <h2 class="section-title">Do zero ao cliente em 3 passos.</h2>
    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <h3 class="step-title">Compra e acessa</h3>
        <p class="step-desc">Pagamento confirmado, link do Figma no e-mail. Acesso imediato — sem esperar, sem burocracia.</p>
      </div>
      <div class="step-divider" aria-hidden="true">→</div>
      <div class="step">
        <div class="step-num">02</div>
        <h3 class="step-title">Personaliza em minutos</h3>
        <p class="step-desc">Coloca seu nome, logo e cores. Os templates são editáveis — você não precisa saber Figma avançado.</p>
      </div>
      <div class="step-divider" aria-hidden="true">→</div>
      <div class="step">
        <div class="step-num">03</div>
        <h3 class="step-title">Envia e fecha</h3>
        <p class="step-desc">Exporta em PDF e manda pro cliente. Proposta profissional, contrato sólido, orçamento claro.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-light">
  <div class="container">
    <span class="section-eyebrow">FAQ</span>
    <h2 class="section-title">Dúvidas frequentes</h2>
    <div class="faq">
      <details class="faq-item">
        <summary class="faq-q">Funciona para qualquer área? <span>→</span></summary>
        <p class="faq-a">Sim. Designers, devs, redatores, social media, fotógrafos — qualquer freelancer criativo. Os templates são editáveis no Figma e adaptáveis para qualquer serviço.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Preciso saber usar Figma? <span>→</span></summary>
        <p class="faq-a">Conhecimento básico é suficiente. Se você consegue abrir um arquivo e trocar texto, já dá para usar. Não é preciso saber nada avançado.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Por que usar templates se já faço tudo manualmente? <span>→</span></summary>
        <p class="faq-a">Fazer manualmente funciona, mas custa tempo — e tempo de freelancer é dinheiro. Com o PackPro você personaliza e envia em minutos, não em horas. O resultado também fica muito mais profissional.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Como recebo os templates após a compra? <span>→</span></summary>
        <p class="faq-a">Acesso imediato. Assim que o pagamento for confirmado, você recebe o link para o arquivo Figma por e-mail. É só abrir e começar a personalizar.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">Posso usar em quantos projetos quiser? <span>→</span></summary>
        <p class="faq-a">Sim. Pagou uma vez, usa para sempre — em quantos projetos precisar, com quantos clientes quiser.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">O contrato tem validade jurídica? <span>→</span></summary>
        <p class="faq-a">O contrato traz a estrutura e as cláusulas que um trabalho freelancer costuma precisar — escopo, prazo, pagamento, revisões e propriedade do material. É um modelo base pronto para você adaptar ao seu serviço, não uma peça revisada individualmente por advogado. Para contratos de valor alto ou situações específicas, vale a leitura de um profissional.</p>
      </details>
      <details class="faq-item">
        <summary class="faq-q">E se não atender minhas expectativas? <span>→</span></summary>
        <p class="faq-a">Você tem 7 dias de garantia incondicional. Se não ficar satisfeito por qualquer motivo, devolvemos seu dinheiro sem perguntas.</p>
      </details>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="about-grid">
      <div class="about-photo-wrap">
        <img src="/webp/avatar.webp" alt="Miguel Moraes" class="about-photo" />
      </div>
      <div class="about-content">
        <h2 class="about-title">Feito por quem viveu o problema.</h2>
        <p>Desde 2021 como designer freelancer, perdi horas montando contratos do zero, propostas no improviso e orçamentos no chute. Mais de uma vez senti que o cliente não levava a sério — porque minha documentação não transmitia profissionalismo.</p>
        <p>O PackPro nasceu disso. Para você chegar ao cliente com confiança desde o primeiro contato — sem perder tempo, sem parecer amador.</p>
        <div class="about-btns">
          <a href={instagram} target="_blank" rel="noopener" class="btn-ghost">Me siga no Instagram →</a>
          <a href={kiwify} target="_blank" rel="noopener" class="btn-primary">Comprar agora →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="final-cta">
  <div class="container final-cta-inner">
    <h2 class="final-cta-title">O próximo projeto começa com a proposta certa.</h2>
    <a href={kiwify} target="_blank" rel="noopener" class="btn-primary btn-large">
      Garantir os 3 templates por R$37 →
    </a>
    <p class="final-cta-sub">Acesso imediato · 7 dias de garantia · Pague uma vez</p>
  </div>
</section>

<footer class="footer">
  <p><a href="/links" target="_blank" rel="noopener" class="footer-link">Miguel Moraes</a> © 2026 Todos os direitos reservados.</p>
</footer>

<div class="sticky-cta" id="sticky-cta">
  <span class="sticky-cta-text">PackPro — 3 templates por R$37</span>
  <a href={kiwify} target="_blank" rel="noopener" class="btn-primary" style="padding: 10px 20px; font-size: 13px;">
    Garantir agora →
  </a>
</div>

</body>
</html>

<script>
  const stickyCta = document.getElementById('sticky-cta')!;
  const hero = document.querySelector('.hero')!;
  const observer = new IntersectionObserver(([e]) => stickyCta.classList.toggle('visible', !e.isIntersecting), { threshold: 0 });
  observer.observe(hero);
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #050505;
    --bg-alt: #0a0a0a;
    --surface: #0d0d0d;
    --border: rgba(255,255,255,0.07);
    --border-strong: rgba(255,255,255,0.13);
    --text: #FFFFFF;
    --muted: #777777;
    --accent: #E84820;
    --accent-hover: #cc3d18;
    --bg-light: #F3F2F0;
    --border-light: rgba(0,0,0,0.08);
    --text-light: #111111;
    --muted-light: #666666;
    --font: var(--font-inter-tight);
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .container { max-width: 960px; margin: 0 auto; padding: 0 24px; }

  /* TICKER */
  .ticker { background: #000; border-bottom: 1px solid var(--border); padding: 10px 0; overflow: hidden; }
  .ticker-track { display: flex; gap: 24px; width: max-content; animation: ticker 90s linear infinite; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }
  @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .dot { color: var(--accent); }

  /* HERO */
  .hero {
    padding: 100px 0 80px;
    border-bottom: 1px solid var(--border);
    overflow: visible;
    background:
      radial-gradient(ellipse at 78% 50%, rgba(232,72,32,0.22) 0%, transparent 48%),
      radial-gradient(ellipse at 60% 80%, rgba(232,72,32,0.07) 0%, transparent 40%),
      #0d0d0d;
  }
  .hero-grid { display: grid; grid-template-columns: 1fr 420px; gap: 48px; align-items: center; }
  .hero-content { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); display: flex; align-items: center; gap: 8px; }
  .hero-title { font-size: clamp(30px, 3.8vw, 52px); font-weight: 700; line-height: 1.08; letter-spacing: -0.03em; }
  .hero-title span { display: block; }
  .hero-sub { color: var(--muted); max-width: 440px; font-size: 17px; line-height: 1.65; }
  .btn-hero { font-size: 15px; padding: 14px 28px; font-weight: 600; }
  .trust-line { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--muted); flex-wrap: wrap; }
  .trust-sep { opacity: 0.3; }

  /* DOC CARDS */
  .hero-visual { display: flex; align-items: center; justify-content: flex-end; }
  .doc-stack { position: relative; width: 420px; height: 500px; margin-right: -60px; }
  .doc-card {
    position: absolute;
    width: 270px;
    height: 380px;
    background: #111111;
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .doc-card-header { display: flex; justify-content: space-between; font-size: 9px; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 0.06em; }
  .doc-card-title { font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.3; color: #fff; }
  .doc-card--back-left { transform: rotate(-8deg) translate(-10px, 30px); z-index: 1; opacity: 0.5; }
  .doc-card--front { transform: rotate(-1deg) translate(30px, 6px); z-index: 3; box-shadow: 0 28px 70px rgba(0,0,0,0.75); }
  .doc-card--back-right { transform: rotate(7deg) translate(70px, 36px); z-index: 1; opacity: 0.5; }
  @media (hover: hover) {
    .doc-stack:hover .doc-card--front {
      transform: rotate(-1deg) translate(30px, -8px);
      box-shadow: 0 40px 90px rgba(0,0,0,0.88);
    }
  }
  @media (hover: hover) {
    .doc-stack:hover .doc-card--back-left {
      transform: rotate(-11deg) translate(-24px, 26px);
    }
  }
  @media (hover: hover) {
    .doc-stack:hover .doc-card--back-right {
      transform: rotate(10deg) translate(84px, 32px);
    }
  }

  /* PILLS */
  .pill {
    position: absolute;
    background: rgba(18,18,18,0.94);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 24px;
    padding: 8px 16px;
    font-size: 13px;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(10px);
    z-index: 10;
    color: rgba(255,255,255,0.85);
    letter-spacing: 0.01em;
  }
  .pill i { font-size: 15px; opacity: 0.75; }
  .pill-1 { top: 110px; left: -8px; }
  .pill-2 { top: 152px; right: -44px; }
  .pill-3 { bottom: 152px; left: -12px; }
  .pill-4 { bottom: 110px; right: -40px; }

  /* NUMBERS BAR */
  .numbers-bar { border-bottom: 1px solid var(--border); padding: 48px 0; }
  .numbers-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .number-item { text-align: center; padding: 0 16px; border-right: 1px solid var(--border); }
  .number-item:last-child { border-right: none; }
  .number-val { display: block; font-size: clamp(26px, 3vw, 40px); font-weight: 700; letter-spacing: -0.03em; }
  .number-label { display: block; font-size: 13px; color: var(--muted); margin-top: 6px; }

  /* SECTIONS */
  .section { padding: 120px 0; }
  .section-alt { background: var(--bg-alt); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .section-light { background: var(--bg-light); border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light); }
  .section-eyebrow { font-size: 11px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 16px; display: flex; justify-content: center; align-items: center; gap: 8px; }
  .section-light .section-eyebrow { color: var(--accent); }
  .section-title { font-size: clamp(26px, 4vw, 42px); font-weight: 700; margin-bottom: 48px; text-align: center; line-height: 1.1; letter-spacing: -0.02em; }
  .section-light .section-title { color: var(--text-light); }

  /* HOW IT WORKS */
