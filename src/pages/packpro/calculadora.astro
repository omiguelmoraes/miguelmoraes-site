---
import { Font } from 'astro:assets';
import '@phosphor-icons/web/regular';
import '@phosphor-icons/web/bold';
import Calculadora from '../../components/Calculadora.astro';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>Calculadora de Precificação Freelancer — Bônus PackPro</title>
  <meta name="description" content="Descubra o valor real da sua hora a partir dos seus custos, da sua meta mensal e das horas que você realmente fatura." />
  <!-- página de bônus: entregue por link após a compra, fora do índice e do sitemap -->
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <Font cssVariable="--font-inter-tight" preload />
  <Font cssVariable="--font-geist-mono" />
</head>
<body>
  <Calculadora variante="bonus" />
</body>
</html>
