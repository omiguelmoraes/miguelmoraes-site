---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  {
    label: 'WhatsApp',
    sub: 'Vamos conversar',
    href: 'https://api.whatsapp.com/send?phone=5551998734305',
    icon: 'ph-whatsapp-logo',
  },
  {
    label: 'Website',
    sub: 'Projetos e artigos',
    href: 'https://miguelmoraes.pro',
    icon: 'ph-globe',
    sameTab: true,
  },
  {
    label: 'Blog',
    sub: 'Notas e artigos em português',
    href: '/blog',
    icon: 'ph-article',
    sameTab: true,
  },
  {
    label: 'Stack',
    sub: 'As ferramentas que uso no dia a dia',
    href: '/stack',
    icon: 'ph-stack',
    sameTab: true,
  },
  {
    label: 'Korbi Studio',
    sub: 'Estúdio de design estratégico',
    href: 'https://www.korbi.studio',
    icon: 'ph-buildings',
  },
];

const products = [
  {
    label: 'Mentoria',
    sub: 'Individual para designers visuais',
    href: '#',
    icon: 'ph-users',
    status: 'Em breve',
    disabled: true,
  },
  {
    label: 'PackPro',
    sub: 'Templates para freelancers',
    href: '/packpro',
    icon: 'ph-package',
  },
  {
    label: 'Calculadora de preço',
    sub: 'Gratuita — quanto vale a sua hora',
    href: '/calculadora',
    icon: 'ph-calculator',
  },
];

const readingList = [
  { title: "Don't Make Me Think", author: 'Steve Krug', cover: 'https://books.google.com/books/content?vid=ISBN:9780321965516&printsec=frontcover&img=1&zoom=1' },
  { title: 'Rework', author: 'Jason Fried & DHH', cover: 'https://books.google.com/books/content?vid=ISBN:9780307463746&printsec=frontcover&img=1&zoom=1' },
  { title: 'Fall in Love with the Problem', author: 'Uri Levine', cover: 'https://books.google.com/books/content?vid=ISBN:9781637741986&printsec=frontcover&img=1&zoom=1' },
];

const free = [];

const featured = {
  label: 'Web Design',
  title: 'Flouds Performance Digital',
  sub: 'Website para agência de mídia paga',
  image: '/projects/webp/flouds-cover.webp',
  href: '/projects/flouds',
};
---

<BaseLayout title='Miguel Moraes — Links' description='Web Designer na Barca e fundador da Korbi Studio. Baseado em Porto Alegre.'>
  <div class='page'>

    <div class='profile'>
      <div class='avatar'>
        <img src='/webp/avatar.webp' alt='Miguel Moraes' width='72' height='72' />
      </div>
      <h1 class='name'>Miguel Moraes</h1>
      <p class='sub'>Designer · Porto Alegre, Brasil 🇧🇷</p>
      <div class='socials'>
        <a href='https://instagram.com/omiguelmoraes' target='_blank' rel='noopener' aria-label='Instagram'><i class='ph ph-instagram-logo'></i></a>
        <a href='https://linkedin.com/in/omiguelmoraes' target='_blank' rel='noopener' aria-label='LinkedIn'><i class='ph ph-linkedin-logo'></i></a>
        <a href='https://www.youtube.com/@omiguelmoraesx' target='_blank' rel='noopener' aria-label='YouTube'><i class='ph ph-youtube-logo'></i></a>
        <a href='https://x.com/omiguelmoraes' target='_blank' rel='noopener' aria-label='X'><i class='ph ph-x-logo'></i></a>
      </div>
      <span class='status'><span class='status-dot'></span>Disponível para projetos</span>
    </div>

    <nav class='list'>
      {links.map(link => (
        <a href={link.href} target={link.sameTab ? '_self' : '_blank'} rel='noopener' class='item'>
          <i class={'ph ' + link.icon + ' item-icon'}></i>
          <div class='item-text'>
            <span class='item-label'>{link.label}</span>
            <span class='item-sub'>{link.sub}</span>
          </div>
          <i class='ph ph-arrow-right item-arrow'></i>
        </a>
      ))}
    </nav>

    <section class='section'>
      <span class='section-label'>Projeto em destaque</span>
      <a href={featured.href} class='featured'>
        <div class='featured-image'>
          <img src={featured.image} alt={featured.title} width='400' height='225' loading='lazy' />
        </div>
        <div class='featured-content'>
          <span class='featured-title'>{featured.title}</span>
          <span class='featured-sub'>{featured.sub}</span>
        </div>
      </a>
    </section>

    {products.length > 0 && (
      <section class='section'>
        <span class='section-label'>Produtos</span>
        <div class='list'>
          {products.map(link => (
            <a
              href={link.disabled ? undefined : link.href}
              rel='noopener'
              class:list={['item', { 'item--disabled': link.disabled }]}
              target={link.disabled ? undefined : (link.sameTab ? '_self' : '_blank')}
              data-tooltip={link.status ?? undefined}
            >
              <i class={'ph ' + link.icon + ' item-icon'}></i>
              <div class='item-text'>
                <div class='item-header'>
                  <span class='item-label'>{link.label}</span>
                  {link.status && <span class='item-status'>{link.status}</span>}
                </div>
                <span class='item-sub'>{link.sub}</span>
              </div>
              {!link.disabled && <i class='ph ph-arrow-right item-arrow'></i>}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class='section'>
      <span class='section-label'>Leituras Recentes</span>
      <div class='reading-grid'>
        {readingList.map(book => (
          <div class='book-card' title={book.title + ' by ' + book.author}>
            <img src={book.cover} alt={book.title} />
          </div>
        ))}
      </div>
    </section>

    {free.length > 0 && (
      <section class='section'>
        <span class='section-label'>Resources</span>
        <div class='list'>
          {free.map(link => (
            <a href={link.href} target='_blank' rel='noopener' class='item'>
              <i class={'ph ' + link.icon + ' item-icon'}></i>
              <div class='item-text'>
                <span class='item-label'>{link.label}</span>
                <span class='item-sub'>{link.sub}</span>
              </div>
              <i class='ph ph-arrow-right item-arrow'></i>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class='links-footer'>
      <div class='location-text'>
        <span id='local-time'>00:00:00 AM</span> · Porto Alegre, Brazil
      </div>
    </footer>

  </div>
</BaseLayout>

<script>
  function updateTime() {
    const timeEl = document.getElementById('local-time');
    if (!timeEl) return;
    
    const now = new Date();
    const options: Intl.DateTimeFormatOptions = { 
      timeZone: 'America/Sao_Paulo', 
      hour: '2-digit', 
      minute: '2-digit',
      second: '2-digit',
      hour12: true 
    };
    timeEl.textContent = new Intl.DateTimeFormat('en-US', options).format(now);
  }

  setInterval(updateTime, 1000);
  updateTime();
  
  document.addEventListener('astro:page-load', updateTime);
</script>

<style>
  .page {
    max-width: 400px;
    margin: 0 auto;
    padding: 64px 24px 80px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 24%;
    corner-shape: squircle;
    overflow: hidden;
    background: var(--color-wash);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    font-size: var(--font-size-title);
    font-weight: 400;
    color: var(--color-title);
    line-height: var(--line-height-title);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--font-size-small);
    color: var(--color-muted);
    background: var(--color-pill-bg);
    border: 1px solid var(--color-border);
    padding: 3px 10px;
    border-radius: 20px;
    line-height: 1.6;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }

  .sub {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    line-height: var(--line-height-body);
  }

  .socials {
    display: flex;
    gap: 16px;
    margin-top: 4px;
  }

  .socials a {
    color: var(--color-muted);
    font-size: 22px;
    line-height: 1;
    padding: 6px;
    margin: -6px;
    transition: color 0.15s;
  }

  @media (hover: hover) {
    .socials a:hover {
      color: var(--color-title);
    }
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-pill-bg);
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
  }

  @media (hover: hover) {
    .item:hover {
      background: var(--color-wash);
      border-color: #ccc;
      transform: translateY(-1px);
      text-decoration: none;
    }
  }

  @media (prefers-color-scheme: dark) {
    @media (hover: hover) {
      .item:hover {
        border-color: #444;
      }
    }
  }

  .item--disabled {
    opacity: 0.4;
    cursor: default;
    position: relative;
  }

  @media (hover: hover) {
    .item--disabled:hover {
      background: var(--color-pill-bg);
      border-color: var(--color-border);
      transform: none;
    }
  }

  @media (hover: hover) {
    .item-status {
      display: none;
    }

    .item--disabled[data-tooltip]:hover::after {
      content: attr(data-tooltip);
      position: absolute;
      top: 50%;
      right: 14px;
      transform: translateY(-50%);
      background: var(--color-title);
      color: var(--color-bg);
      font-size: var(--font-size-xs);
      font-weight: 500;
      padding: 4px 9px;
      border-radius: 4px;
      white-space: nowrap;
      pointer-events: none;
    }
  }

  .item-icon {
    font-size: 18px;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .item-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .item-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .item-label {
    font-size: var(--font-size-body);
    color: var(--color-title);
    line-height: 1.4;
  }

  .item-status {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-wash);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-muted);
  }

  /* Uma linha sempre: texto longo corta com reticências em vez de esticar o
     botão e desalinhar a lista */
  .item-sub {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: 1.4;
  }

  .item-arrow {
    font-size: 14px;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Alinhado ao resto do site, que abandonou o mono caixa-alta como rótulo */
  .section-label {
    font-size: var(--font-size-small);
    font-weight: 500;
    color: var(--color-title);
  }

  .reading-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .book-card {
    aspect-ratio: 2/3;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: linear-gradient(135deg, var(--color-wash) 0%, var(--color-border) 100%);
    transition: transform 0.2s;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px;
  }
  
  .book-card::before {
    content: attr(title);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    font-weight: 500;
    line-height: 1.2;
    z-index: 0;
  }

  @media (hover: hover) {
    .book-card:hover {
      transform: translateY(-4px) rotate(2deg);
    }
  }

  .book-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--color-wash);
  }

  .links-footer {
    margin-top: 16px;
    display: flex;
    justify-content: center;
    padding-bottom: 40px;
  }

  .location-text {
    font-size: var(--font-size-xs);
    font-weight: 400;
    color: var(--color-muted);
    opacity: 0.6;
    letter-spacing: 0.02em;
  }

  /* Featured project card */
  .featured {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  @media (hover: hover) {
    .featured:hover {
      border-color: #ccc;
      transform: translateY(-1px);
      text-decoration: none;
    }
  }

  @media (prefers-color-scheme: dark) {
    @media (hover: hover) {
      .featured:hover {
        border-color: #444;
      }
    }
  }

  .featured-image {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-wash);
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  @media (hover: hover) {
    .featured:hover .featured-image img {
      transform: scale(1.02);
    }
  }

  .featured-content {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--color-pill-bg);
  }


  .featured-title {
    font-size: var(--font-size-body);
    color: var(--color-title);
    line-height: 1.4;
  }

  .featured-sub {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: 1.4;
  }
</style>
