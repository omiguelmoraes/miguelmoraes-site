---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { allProjects } from '../data/projects';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Miguel Moraes",
  "url": "https://miguelmoraes.pro",
  "jobTitle": "Designer",
  "description": "Designer focused on creating things that look good and mean something. Currently Web Designer at Barca, and running Korbi Studio on the side. Based in Brazil, open to remote projects.",
  "image": "https://miguelmoraes.pro/webp/avatar.webp",
  "sameAs": [
    "https://www.linkedin.com/in/omiguelmoraes",
    "https://www.instagram.com/omiguelmoraes",
    "https://www.behance.net/omiguelmoraes",
    "https://www.youtube.com/@omiguelmoraesx",
    "https://x.com/omiguelmoraes"
  ]
};

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Flouds aparece como branding e como web design, com o mesmo título — sem
// thumbnail pra diferenciar, a home mostrava a mesma linha duas vezes
const featuredProjects = Object.entries(allProjects)
  .filter(([, p], i, arr) => arr.findIndex(([, o]) => o.title === p.title) === i)
  .slice(0, 3);
---

<SiteLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="content">

    <!-- About -->
    <section class="section">
      <h2 class="section-title">About</h2>
      <p class="section-body">
        I like creating things that look good, and actually mean something. Currently at Barca, and I run <a href="https://www.korbi.studio" target="_blank" rel="noopener">Korbi</a> on the side, my own studio for brands that think the same&nbsp;way.
      </p>
      <a href="https://api.whatsapp.com/send?phone=5551998734305" class="pill" target="_blank" rel="noopener">
        <i class="ph ph-whatsapp-logo"></i>
        Let's talk
      </a>
    </section>

    <!-- Projects -->
    <section class="section">
      <h2 class="section-title">Projects</h2>
      <p class="section-body">Selected work in web design, UI/UX and branding.</p>
      <div class="rows rows--tight">
        {featuredProjects.map(([slug, project]) => (
          <div class="row">
            <div class="row-head">
              <a href={`/projects/${slug}`} class="row-link">{project.title}</a>
              <span class="date">{project.year}</span>
            </div>
            <span class="row-sub">{project.description}</span>
          </div>
        ))}
        <a href="/projects" class="see-all">See all projects →</a>
      </div>
    </section>

    <!-- Writing -->
    {posts.length > 0 && (
      <section class="section">
        <h2 class="section-title">Writing</h2>
        <p class="section-body">Notes and essays on design, code and building things.</p>
        <div class="rows rows--tight">
          {posts.map(post => (
            <div class="row">
              <div class="row-head">
                <a href={`/blog/${post.id}`} class="row-link">{post.data.title}</a>
                <span class="date">{post.data.date.getFullYear()}</span>
              </div>
              <span class="row-sub">{post.data.description}</span>
            </div>
          ))}
          <a href="/blog" class="see-all">See all writing →</a>
        </div>
      </section>
    )}

    <!-- Connect -->
    <section class="section">
      <h2 class="section-title">Connect</h2>
      <p class="section-body">WhatsApp is the fastest way to reach me. Email works too.</p>
      <div class="contact-actions">
        <a href="https://api.whatsapp.com/send?phone=5551998734305" target="_blank" rel="noopener" class="contact-primary">
          <i class="ph ph-whatsapp-logo"></i>
          WhatsApp
        </a>
        <a href="mailto:omiguelmoraes@outlook.com" class="contact-primary contact-primary--ghost">
          <i class="ph ph-envelope-simple"></i>
          omiguelmoraes@outlook.com
        </a>
      </div>
      <div class="socials">
        <a href="https://linkedin.com/in/omiguelmoraes" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="ph ph-linkedin-logo"></i></a>
        <a href="https://instagram.com/omiguelmoraes" target="_blank" rel="noopener" aria-label="Instagram"><i class="ph ph-instagram-logo"></i></a>
        <a href="https://www.behance.net/omiguelmoraes" target="_blank" rel="noopener" aria-label="Behance"><i class="ph ph-behance-logo"></i></a>
        <a href="https://www.youtube.com/@omiguelmoraesx" target="_blank" rel="noopener" aria-label="YouTube"><i class="ph ph-youtube-logo"></i></a>
        <a href="https://x.com/omiguelmoraes" target="_blank" rel="noopener" aria-label="X"><i class="ph ph-x-logo"></i></a>
      </div>
    </section>

  </div>
</SiteLayout>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--color-pill-bg);
    color: var(--color-body);
    font-size: var(--font-size-small);
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.6;
    width: fit-content;
    text-decoration: none;
    margin-top: 4px;
  }

  .pill:hover {
    background: var(--color-wash);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .contact-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--font-size-body);
    color: var(--color-bg);
    background: var(--color-title);
    padding: 8px 16px;
    border-radius: 10px;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .contact-primary:hover {
    opacity: 0.85;
  }

  .contact-primary--ghost {
    color: var(--color-title);
    background: var(--color-pill-bg);
  }

  .contact-primary--ghost:hover {
    background: var(--color-wash);
    opacity: 1;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-left: -8px;
  }

  .socials a {
    display: inline-flex;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 18px;
    padding: 8px;
    border-radius: 8px;
    transition: color 0.15s, background 0.15s;
  }

  .socials a:hover {
    color: var(--color-title);
    background: var(--color-wash);
  }

</style>
