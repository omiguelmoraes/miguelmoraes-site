---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { allProjects } from '../data/projects';
import ContactLinks from '../components/ContactLinks.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Miguel Moraes",
  "url": "https://miguelmoraes.pro",
  "jobTitle": "Designer",
  "description": "Designer de interfaces e web designer. Atualmente Web Designer na Barca e designer independente em projetos de produtos digitais e branding, baseado em Porto Alegre.",
  "image": "https://miguelmoraes.pro/webp/avatar.webp",
  "sameAs": [
    "https://www.linkedin.com/in/miguelmoraes",
    "https://www.instagram.com/omiguelmoraes",
    "https://www.behance.net/omiguelmoraes",
    "https://www.youtube.com/@omiguelmoraesx",
    "https://x.com/omiguelmoraes"
  ]
};

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Flouds aparece como branding e como web design, com o mesmo título — sem
// thumbnail pra diferenciar, a home mostrava a mesma linha duas vezes
const featuredProjects = Object.entries(allProjects)
  .filter(([, p], i, arr) => arr.findIndex(([, o]) => o.title === p.title) === i)
  .slice(0, 4);
---

<SiteLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="content">

    <!-- About -->
    <section class="section">
      <h2 class="section-title">Sobre</h2>
      <p class="section-body">
        Construo coisas que chamam atenção e funcionam na prática. Atualmente trabalho como Web Designer na <a href="https://barca.cc/" target="_blank" rel="noopener">Barca</a> e atuo em projetos de desenvolvimento de produtos digitais e construção de branding como profissional independente.
      </p>
      <a href="https://api.whatsapp.com/send?phone=5551998734305" class="pill" target="_blank" rel="noopener">
        <i class="ph ph-whatsapp-logo"></i>
        Vamos conversar
      </a>
    </section>

    <!-- Projects -->
    <section class="section">
      <h2 class="section-title">Projetos</h2>
      <p class="section-body">Seleção de trabalhos em web design, UI/UX e branding.</p>
      <div class="project-preview-grid">
        {featuredProjects.map(([slug, project]) => (
          <a href={`/projects/${slug}`} class="project-preview">
            <div class="project-preview-image">
              <img src={project.thumbnail} alt={project.title} width="480" height="360" loading="lazy" style={project.coverPosition ? `object-position: ${project.coverPosition}` : undefined} />
            </div>
            <span class="project-preview-title">{project.title}</span>
            <span class="project-preview-year">{project.year}</span>
          </a>
        ))}
      </div>
      <a href="/projects" class="see-all">Ver todos os projetos →</a>
    </section>

    <!-- Writing -->
    {posts.length > 0 && (
      <section class="section">
        <h2 class="section-title">Blog</h2>
        <p class="section-body">Notas e artigos sobre design, código e construção de coisas.</p>
        <div class="rows rows--tight">
          {posts.map(post => (
            <div class="row row--link">
              <div class="row-head">
                <a href={`/blog/${post.id}`} class="row-link">{post.data.title}</a>
                <span class="date">{post.data.date.getFullYear()}</span>
              </div>
            </div>
          ))}
          <a href="/blog" class="see-all">Ver todas as postagens →</a>
        </div>
      </section>
    )}

    <!-- Connect -->
    <section class="section">
      <h2 class="section-title">Contato</h2>
      <p class="section-body">O WhatsApp é o caminho mais rápido para falar comigo.</p>
      <ContactLinks />
    </section>

  </div>
</SiteLayout>

<style>

  .project-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 4px;
  }

  .project-preview {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    text-decoration: none;
  }

  .project-preview-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-wash);
  }

  .project-preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  @media (hover: hover) {
    .project-preview:hover {
      text-decoration: none;
    }
  }

  @media (hover: hover) {
    .project-preview:hover .project-preview-image img {
      transform: scale(1.03);
    }
  }

  .project-preview:nth-child(4) {
    display: none;
  }

  .project-preview-title {
    color: var(--color-title);
    font-size: var(--font-size-small);
    font-weight: 500;
    line-height: var(--line-height-section);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .project-preview-year {
    color: var(--color-muted);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-section);
  }

  .see-all {
    display: inline-block;
    margin-top: 20px;
  }

  @media (max-width: 480px) {
    .project-preview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-preview:nth-child(4) {
      display: flex;
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--color-pill-bg);
    color: var(--color-body);
    font-size: var(--font-size-small);
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.6;
    width: fit-content;
    text-decoration: none;
    margin-top: 4px;
  }

  @media (hover: hover) {
    .pill:hover {
      background: var(--color-wash);
    }
  }


</style>
