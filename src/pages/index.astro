---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { allProjects } from '../data/projects';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Miguel Moraes",
  "url": "https://miguelmoraes.pro",
  "jobTitle": "Designer",
  "description": "Designer focused on creating things that look good and mean something. Currently Web Designer at Barca, and running Korbi Studio on the side. Based in Brazil, open to remote projects.",
  "image": "https://miguelmoraes.pro/webp/avatar.webp",
  "sameAs": [
    "https://www.linkedin.com/in/omiguelmoraes",
    "https://www.instagram.com/omiguelmoraes",
    "https://www.behance.net/omiguelmoraes",
    "https://www.youtube.com/@omiguelmoraesx",
    "https://x.com/omiguelmoraes"
  ]
};

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredProjects = Object.entries(allProjects).slice(0, 3);
---

<SiteLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="content">

    <!-- About -->
    <section class="section">
      <h2 class="section-title">About</h2>
      <p class="section-body">
        I like creating things that look good, and actually mean something. Currently at Barca, and I run <a href="https://www.korbi.studio" target="_blank" rel="noopener">Korbi</a> on the side, my own studio for brands that think the same&nbsp;way.
      </p>
      <a href="https://api.whatsapp.com/send?phone=5551998734305" class="pill" target="_blank" rel="noopener">
        <i class="ph ph-whatsapp-logo"></i>
        Let's talk
      </a>
    </section>

    <!-- Projects -->
    <section class="section">
      <h2 class="section-title">Projects</h2>
      <p class="section-body">Selected work in web design, UI/UX and branding.</p>
      <div class="rows">
        {featuredProjects.map(([slug, project]) => (
          <div class="row">
            <span class="date">{project.year}</span>
            <div class="row-content">
              <a href={`/projects/${slug}`} class="link-block">
                <div class="link-block-image">
                  <img src={project.cover} alt={project.title} width="150" height="90" loading="lazy" />
                </div>
                <div class="link-block-content">
                  <span class="link-block-title">{project.title}</span>
                  <span class="link-block-sub">{project.tags[0]}</span>
                </div>
              </a>
            </div>
          </div>
        ))}
        <div class="row">
          <span class="date"></span>
          <a href="/projects" class="see-all">See all projects →</a>
        </div>
      </div>
    </section>

    <!-- Writing -->
    {posts.length > 0 && (
      <section class="section">
        <h2 class="section-title">Writing</h2>
        <p class="section-body">Notes and essays on design, code and building things.</p>
        <div class="rows">
          {posts.map(post => (
            <div class="row">
              <span class="date">{post.data.date.getFullYear()}</span>
              <div class="row-content">
                <a href={`/blog/${post.id}`} class="row-link">{post.data.title}</a>
                <span class="row-sub">{post.data.description}</span>
              </div>
            </div>
          ))}
          <div class="row">
            <span class="date"></span>
            <a href="/blog" class="see-all">See all writing →</a>
          </div>
        </div>
      </section>
    )}

    <!-- Connect -->
    <section class="section">
      <h2 class="section-title">Connect</h2>
      <p class="section-body">
        Reach me at <a href="mailto:omiguelmoraes@outlook.com">omiguelmoraes@outlook.com</a>, or find me below.
      </p>
      <div class="socials">
        <a href="https://linkedin.com/in/omiguelmoraes" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="https://instagram.com/omiguelmoraes" target="_blank" rel="noopener">Instagram ↗</a>
        <a href="https://www.behance.net/omiguelmoraes" target="_blank" rel="noopener">Behance ↗</a>
        <a href="https://www.youtube.com/@omiguelmoraesx" target="_blank" rel="noopener">YouTube ↗</a>
        <a href="https://x.com/omiguelmoraes" target="_blank" rel="noopener">X ↗</a>
      </div>
    </section>

  </div>
</SiteLayout>

<style>
  .content :global(.section-body) {
    max-width: var(--prose-max-width);
  }

  .content :global(.section-body a) {
    color: var(--color-title);
    text-decoration: underline;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--color-pill-bg);
    color: var(--color-body);
    font-size: var(--font-size-small);
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.6;
    width: fit-content;
    text-decoration: none;
    margin-top: 4px;
  }

  .pill:hover {
    background: var(--color-wash);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .socials a {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-decoration: none;
  }

  .socials a:hover {
    color: var(--color-title);
  }

  /* Link Block — project card */
  .link-block {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s;
    width: 100%;
  }

  .link-block:hover {
    border-color: var(--color-muted);
  }

  .link-block-image {
    width: 150px;
    height: 90px;
    flex-shrink: 0;
    overflow: hidden;
    border-right: 1px solid var(--color-border);
  }

  .link-block-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .link-block-content {
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .link-block-title {
    font-size: var(--font-size-body);
    color: var(--color-title);
    line-height: var(--line-height-body);
  }

  .link-block-sub {
    font-size: var(--font-size-small);
    color: var(--color-muted);
    line-height: var(--line-height-body);
  }
</style>
