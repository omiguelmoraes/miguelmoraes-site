---
// Página temporária pra escolher tipografia. Deletar depois da decisão.
const options = [
  {
    id: 'atual',
    name: 'Atual — Geist',
    note: 'O que está no ar hoje. Neutra e bem desenhada, mas virou o default de todo site feito com IA.',
    heading: "'Geist', sans-serif",
    body: "'Geist', sans-serif",
  },
  {
    id: 'intertight',
    name: 'Inter Tight (tudo)',
    note: 'Inter com espacejamento mais fechado. Mais densa e compacta que a Geist, sem trocar de categoria — o site continua neutro, só com outra voz.',
    heading: "'Inter Tight', sans-serif",
    body: "'Inter Tight', sans-serif",
  },
  {
    id: 'intertight-serif',
    name: 'Instrument Serif + Inter Tight',
    note: 'Serifa no título com a Inter Tight no corpo. Junta o contraste editorial com a densidade que ela dá no texto corrido.',
    heading: "'Instrument Serif', serif",
    body: "'Inter Tight', sans-serif",
  },
  {
    id: 'instrument',
    name: 'Instrument Serif + Inter',
    note: 'Serifa só nos títulos. Move mais a percepção com menos risco, e combina com um site que agora tem blog.',
    heading: "'Instrument Serif', serif",
    body: "'Inter', sans-serif",
  },
  {
    id: 'fraunces',
    name: 'Fraunces + Schibsted Grotesk',
    note: 'Editorial e com mais personalidade. Fraunces tem eixo variável, então dá pra ajustar o quanto ela é expressiva.',
    heading: "'Fraunces', serif",
    body: "'Schibsted Grotesk', sans-serif",
  },
  {
    id: 'bricolage',
    name: 'Bricolage Grotesque + Inter',
    note: 'Sem serifa, mas com desenho irregular de propósito. Fica contemporâneo sem parecer template.',
    heading: "'Bricolage Grotesque', sans-serif",
    body: "'Inter', sans-serif",
  },
  {
    id: 'newsreader',
    name: 'Newsreader (tudo)',
    note: 'Serifa no site inteiro. A mais arriscada e a mais autoral. Puxa pro lado de publicação, não de portfólio.',
    heading: "'Newsreader', serif",
    body: "'Newsreader', serif",
  },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teste de tipografia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Inter:wght@400;500&family=Inter+Tight:wght@400;500;600&family=Instrument+Serif&family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Schibsted+Grotesk:wght@400;500&family=Bricolage+Grotesque:wght@400;500&family=Newsreader:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: #fff;
        color: #111;
        padding: 60px 24px 120px;
      }
      .wrap { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 72px; }
      .intro { font-family: 'Geist', sans-serif; font-size: 15px; line-height: 1.7; color: #555; }
      .intro strong { color: #111; }
      .card { border-top: 1px solid #e5e5e5; padding-top: 28px; }
      .label {
        font-family: 'Geist Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #999;
        margin-bottom: 6px;
      }
      .note { font-family: 'Geist', sans-serif; font-size: 14px; line-height: 1.7; color: #666; margin-bottom: 28px; max-width: 60ch; }
      .demo { display: flex; flex-direction: column; gap: 18px; }
      .page-title { font-size: 26px; font-weight: 500; line-height: 1.25; }
      .lead { font-size: 15px; line-height: 1.8; color: #555; max-width: 62ch; }
      .row { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-top: 8px; }
      .row-title { font-size: 15px; font-weight: 500; }
      .date { font-family: 'Geist Mono', monospace; font-size: 12px; color: #777; background: #f6f6f6; padding: 2px 8px; border-radius: 10px; }
      .row-sub { font-size: 14px; color: #777; line-height: 1.8; max-width: 60ch; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p class="intro">
        Mesmo conteúdo do site em cada combinação. Olha o <strong>título</strong>, o
        <strong>texto corrido</strong> e o <strong>par título + descrição</strong> das listas.
        O badge de data segue em mono nos cinco, pra isolar a variável.
      </p>

      {options.map(opt => (
        <section class="card">
          <div class="label">{opt.name}</div>
          <p class="note">{opt.note}</p>
          <div class="demo" style={`font-family: ${opt.body}`}>
            <h2 class="page-title" style={`font-family: ${opt.heading}`}>Hi, I'm Miguel</h2>
            <p class="lead">
              I'm 22, from Porto Alegre, and I've been designing since before I knew it was a job.
              I'm the kind of designer who opens the inspector.
            </p>
            <h3 class="page-title" style={`font-family: ${opt.heading}`}>Writing</h3>
            <div class="row">
              <span class="row-title">Meu Obsidian não é um app de notas, é o contexto da minha IA</span>
              <span class="date">2026</span>
            </div>
            <span class="row-sub">
              Como eu organizo o vault pra IA chegar sabendo quem eu sou, no que trabalho e como decido.
            </span>
          </div>
        </section>
      ))}
    </div>
  </body>
</html>
