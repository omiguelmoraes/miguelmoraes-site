function normalize(str: string) {
  return str.toLowerCase().replace(/[^a-z0-9]/g, '');
}
---

<div class="tech-stack">
  {stack.map((item) => {
    const key = normalize(item);
    const icon = icons[key];
    return (
      <span class="tech-pill" title={item}>
        {icon ? <Fragment set:html={icon.svg} /> : <i class="ph ph-cube"></i>}
        <span class="tech-name">{item}</span>
      </span>
    );
  })}
</div>

<style>
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .tech-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--color-title);
    background: var(--color-wash);
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    border-radius: 6px;
    line-height: 1.4;
  }

  .tech-pill svg {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .tech-name {
    font-size: 12px;
    font-weight: 400;
  }
</style>
