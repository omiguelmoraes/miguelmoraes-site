---
const year = new Date().getFullYear();
---

<footer class="footer">
  <span class="footer-meta">Miguel Moraes © {year}</span>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: center;
    margin-top: 80px;
    padding: 24px 0 8px;
    border-top: 1px solid var(--color-border);
  }

  .footer-meta {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    opacity: 0.65;
  }
</style>
