</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 88px 0 8px;
  }

  
  
  
  
  .footer-meta {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    opacity: 0.65;
  }
</style>
