<div id="lightbox" class="lightbox" aria-hidden="true">
  <button class="lightbox-close" aria-label="Close">✕</button>
  <button class="lightbox-prev" aria-label="Previous">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M13 4L7 10L13 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <img id="lightbox-img" src="" alt="" />
  <button class="lightbox-next" aria-label="Next">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<script>
  // Delegação no document: registrado uma vez e imune a quando o script roda em
  // relação ao swap do ClientRouter. Ligar listener por imagem dependia de os
  // elementos já existirem no momento do setup.
  const getEls = () => ({
    lightbox: document.getElementById('lightbox'),
    img: document.getElementById('lightbox-img') as HTMLImageElement | null,
  });

  const triggers = () =>
    Array.from(document.querySelectorAll('.lightbox-trigger')) as HTMLImageElement[];

  function show(trigger: HTMLImageElement) {
    const { lightbox, img } = getEls();
    if (!img) return;
    img.src = trigger.dataset.full || trigger.currentSrc || trigger.src;
    img.alt = trigger.alt ?? '';
    // Guarda a posição em vez de comparar src depois: img.src devolve URL
    // absoluta e data-full guarda caminho relativo, então a busca nunca casava
    if (lightbox) lightbox.dataset.index = String(triggers().indexOf(trigger));
  }

  function open(trigger: HTMLImageElement) {
    const { lightbox } = getEls();
    if (!lightbox) return;
    show(trigger);
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    const { lightbox } = getEls();
    if (!lightbox) return;
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }

  function navigate(dir: 1 | -1) {
    const { img } = getEls();
    const all = triggers();
    if (!img || all.length === 0) return;
    const i = all.findIndex(t => (t.dataset.full || t.currentSrc || t.src) === img.src);
    const next = ((i === -1 ? 0 : i + dir) + all.length) % all.length;
    show(all[next]);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const trigger = target.closest('.lightbox-trigger') as HTMLImageElement | null;
    if (trigger) {
      open(trigger);
      return;
    }

    const { lightbox } = getEls();
    if (!lightbox?.classList.contains('open')) return;

    if (target.closest('.lightbox-prev')) { e.stopPropagation(); navigate(-1); return; }
    if (target.closest('.lightbox-next')) { e.stopPropagation(); navigate(1); return; }
    if (target === lightbox || target.closest('.lightbox-close')) close();
  });

  document.addEventListener('keydown', (e) => {
    const { lightbox } = getEls();
    if (!lightbox?.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') navigate(1);
    if (e.key === 'ArrowLeft') navigate(-1);
  });

  // O overlay não sobrevive à troca de página; garante o estado limpo
  document.addEventListener('astro:before-swap', close);
</script>

<style>
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 24px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  
  .lightbox.open { 
    display: flex;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lightbox img {
    max-width: 90%;
    max-height: 85vh;
    border-radius: 8px;
    object-fit: contain;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1);
  }

  .lightbox img.rotate-90 {
    transform: rotate(90deg);
    max-width: 80vh;
    max-height: 80vw;
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: rgba(255,255,255,0.1);
    border: none;
    color: #fff;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    cursor: pointer;
    transition: background 0.2s;
  }
  
  .lightbox-close:hover { 
    background: rgba(255,255,255,0.2);
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.1);
    border: none;
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 1;
  }

  .lightbox-prev { left: 24px; }
  .lightbox-next { right: 24px; }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255,255,255,0.2);
  }

  @media (max-width: 480px) {
    .lightbox { padding: 12px; }
    .lightbox-close { top: 16px; right: 16px; }
    .lightbox-prev { left: 12px; }
    .lightbox-next { right: 12px; }
  }
</style>
